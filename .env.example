# Copy to .env and fill in. Never commit real values.

# AI page builder (apps/ai_assistant) - OpenRouter, OpenAI-compatible API
OPENROUTER_API_KEY=
# Change only this to switch models, e.g. anthropic/claude-sonnet-4.5 or openai/gpt-4o-mini
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT=60
# AI_ASSISTANT_THROTTLE_RATE=60/hour

# Help assistant (apps/helpdesk): support chat for merchants. Off until the help_assistant feature flag is enabled.
# HELP_ASSISTANT_MODEL=            # empty: OPENROUTER_MODEL
# HELP_ASSISTANT_THROTTLE_RATE=60/hour
# Support staff are emailed here when a ticket is raised (empty: no email, tickets still show in Support Tickets)
SUPPORT_EMAIL=

# Admin AI assistant (read-only, reads store data). Off unless True. Needs OPENROUTER_API_KEY above on a hosted server.
# ASSISTANT_ENABLED=False
# ASSISTANT_OPENROUTER_MODEL=
