{%- comment -%}
  Everything about the wishlist lives here: the heart, the header count, the saved products
  and the small script. Shoppers need no account: the list is kept per store in their session.
  Usage:
    {% render 'wishlist', mode: 'icon', count: wishlist_count %}               header heart with the count
    {% render 'wishlist', mode: 'button', product: product, wishlist_ids: wishlist_ids %}   heart on a product
    {% render 'wishlist', mode: 'page', items: wishlist_items, wishlist_ids: wishlist_ids %}   the saved products
  Options: icon: label, show_count, attrs. button: placement ("card" or "product"), size (px),
  label_text ("product" only), align ("product" only), return_url, with_script.
  The script is added by the icon, the page and any button with with_script: true.
{%- endcomment -%}
{%- assign heart = 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z' -%}
{%- if mode == 'icon' -%}
  <a class="site-header__wishlist" href="{{ shop.url }}/wishlist/" aria-label="{{ label | default: 'Wishlist' }}" title="{{ label | default: 'Wishlist' }}"{{ attrs }}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="{{ heart }}" />
    </svg>
    {%- if show_count != false -%}
      <span class="site-header__wishlist-count" data-wishlist-count aria-live="polite">{{ count | default: 0 }}</span>
    {%- endif -%}
  </a>
{%- elsif mode == 'button' and product -%}
  {%- assign is_wishlisted = false -%}
  {%- if wishlist_ids contains product.id -%}{%- assign is_wishlisted = true -%}{%- endif -%}
  {%- assign kind = 'product-card' -%}
  {%- if placement == 'product' -%}{%- assign kind = 'product' -%}{%- endif -%}
  {%- assign add_text = label_text | default: 'Add to wishlist' -%}
  <form class="{{ kind }}__wishlist-form" method="post" action="{{ shop.url }}/wishlist/items/" data-wishlist-form{% if placement == 'product' and align != blank %} style="text-align:{{ align }}"{% endif %}>
    <input type="hidden" name="product_id" value="{{ product.id }}">
    <input type="hidden" name="action" value="{% if is_wishlisted %}remove{% else %}add{% endif %}" data-wishlist-action>
    <input type="hidden" name="return_to" value="{{ return_url | default: product.url }}">
    <button class="{{ kind }}__wishlist-add{% if is_wishlisted %} is-wishlisted{% endif %}" type="submit"
      data-wishlist-toggle data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" aria-pressed="{% if is_wishlisted %}true{% else %}false{% endif %}"
      data-label-add="{{ add_text | escape }}" data-label-remove="Remove from wishlist"
      aria-label="{% if is_wishlisted %}Remove {{ product.title }} from{% else %}Add {{ product.title }} to{% endif %} wishlist"
      title="{% if is_wishlisted %}Remove from wishlist{% else %}Add to wishlist{% endif %}">
      <svg viewBox="0 0 24 24" aria-hidden="true"{% if size != blank %} style="width:{{ size }}px;height:{{ size }}px"{% endif %}>
        <path d="{{ heart }}" />
      </svg>
      {%- if placement == 'product' and label_text != blank -%}
        <span data-wishlist-label>{% if is_wishlisted %}Remove from wishlist{% else %}{{ add_text }}{% endif %}</span>
      {%- endif -%}
    </button>
    {%- if wishlist_action == 'remove' -%}
      <button class="product-card__wishlist-remove" type="submit" data-wishlist-remove>Remove</button>
    {%- endif -%}
  </form>
{%- elsif mode == 'page' -%}
  <section class="wishlist-page"><div class="page-width">
    <h1>Wishlist</h1>
    {%- if items.size > 0 -%}
      <div class="wishlist-page__grid">
        {%- for item in items -%}
          {% render 'product-card', product: item, show_vendor: false, show_add_to_cart: true, wishlist_action: 'remove', wishlist_ids: wishlist_ids, return_url: return_url, ratio: 'portrait' %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="wishlist-page__empty">
        <p>Your wishlist is empty.</p>
        <a class="button" href="{{ shop.url }}/collections/all">Continue shopping</a>
      </div>
    {%- endif -%}
  </div></div></section>
{%- endif -%}
{%- if mode == 'icon' or mode == 'page' or with_script -%}
<script>
(function () {
  if (window.tssWishlist) return;
  window.tssWishlist = true;
  function paint(toggles, saved) {
    toggles.forEach(function (toggle) {
      toggle.classList.toggle("is-wishlisted", saved);
      toggle.setAttribute("aria-pressed", saved ? "true" : "false");
      var title = toggle.getAttribute("data-product-title") || "product";
      toggle.setAttribute("aria-label", (saved ? "Remove " + title + " from" : "Add " + title + " to") + " wishlist");
      toggle.title = saved ? "Remove from wishlist" : "Add to wishlist";
      var label = toggle.querySelector("[data-wishlist-label]");
      if (label) label.textContent = saved ? toggle.getAttribute("data-label-remove") : toggle.getAttribute("data-label-add");
    });
  }
  function setCount(value) {
    document.querySelectorAll("[data-wishlist-count]").forEach(function (count) {
      count.textContent = String(Math.max(0, value));
    });
  }
  document.addEventListener("click", function (event) {
    var button = event.target.closest && event.target.closest("[data-wishlist-toggle], [data-wishlist-remove]");
    if (!button) return;
    var form = button.closest("form[data-wishlist-form]");
    if (!form) return;
    var productId = form.querySelector('[name="product_id"]').value;
    var action = form.querySelector("[data-wishlist-action]");
    var toggles = document.querySelectorAll('[data-wishlist-toggle][data-product-id="' + productId + '"]');
    var wasSaved = toggles.length > 0 && toggles[0].getAttribute("aria-pressed") === "true";
    var removing = button.hasAttribute("data-wishlist-remove");
    var saved = removing ? false : !wasSaved;
    action.value = saved ? "add" : "remove";
    if (!window.fetch || !window.FormData || !window.URLSearchParams) return; // plain form post
    event.preventDefault();
    paint(toggles, saved);
    var current = document.querySelector("[data-wishlist-count]");
    if (current && saved !== wasSaved) setCount(Number(current.textContent || 0) + (saved ? 1 : -1));
    fetch(form.action, {
      method: "POST",
      body: new URLSearchParams(new FormData(form)),
      headers: { Accept: "application/json" },
      credentials: "same-origin"
    }).then(function (response) {
      if (!response.ok) throw new Error("wishlist");
      return response.json();
    }).then(function (data) {
      setCount(Number(data.count) || 0);
      if (removing && form.closest(".wishlist-page__grid")) {
        var card = form.closest(".product-card-shell");
        if (card) card.remove();
        if (!document.querySelector(".wishlist-page__grid .product-card-shell")) window.location.reload();
      }
    }).catch(function () {
      paint(toggles, wasSaved);
      action.value = wasSaved ? "remove" : "add";
      form.submit();
    });
  });
})();
</script>
{%- endif -%}
