{%- comment -%}
  Customer Authentication (Sign in or create account).
  Usage:
    {% render 'customer-auth', mode: 'login', return_url: return_url, error: error, success: success %}
    {% render 'customer-auth', mode: 'register', return_url: return_url, error: error, success: success %}
{%- endcomment -%}
<div class="customer-auth customer-auth--{{ mode }}">
  <div class="customer-card">
    {%- if error != blank -%}
      <div class="alert alert--error" role="alert">
        <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <span>{{ error }}</span>
      </div>
    {%- endif -%}

    {%- if success != blank -%}
      <div class="alert alert--success" role="alert">
        <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>{{ success }}</span>
      </div>
    {%- endif -%}

    <div class="customer-card__header">
      <h1 class="customer-card__title">Sign in or create account</h1>
      <p class="customer-card__subtitle">Sign in to your account or create a new one to view orders and manage your profile.</p>
    </div>

    <div class="customer-auth-tabs" role="tablist" aria-label="Customer authentication options">
      <a href="{{ shop.url }}/account/login{% if return_url != blank %}?return_to={{ return_url | url_encode }}{% endif %}" class="customer-auth-tab {% if mode != 'register' %}is-active{% endif %}" data-auth-tab="login" role="tab" aria-selected="{% if mode != 'register' %}true{% else %}false{% endif %}">
        Sign In
      </a>
      <a href="{{ shop.url }}/account/register{% if return_url != blank %}?return_to={{ return_url | url_encode }}{% endif %}" class="customer-auth-tab {% if mode == 'register' %}is-active{% endif %}" data-auth-tab="register" role="tab" aria-selected="{% if mode == 'register' %}true{% else %}false{% endif %}">
        Create Account
      </a>
    </div>

    <!-- Login Panel -->
    <div class="customer-auth-panel" data-auth-panel="login" style="{% if mode == 'register' %}display: none;{% endif %}">
      <form class="customer-form" method="post" action="{{ shop.url }}/account/login" data-customer-auth-form>
        <input type="hidden" name="return_to" value="{{ return_url | default: '' }}">

        <div class="form-group">
          <label class="form-label" for="login-email">Email</label>
          <input
            id="login-email"
            class="form-input"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="name@example.com"
            value="{{ customer.email | default: '' }}"
          >
        </div>

        <div class="form-group">
          <div class="form-label-row">
            <label class="form-label" for="login-password">Password</label>
          </div>
          <div class="password-wrapper">
            <input
              id="login-password"
              class="form-input"
              type="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="Enter your password"
            >
            <button type="button" class="password-toggle" data-password-toggle aria-label="Toggle password visibility">
              <svg class="eye-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-closed" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-group form-group--checkbox">
          <label class="checkbox-label" for="login-remember">
            <input id="login-remember" type="checkbox" name="remember_me" value="true">
            <span>Remember me</span>
          </label>
        </div>

        <button type="submit" class="button button--full customer-card__submit" data-auth-submit>
          Sign In
        </button>
      </form>

      <div class="customer-card__footer">
        <p>Don't have an account? <a href="{{ shop.url }}/account/register{% if return_url != blank %}?return_to={{ return_url | url_encode }}{% endif %}" class="auth-link" data-switch-auth="register">Create one</a></p>
        <p><a href="{{ shop.url }}/" class="auth-link-subtle">&larr; Return to store</a></p>
      </div>
    </div>

    <!-- Register Panel -->
    <div class="customer-auth-panel" data-auth-panel="register" style="{% if mode != 'register' %}display: none;{% endif %}">
      <form class="customer-form" method="post" action="{{ shop.url }}/account/register" data-customer-auth-form>
        <input type="hidden" name="return_to" value="{{ return_url | default: '' }}">

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="register-first-name">First name</label>
            <input
              id="register-first-name"
              class="form-input"
              type="text"
              name="first_name"
              required
              autocomplete="given-name"
              placeholder="First name"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="register-last-name">Last name</label>
            <input
              id="register-last-name"
              class="form-input"
              type="text"
              name="last_name"
              required
              autocomplete="family-name"
              placeholder="Last name"
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="register-email">Email</label>
          <input
            id="register-email"
            class="form-input"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="name@example.com"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="register-phone">Mobile number <span class="form-label-opt">(optional)</span></label>
          <input
            id="register-phone"
            class="form-input"
            type="tel"
            name="phone"
            autocomplete="tel"
            placeholder="+1 555-0199"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="register-password">Password</label>
          <div class="password-wrapper">
            <input
              id="register-password"
              class="form-input"
              type="password"
              name="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="At least 8 characters"
            >
            <button type="button" class="password-toggle" data-password-toggle aria-label="Toggle password visibility">
              <svg class="eye-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-closed" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="register-confirm-password">Confirm password</label>
          <div class="password-wrapper">
            <input
              id="register-confirm-password"
              class="form-input"
              type="password"
              name="confirm_password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="Re-enter password"
            >
          </div>
        </div>

        <div class="form-group form-group--checkbox">
          <label class="checkbox-label" for="register-terms">
            <input id="register-terms" type="checkbox" name="agree_terms" value="true" required>
            <span>I agree to the <a href="{{ shop.url }}/pages/terms" target="_blank" class="auth-link">Terms & Conditions</a></span>
          </label>
        </div>

        <div class="form-group form-group--checkbox">
          <label class="checkbox-label" for="register-newsletter">
            <input id="register-newsletter" type="checkbox" name="newsletter" value="true">
            <span>Subscribe to updates and promotions</span>
          </label>
        </div>

        <button type="submit" class="button button--full customer-card__submit" data-auth-submit>
          Create Account
        </button>
      </form>

      <div class="customer-card__footer">
        <p>Already have an account? <a href="{{ shop.url }}/account/login{% if return_url != blank %}?return_to={{ return_url | url_encode }}{% endif %}" class="auth-link" data-switch-auth="login">Sign in</a></p>
        <p><a href="{{ shop.url }}/" class="auth-link-subtle">&larr; Return to store</a></p>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var tabs = document.querySelectorAll("[data-auth-tab]");
  var panels = document.querySelectorAll("[data-auth-panel]");
  function switchTab(target) {
    tabs.forEach(function(t) {
      var isTarget = t.getAttribute("data-auth-tab") === target;
      t.classList.toggle("is-active", isTarget);
      t.setAttribute("aria-selected", isTarget ? "true" : "false");
    });
    panels.forEach(function(p) {
      p.style.display = p.getAttribute("data-auth-panel") === target ? "block" : "none";
    });
  }

  tabs.forEach(function(t) {
    t.addEventListener("click", function(e) {
      e.preventDefault();
      switchTab(t.getAttribute("data-auth-tab"));
    });
  });

  document.querySelectorAll("[data-switch-auth]").forEach(function(link) {
    link.addEventListener("click", function(e) {
      e.preventDefault();
      switchTab(link.getAttribute("data-switch-auth"));
    });
  });

  document.querySelectorAll("[data-password-toggle]").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var wrapper = btn.closest(".password-wrapper");
      if (!wrapper) return;
      var input = wrapper.querySelector("input");
      if (!input) return;
      var isPassword = input.type === "password";
      input.type = isPassword ? "text" : "password";
      var openIcon = btn.querySelector(".eye-open");
      var closedIcon = btn.querySelector(".eye-closed");
      if (openIcon && closedIcon) {
        openIcon.style.display = isPassword ? "none" : "block";
        closedIcon.style.display = isPassword ? "block" : "none";
      }
    });
  });

  document.querySelectorAll("[data-customer-auth-form]").forEach(function(form) {
    form.addEventListener("submit", function(e) {
      var pass = form.querySelector("input[name='password']");
      var confirm = form.querySelector("input[name='confirm_password']");
      if (confirm && pass && pass.value !== confirm.value) {
        e.preventDefault();
        alert("Passwords do not match.");
        confirm.focus();
        return;
      }
      var submitBtn = form.querySelector("[data-auth-submit]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset.originalText = submitBtn.textContent;
        submitBtn.textContent = "Please wait...";
      }
    });
  });
})();
</script>
