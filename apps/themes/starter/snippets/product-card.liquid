{%- comment -%}
  Product card used by the grid, carousel and collection page.
  Usage: {% render 'product-card', product: product, show_vendor: true %}
  Optional: show_price (default on), show_rating, show_tags, show_add_to_cart,
  show_wishlist (the section's "Wishlist heart" block settings, nothing when it has none or hides it: the heart,
  always visible on the card, see snippets/wishlist.liquid),
  show_cart_icon (the section's "Cart icon" block settings, nothing when it has none or hides it). Adding the
  block ("Add block") adds the icon's code (the part that starts with the show_cart_icon condition) to this
  file, and the icon's code written here adds the block to the product sections: both stay in step.
  See snippets/cart.liquid.
  ratio ("square", "portrait" or "landscape").
{%- endcomment -%}
<div class="product-card-shell">
<a class="product-card{% if product.is_sold_out %} product-card--sold-out{% endif %}" href="{{ product.url }}">
  <div class="product-card__media{% if ratio != blank %} product-card__media--{{ ratio }}{% endif %}">
    {%- comment -%} Badges over the image: "Sold out", "Few left", a "badge:..." tag, "New". Quantity 0 is still listed and clickable {%- endcomment -%}
    {%- if product.on_sale -%}
      <span class="product-card__ribbon">Hot deal</span>
    {%- endif -%}
    {%- if product.badges.size > 0 -%}
      <span class="product-card__badges">
        {%- for badge in product.badges -%}
          <span class="product-card__badge{% if badge == 'New' %} product-card__badge--new{% endif %}">{{ badge }}</span>
        {%- endfor -%}
      </span>
    {%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image }}" alt="{{ product.title | escape }}" loading="lazy">
    {%- else -%}
      <div class="placeholder" style="width:100%;height:100%">No image</div>
    {%- endif -%}
  </div>
  {%- if show_vendor and product.vendor != blank -%}
    <span class="product-card__vendor">{{ product.vendor }}</span>
  {%- endif -%}
  <span class="product-card__title">{{ product.title }}</span>
  {%- if show_rating and product.rating -%}
    <span class="product-card__rating" aria-label="Rated {{ product.rating }} out of 5">&#9733; {{ product.rating }}{% if product.review_count > 0 %} <span>({{ product.review_count }})</span>{% endif %}</span>
  {%- endif -%}
  {%- if show_price != false -%}
    {%- if product.price == nil -%}
      <span class="price price--muted">Price on request</span>
    {%- elsif product.price_varies -%}
      <span class="price">From {{ product.price | money }}</span>
    {%- else -%}
      <span class="price">{{ product.price | money }}</span>
    {%- endif -%}
    {%- if product.on_sale and product.price != nil -%}
      <span class="price price--compare">{{ product.compare_at_price | money }}</span>
    {%- endif -%}
  {%- endif -%}
  {%- if show_tags and product.tags.size > 0 -%}
    <span class="product-card__tags">{% for tag in product.tags limit: 3 %}<span>{{ tag }}</span>{% endfor %}</span>
  {%- endif -%}
  {%- if show_add_to_cart -%}
    {%- assign card_disable_oos = settings.disable_out_of_stock_add_to_cart -%}
    {%- if card_disable_oos == nil -%}{%- assign card_disable_oos = true -%}{%- endif -%}
    {%- assign card_sold_out_text = settings.sold_out_button_label | default: 'Sold out' -%}
    {%- if product.is_sold_out and card_disable_oos and wishlist_action != 'remove' -%}
      <span class="button product-card__cta" aria-disabled="true" data-sold-out="true">{{ card_sold_out_text }}</span>
    {%- else -%}
      <span class="button product-card__cta">Add to cart</span>
    {%- endif -%}
  {%- endif -%}
</a>
{%- if show_wishlist or wishlist_action == 'remove' -%}
  {% render 'wishlist', mode: 'button', product: product, wishlist_ids: wishlist_ids, return_url: return_url, wishlist_action: wishlist_action, size: show_wishlist.size, label_text: show_wishlist.label %}
{%- endif -%}
</div>
