{%- comment -%}
  Customer Account Dashboard (Orders, Profile & Addresses).
  Usage:
    {% render 'customer-account', customer: customer, orders: customer.orders, addresses: customer.addresses, error: error, success: success %}
{%- endcomment -%}
<div class="customer-account">
  <div class="customer-account__header">
    <div class="customer-account__intro">
      <h1 class="customer-account__title">
        Hello, {{ customer.first_name | default: 'there' }}
      </h1>
      <p class="customer-account__email">{{ customer.email }}</p>
    </div>
    <div class="customer-account__header-actions">
      <a href="{{ shop.url }}/account/logout" class="button button--outline customer-account__logout">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
        <span>Sign out</span>
      </a>
    </div>
  </div>

  {%- if error != blank -%}
    <div class="alert alert--error" role="alert">
      <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <span>{{ error }}</span>
    </div>
  {%- endif -%}

  {%- if success != blank -%}
    <div class="alert alert--success" role="alert">
      <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <span>{{ success }}</span>
    </div>
  {%- endif -%}

  <div class="customer-account__grid">
    <!-- Main Column: Order History -->
    <div class="customer-account__main">
      <div class="account-card">
        <div class="account-card__header">
          <h2 class="account-card__title">Order History</h2>
          {%- if customer.orders.size > 0 -%}
            <span class="account-card__count">{{ customer.orders.size }} {{ customer.orders.size | pluralize: 'order', 'orders' }}</span>
          {%- endif -%}
        </div>

        {%- if customer.orders.size > 0 -%}
          <div class="orders-list">
            {%- for order in customer.orders -%}
              <div class="order-item">
                <div class="order-item__header">
                  <div>
                    <span class="order-item__number">Order {{ order.order_number }}</span>
                    <span class="order-item__date">{{ order.date }}</span>
                  </div>
                  <div class="order-item__status">
                    {%- assign p_status = order.status | downcase -%}
                    {%- assign f_status = order.fulfillment_status | downcase -%}
                    <span class="badge badge--{{ p_status }}">{{ order.status | capitalize }}</span>
                    {%- if f_status != 'unfulfilled' or p_status != 'cancelled' -%}
                      <span class="badge badge--{{ f_status }}">{{ order.fulfillment_status | capitalize }}</span>
                    {%- endif -%}
                  </div>
                </div>

                <div class="order-item__body">
                  {%- if order.items.size > 0 -%}
                    <div class="order-item__products">
                      {%- for item in order.items -%}
                        <div class="order-product-row">
                          <div class="order-product-row__info">
                            <a href="{{ item.product_url }}" class="order-product-row__title">{{ item.title }}</a>
                            <span class="order-product-row__qty">&times; {{ item.quantity }}</span>
                          </div>
                          <span class="order-product-row__price">{{ item.total_price | money }}</span>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>

                <div class="order-item__footer">
                  <span class="order-item__total-label">Total</span>
                  <span class="order-item__total-amount">{{ order.total | money }}</span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="empty-state">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-state__icon">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <p class="empty-state__title">You haven't placed any orders yet.</p>
            <p class="empty-state__sub">When you place orders, they will appear here with live tracking updates.</p>
            <a href="{{ shop.url }}/collections/all" class="button button--secondary empty-state__btn">
              Explore products
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Sidebar Column: Profile & Addresses -->
    <div class="customer-account__aside">
      <!-- Profile Details Card -->
      <div class="account-card">
        <div class="account-card__header">
          <h2 class="account-card__title">Profile Details</h2>
          <button type="button" class="text-link-btn" data-toggle-profile-edit>Edit</button>
        </div>

        <div class="profile-info" data-profile-view>
          <div class="info-row">
            <span class="info-label">Name</span>
            <span class="info-value">{{ customer.name | default: '—' }}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Email</span>
            <span class="info-value">{{ customer.email }}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Phone</span>
            <span class="info-value">{{ customer.phone | default: 'Not specified' }}</span>
          </div>
        </div>

        <!-- Inline Profile Edit Form -->
        <form class="profile-edit-form" method="post" action="{{ shop.url }}/account/profile/" data-profile-form style="display:none;">
          <div class="form-group">
            <label class="form-label" for="profile-first-name">First name</label>
            <input id="profile-first-name" class="form-input" type="text" name="first_name" value="{{ customer.first_name }}" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="profile-last-name">Last name</label>
            <input id="profile-last-name" class="form-input" type="text" name="last_name" value="{{ customer.last_name }}" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="profile-phone">Phone</label>
            <input id="profile-phone" class="form-input" type="tel" name="phone" value="{{ customer.phone }}">
          </div>
          <div class="form-actions">
            <button type="submit" class="button button--small">Save changes</button>
            <button type="button" class="button button--outline button--small" data-toggle-profile-edit>Cancel</button>
          </div>
        </form>
      </div>

      <!-- Address Book Card -->
      <div class="account-card">
        <div class="account-card__header">
          <h2 class="account-card__title">Address Book</h2>
          <button type="button" class="text-link-btn" data-toggle-new-address>+ Add</button>
        </div>

        <!-- Inline New Address Form -->
        <form class="address-form" method="post" action="{{ shop.url }}/account/addresses/" data-new-address-form style="display:none;">
          <input type="hidden" name="action" value="add">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="addr-first-name">First name</label>
              <input id="addr-first-name" class="form-input" type="text" name="first_name" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="addr-last-name">Last name</label>
              <input id="addr-last-name" class="form-input" type="text" name="last_name" required>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="addr-company">Company (optional)</label>
            <input id="addr-company" class="form-input" type="text" name="company">
          </div>
          <div class="form-group">
            <label class="form-label" for="addr-line1">Address</label>
            <input id="addr-line1" class="form-input" type="text" name="address_line_1" required placeholder="Street address">
          </div>
          <div class="form-group">
            <label class="form-label" for="addr-line2">Apartment, suite, etc. (optional)</label>
            <input id="addr-line2" class="form-input" type="text" name="address_line_2">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="addr-city">City</label>
              <input id="addr-city" class="form-input" type="text" name="city" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="addr-state">State / Province</label>
              <input id="addr-state" class="form-input" type="text" name="state" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="addr-zip">Postal code</label>
              <input id="addr-zip" class="form-input" type="text" name="postal_code" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="addr-country">Country</label>
              <input id="addr-country" class="form-input" type="text" name="country" required value="Australia">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="addr-phone">Phone</label>
            <input id="addr-phone" class="form-input" type="tel" name="phone">
          </div>
          <div class="form-group form-group--checkbox">
            <label class="checkbox-label" for="addr-default">
              <input id="addr-default" type="checkbox" name="is_default" value="true">
              <span>Set as default address</span>
            </label>
          </div>
          <div class="form-actions">
            <button type="submit" class="button button--small">Save address</button>
            <button type="button" class="button button--outline button--small" data-toggle-new-address>Cancel</button>
          </div>
        </form>

        <!-- Addresses List -->
        {%- if customer.addresses.size > 0 -%}
          <div class="addresses-list">
            {%- for addr in customer.addresses -%}
              <div class="address-item{% if addr.is_default %} address-item--default{% endif %}">
                <div class="address-item__header">
                  <span class="address-item__name">{{ addr.name }}</span>
                  {%- if addr.is_default -%}
                    <span class="badge badge--default">Default</span>
                  {%- endif -%}
                </div>
                <div class="address-item__lines">
                  {%- if addr.company != blank -%}<p>{{ addr.company }}</p>{%- endif -%}
                  <p>{{ addr.address1 }}</p>
                  {%- if addr.address2 != blank -%}<p>{{ addr.address2 }}</p>{%- endif -%}
                  <p>{{ addr.city }}, {{ addr.state }} {{ addr.postal_code }}</p>
                  <p>{{ addr.country }}</p>
                  {%- if addr.phone != blank -%}<p class="address-item__phone">{{ addr.phone }}</p>{%- endif -%}
                </div>
                <div class="address-item__actions">
                  {%- unless addr.is_default -%}
                    <form method="post" action="{{ shop.url }}/account/addresses/" style="display:inline;">
                      <input type="hidden" name="action" value="set_default">
                      <input type="hidden" name="address_id" value="{{ addr.id }}">
                      <button type="submit" class="action-link-btn">Make default</button>
                    </form>
                    <span class="action-sep">&middot;</span>
                  {%- endunless -%}
                  <form method="post" action="{{ shop.url }}/account/addresses/" style="display:inline;" onsubmit="return confirm('Delete this address?');">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="address_id" value="{{ addr.id }}">
                    <button type="submit" class="action-link-btn action-link-btn--danger">Delete</button>
                  </form>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="empty-state-subtle">
            <p>No addresses saved yet.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  // Toggle profile editing
  var profileToggles = document.querySelectorAll("[data-toggle-profile-edit]");
  var profileView = document.querySelector("[data-profile-view]");
  var profileForm = document.querySelector("[data-profile-form]");
  if (profileToggles.length && profileView && profileForm) {
    profileToggles.forEach(function(btn) {
      btn.addEventListener("click", function() {
        var isEditing = profileForm.style.display !== "none";
        profileForm.style.display = isEditing ? "none" : "block";
        profileView.style.display = isEditing ? "block" : "none";
      });
    });
  }

  // Toggle new address form
  var addressToggles = document.querySelectorAll("[data-toggle-new-address]");
  var addressForm = document.querySelector("[data-new-address-form]");
  if (addressToggles.length && addressForm) {
    addressToggles.forEach(function(btn) {
      btn.addEventListener("click", function() {
        var isVisible = addressForm.style.display !== "none";
        addressForm.style.display = isVisible ? "none" : "block";
        if (!isVisible) {
          addressForm.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      });
    });
  }
})();
</script>
