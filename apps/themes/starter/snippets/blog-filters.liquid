{%- comment -%}
  Category links above the blog's posts ("All" and one per category).
  Usage: {% render 'blog-filters', enabled: s.show_filters %}   (`blog` is the page's blog)
{%- endcomment -%}
{%- if enabled and blog.categories.size > 0 -%}
  <nav class="blog__filters" aria-label="Categories">
    <a href="{{ blog.all_url }}"{% if blog.filter == nil %} aria-current="page"{% endif %}>All</a>
    {%- for category in blog.categories -%}
      <a href="{{ category.url }}"{% if category.active %} aria-current="page"{% endif %}>{{ category.name }}</a>
    {%- endfor -%}
  </nav>
{%- endif -%}
<style>
  .blog__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 36px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .blog__filters a {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    color: var(--muted);
    background: var(--bg);
    transition: all 0.2s ease;
  }
  .blog__filters a:hover {
    border-color: var(--text);
    color: var(--text);
    background: var(--soft);
  }
  .blog__filters a[aria-current="page"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }
  .blog__filters a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
