<style>
  :root {
    --accent: {{ settings.accent_color }};
    --bg: {{ settings.background_color }};
    --text: {{ settings.text_color }};
    --muted: color-mix(in srgb, var(--text) 60%, var(--bg));
    --line: color-mix(in srgb, var(--text) 12%, var(--bg));
    --soft: color-mix(in srgb, var(--text) 5%, var(--bg));
    --radius: 14px;
    --page: 1200px;
    /* Product card & grid: change these here (a theme preset may override them) */
    --card-padding: 16px;
    --card-border: 1px solid #e5e5e5;
    --card-radius: 6px;
    --card-bg: #fff;
    --card-media-padding: 8px;
    --card-media-bg: #fff;
    --card-media-fit: contain;
    --card-gap: 4px;
    --card-title-size: 14px;
    --card-title-weight: 400;
    --card-price-size: 22px;
    --card-price-color: #a51c30;
    --card-compare-size: 15px;
    --grid-gap-y: 24px;
    --section-spacing: 48px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { line-height: 1.15; margin: 0 0 .5em; letter-spacing: -0.01em; }
  .page-width { max-width: var(--page); margin: 0 auto; padding: 0 20px; }
  .section { padding: 56px 0; }
  .section-heading { font-size: clamp(22px, 3vw, 30px); margin-bottom: 24px; }

  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 46px; padding: 0 26px; border-radius: 999px; border: 1px solid var(--accent);
    background: var(--accent); color: var(--bg); font: inherit; font-weight: 600;
    text-decoration: none; cursor: pointer; transition: opacity .15s;
  }
  .button:hover { opacity: .88; }
  .button--outline { background: transparent; color: var(--accent); }
  .button:disabled { opacity: .45; cursor: not-allowed; }

  .placeholder {
    background: linear-gradient(135deg, var(--soft), color-mix(in srgb, var(--accent) 18%, var(--bg)));
    display: flex; align-items: center; justify-content: center;
    color: var(--muted); font-size: 13px;
  }

  .announcement { display: block; background: var(--accent); color: var(--bg); text-align: center; font-size: 13px; padding: 8px 16px; text-decoration: none; }
  .announcement--link:hover { text-decoration: underline; }

  /* Header & footer */
  .site-header { background: var(--bg); z-index: 10; }
  .site-header[data-border="true"] { border-bottom: 1px solid var(--line); }
  .site-header[data-sticky="true"] { position: sticky; top: 0; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .site-header__logo { font-weight: 800; font-size: 20px; text-decoration: none; display: inline-flex; align-items: center; }
  .site-header__nav { display: flex; gap: 22px; flex-wrap: wrap; font-size: 15px; }
  .site-header__nav a { text-decoration: none; color: inherit; opacity: .7; }
  .site-header__nav a:hover { opacity: 1; }
  .site-header__actions { display: flex; align-items: center; margin-left: auto; gap: 4px; }
  .site-header__search,
  .site-header__account,
  .site-header__profile,
  .site-header__wishlist {
    display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
    padding: 0; border: 0; border-radius: 50%; background: transparent; color: inherit;
    cursor: pointer; opacity: .8; transition: opacity .15s, background-color .15s;
    text-decoration: none;
  }
  .site-header__search:hover,
  .site-header__account:hover,
  .site-header__profile:hover,
  .site-header__wishlist:hover { opacity: 1; background: var(--soft); }
  .site-header__search:focus-visible,
  .site-header__account:focus-visible,
  .site-header__profile:focus-visible,
  .site-header__wishlist:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .site-header__search svg,
  .site-header__account svg,
  .site-header__wishlist svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .site-header__profile img { border-radius: 50%; object-fit: cover; }
  .site-header[data-layout="center"] .site-header__inner { flex-direction: column; justify-content: center; padding-top: 14px; padding-bottom: 14px; gap: 10px; }
  .site-header[data-layout="center"] .site-header__actions { margin-left: 0; }
  @media (max-width: 640px) {
    .site-header__inner { flex-wrap: wrap; }
    .site-header__nav { order: 3; flex: 1 0 100%; justify-content: center; gap: 14px; }
    .site-header__actions { order: 2; }
    .site-header[data-layout="center"] .site-header__nav { order: 2; flex: initial; }
    .site-header[data-layout="center"] .site-header__actions { order: 3; }
  }
  .site-footer { border-top: 1px solid var(--line); margin-top: 40px; padding: 32px 0; color: var(--muted); font-size: 14px; }
  .site-footer__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px 48px; padding-bottom: 24px; }
  .site-footer__about { max-width: 420px; }
  .site-footer__about strong { color: var(--text); }
  .site-footer__about p { margin: 6px 0 0; white-space: pre-line; }
  .site-footer__about .site-footer__icon { margin-bottom: 16px; }
  .site-footer__about .site-footer__icon + p { margin-top: 0; }
  .site-footer__icon { flex-shrink: 0; }
  .site-footer__icon img { max-height: 48px; max-width: 140px; width: auto; height: auto; object-fit: contain; display: block; }
  .site-footer__nav, .site-footer__social { display: flex; flex-direction: column; gap: 8px; }
  .site-footer__social { flex-direction: row; flex-wrap: wrap; gap: 8px 16px; }
  .site-footer a { color: inherit; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }
  .site-footer__legal { padding-top: 0; }
  .site-footer__top + .site-footer__legal { border-top: 1px solid var(--line); padding-top: 20px; }

  /* Hero */
  .hero { position: relative; display: flex; align-items: center; overflow: hidden; background-size: cover; background-position: center; }
  .hero--small { min-height: 320px; } .hero--medium { min-height: 480px; } .hero--large { min-height: 640px; }
  .hero__overlay { position: absolute; inset: 0; background: #000; }
  .hero__content { position: relative; width: 100%; padding-top: 48px; padding-bottom: 48px; }
  .hero--image .hero__content { color: #fff; }
  .hero--image .button { background: #fff; color: #111; border-color: #fff; }
  .hero h1 { font-size: clamp(32px, 5vw, 56px); max-width: 720px; }
  .hero p { font-size: 18px; max-width: 560px; opacity: .9; margin-top: 0; margin-bottom: 24px; }
  .align-left { text-align: left; } .align-left > * { margin-right: auto; }
  .align-center { text-align: center; } .align-center > * { margin-left: auto; margin-right: auto; }
  .align-right { text-align: right; } .align-right > * { margin-left: auto; }

  /* Slideshow */
  .slideshow { position: relative; overflow: hidden; }
  .slideshow__track { display: flex; transition: transform .6s ease; }
  .slideshow__slide { flex: 0 0 100%; }
  .slideshow__dots { position: absolute; left: 0; right: 0; bottom: 18px; display: flex; justify-content: center; gap: 8px; }
  .slideshow__dot { width: 10px; height: 10px; border-radius: 50%; border: 0; padding: 0; background: rgba(255,255,255,.5); cursor: pointer; box-shadow: 0 0 0 1px rgba(0,0,0,.15); }
  .slideshow__dot[aria-current="true"] { background: #fff; }
  .slideshow__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%;
    border: 0; background: rgba(255,255,255,.85); color: #111; font-size: 20px; cursor: pointer;
  }
  .slideshow__arrow--prev { left: 16px; } .slideshow__arrow--next { right: 16px; }

  /* Product cards, grid & carousel */
  .product-grid { display: grid; gap: 24px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) {
    .product-grid--2 { grid-template-columns: repeat(2, 1fr); } .product-grid--3 { grid-template-columns: repeat(3, 1fr); }
    .product-grid--4 { grid-template-columns: repeat(4, 1fr); } .product-grid--5 { grid-template-columns: repeat(5, 1fr); }
  }
  .product-list__grid, .wishlist-page__grid { display: grid; column-gap: var(--gap, 8px); row-gap: var(--grid-gap-y); grid-template-columns: repeat(var(--cols-mobile, 2), minmax(0, 1fr)); }
  .product-list__track { gap: var(--gap, 8px); grid-auto-columns: calc((100% - (var(--cols-mobile, 2) - 1) * var(--gap, 8px)) / var(--cols-mobile, 2)); }
  @media (min-width: 601px) {
    .product-list__grid, .wishlist-page__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .product-list__track { grid-auto-columns: calc((100% - 2 * var(--gap, 8px)) / 3); }
  }
  @media (min-width: 900px) {
    .product-list__grid { grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr)); }
    .wishlist-page__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .product-list__track { grid-auto-columns: calc((100% - (var(--cols, 5) - 1) * var(--gap, 8px)) / var(--cols, 5)); }
  }
  .product-list.section, .tss-wrap .product-list.section { padding-top: var(--section-spacing); padding-bottom: var(--section-spacing); }

  .product-card-shell { width: 100%; margin-inline: auto; height: 100%; }
  .product-card {
    text-decoration: none; display: flex; flex-direction: column; height: 100%; gap: var(--card-gap);
    padding: var(--card-padding); border: var(--card-border); border-radius: var(--card-radius);
    background: var(--card-bg); color: #222; font-size: 14px; text-align: left;
    transition: border-color .2s, box-shadow .2s, transform .2s;
  }
  .product-card:hover { border-color: #c9c9c9; box-shadow: 0 4px 12px rgba(0,0,0,.07); }
  .product-card__media { width: 100%; aspect-ratio: 1; padding: var(--card-media-padding); background: var(--card-media-bg); border-radius: 0; overflow: hidden; }
  .product-card__media--portrait { aspect-ratio: 3/4; } .product-card__media--landscape { aspect-ratio: 4/3; } .product-card__media--square { aspect-ratio: 1; }
  .product-card__media img, .product-card__media .placeholder { width: 100%; height: 100%; object-fit: var(--card-media-fit); transition: transform .4s; }
  .product-card:hover .product-card__media img { transform: scale(1.04); }
  .product-card__title {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3; min-height: 2.6em;
    font-family: Inter, sans-serif; font-size: var(--card-title-size); font-weight: var(--card-title-weight); color: #222;
  }
  .product-card .price { font-family: Inter, sans-serif; font-size: var(--card-price-size); font-weight: 700; color: var(--card-price-color); }
  .product-card .price--compare { display: block; font-size: var(--card-compare-size); font-weight: 400; color: #888; text-decoration: line-through; }
  @media (max-width: 600px) { .product-card { --card-title-size: 13px; --card-price-size: 18px; } }
  .product-card__vendor { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .price { font-weight: 600; }
  .price--muted { color: var(--muted); font-weight: 400; }

  .carousel__header { display: flex; align-items: end; justify-content: space-between; gap: 16px; }
  .carousel__controls { display: flex; gap: 8px; margin-bottom: 24px; }
  .carousel__btn { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); color: var(--text); cursor: pointer; font-size: 18px; }
  .carousel__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 24px) / 2); gap: 24px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px;
  }
  .carousel__track::-webkit-scrollbar { display: none; }
  .carousel__track > * { scroll-snap-align: start; }
  @media (min-width: 900px) { .carousel__track { grid-auto-columns: calc((100% - 72px) / 4); } }

  .empty-state { border: 1px dashed var(--line); border-radius: var(--radius); padding: 40px; text-align: center; color: var(--muted); }

  /* Product page */
  .product { display: grid; gap: 40px; }
  @media (min-width: 900px) { .product { grid-template-columns: 1.1fr 1fr; align-items: start; } }
  .product__main-image { border-radius: var(--radius); overflow: hidden; background: var(--soft); }
  .product__main-image img { width: 100%; height: 100%; object-fit: var(--img-fit, cover); }
  @media (min-width: 900px) { .product--media-right { grid-template-columns: 1fr 1.1fr; } .product--media-right .product__media { order: 2; } }
  .ratio-square { aspect-ratio: 1; } .ratio-portrait { aspect-ratio: 3 / 4; } .ratio-landscape { aspect-ratio: 4 / 3; }
  .product__thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; }
  .product__thumb { width: 72px; height: 72px; border-radius: 10px; overflow: hidden; border: 2px solid transparent; padding: 0; cursor: pointer; background: var(--soft); flex: none; }
  .product__thumb[aria-current="true"] { border-color: var(--accent); }
  .product__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .product__info h1 { font-size: clamp(26px, 3.5vw, 38px); }
  .product__price { font-size: 22px; margin-bottom: 20px; }
  .product__meta { color: var(--muted); font-size: 14px; margin-bottom: 8px; }
  .product__form { display: grid; gap: 14px; margin: 24px 0; max-width: 420px; }
  .field { display: grid; gap: 6px; font-size: 14px; }
  .field select, .field input { height: 46px; border: 1px solid var(--line); border-radius: 10px; padding: 0 12px; font: inherit; background: var(--bg); color: var(--text); }
  .product__description { border-top: 1px solid var(--line); padding-top: 20px; }
  .product__notice { font-size: 14px; color: var(--muted); min-height: 20px; }
  .rich-text { max-width: 720px; }
  .rich-text p { font-size: 18px; color: var(--muted); white-space: pre-line; }

  /* Customer Authentication & Account */
  .customer-auth-section { min-height: 60vh; display: flex; align-items: center; justify-content: center; }
  .customer-auth { width: 100%; max-width: 460px; margin: 0 auto; }
  .customer-card { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 36px 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
  .customer-card__header { text-align: center; margin-bottom: 24px; }
  .customer-card__title { font-size: 28px; font-weight: 700; margin: 0 0 8px; }
  .customer-card__subtitle { font-size: 14px; color: var(--muted); margin: 0; }
  .customer-auth-tabs { display: flex; border-bottom: 2px solid var(--line); margin-bottom: 24px; gap: 4px; }
  .customer-auth-tab { flex: 1; padding: 10px 16px; border: none; background: none; font: inherit; font-size: 15px; font-weight: 600; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: color .15s, border-color .15s; text-align: center; text-decoration: none; display: inline-flex; justify-content: center; align-items: center; }
  .customer-auth-tab:hover { color: var(--text); }
  .customer-auth-tab.is-active { color: var(--text); border-bottom-color: var(--accent); }
  .customer-form { display: grid; gap: 16px; }
  .form-group { display: grid; gap: 6px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }
  .form-label { font-size: 13px; font-weight: 600; color: var(--text); }
  .form-label-opt { font-weight: 400; color: var(--muted); }
  .form-label-row { display: flex; justify-content: space-between; align-items: baseline; }
  .form-input { height: 46px; border: 1px solid var(--line); border-radius: calc(var(--radius) / 2); padding: 0 14px; font: inherit; background: var(--bg); color: var(--text); width: 100%; box-sizing: border-box; transition: border-color .15s, box-shadow .15s; }
  .form-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 20%, transparent); }
  .password-wrapper { position: relative; display: flex; align-items: center; }
  .password-wrapper .form-input { padding-right: 44px; }
  .password-toggle { position: absolute; right: 10px; background: none; border: none; padding: 6px; cursor: pointer; color: var(--muted); display: inline-flex; align-items: center; justify-content: center; }
  .password-toggle:hover { color: var(--text); }
  .form-group--checkbox { display: flex; align-items: center; margin: 4px 0; }
  .checkbox-label { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text); cursor: pointer; user-select: none; }
  .checkbox-label input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; }
  .button--full { width: 100%; margin-top: 8px; }
  .button--small { min-height: 36px; padding: 0 16px; font-size: 13px; border-radius: 6px; }
  .customer-card__footer { text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 14px; color: var(--muted); display: grid; gap: 10px; }
  .customer-card__footer p { margin: 0; }
  .auth-link { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .auth-link:hover { opacity: .8; }
  .auth-link-subtle { color: var(--muted); text-decoration: none; font-size: 13px; }
  .auth-link-subtle:hover { color: var(--text); }
  .alert { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 20px; line-height: 1.4; }
  .alert--error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
  .alert--success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }

  /* Customer Account Dashboard */
  .customer-account { padding: 12px 0 64px; }
  .customer-account__header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .customer-account__title { font-size: clamp(26px, 3.5vw, 36px); margin: 0 0 6px; }
  .customer-account__email { margin: 0; color: var(--muted); font-size: 15px; }
  .customer-account__identity { display: flex; align-items: center; gap: 16px; }
  .customer-account__avatar { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; font-size: 22px; font-weight: 700; color: #fff; background: var(--accent); }
  .customer-account__intro .customer-account__title { margin-bottom: 2px; }
  .account-card { box-shadow: 0 8px 24px -16px color-mix(in srgb, var(--text) 30%, transparent); }
  .order-item__number { letter-spacing: .01em; }
  .customer-account__grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  @media (min-width: 960px) { .customer-account__grid { grid-template-columns: 1.4fr 1fr; align-items: start; } }
  .account-card { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; margin-bottom: 24px; }
  .account-card__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .account-card__title { font-size: 18px; font-weight: 700; margin: 0; }
  .account-card__count { font-size: 13px; color: var(--muted); }
  .text-link-btn { background: none; border: none; padding: 0; color: var(--accent); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: underline; }
  .text-link-btn:hover { opacity: .8; }
  .orders-list { display: grid; gap: 16px; }
  .order-item { border: 1px solid var(--line); border-radius: calc(var(--radius) / 2); padding: 18px; background: var(--soft); }
  .order-item__header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 12px; }
  .order-item__number { font-weight: 700; font-size: 15px; margin-right: 12px; }
  .order-item__date { font-size: 13px; color: var(--muted); }
  .order-item__status { display: flex; gap: 6px; }
  .order-item__body { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 12px 0; margin: 12px 0; }
  .order-product-row { display: flex; justify-content: space-between; align-items: center; font-size: 14px; padding: 4px 0; }
  .order-product-row__title { font-weight: 500; text-decoration: none; }
  .order-product-row__title:hover { text-decoration: underline; }
  .order-product-row__qty { color: var(--muted); font-size: 13px; margin-left: 6px; }
  .order-product-row__price { font-weight: 600; }
  .order-item__footer { display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
  .order-item__total-amount { font-size: 16px; font-weight: 700; }
  .empty-state__icon { color: var(--muted); margin-bottom: 12px; }
  .empty-state__title { font-size: 16px; font-weight: 600; margin: 0 0 6px; color: var(--text); }
  .empty-state__sub { font-size: 13px; color: var(--muted); margin: 0 0 16px; }
  .profile-info { display: grid; gap: 12px; }
  .info-row { display: flex; justify-content: space-between; font-size: 14px; padding-bottom: 8px; border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  .info-label { color: var(--muted); }
  .info-value { font-weight: 500; }
  .profile-edit-form, .address-form { display: grid; gap: 12px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); }
  .form-actions { display: flex; gap: 10px; margin-top: 8px; }
  .addresses-list { display: grid; gap: 14px; }
  .address-item { border: 1px solid var(--line); border-radius: calc(var(--radius) / 2); padding: 14px; font-size: 13px; line-height: 1.5; }
  .address-item--default { border-color: color-mix(in srgb, var(--accent) 40%, transparent); background: var(--soft); }
  .address-item__header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-weight: 600; }
  .address-item__lines p { margin: 2px 0; color: var(--muted); }
  .address-item__actions { margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--line); font-size: 12px; }
  .action-link-btn { background: none; border: none; padding: 0; color: var(--accent); font: inherit; cursor: pointer; text-decoration: underline; }
  .action-link-btn--danger { color: #dc2626; }
