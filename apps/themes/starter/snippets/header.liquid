{%- comment -%}
  Mega menu look: the panel follows the header colour; headings, links and "Shop All" use the --mega-* defaults of the
  CSS below. The synced header section (sections/header.liquid) has settings for all of them.
{%- endcomment -%}
{%- assign mega_shop_all = true -%}
{%- assign mega_shop_all_label = 'Shop All' -%}
{%- assign auto_collections = 4 -%}
{%- assign uid = 'snippet' -%}
{%- assign use_blocks = false -%}
{%- assign nav_entries = links -%}
{%- capture header_style -%}
  {% if settings.header_bg != blank %}--mega-bg:{{ settings.header_bg }};{% endif %}
  {% if settings.header_text != blank %}--mega-link-color:{{ settings.header_text }};{% endif %}
  {% if settings.header_bg != blank %}background:{{ settings.header_bg }};{% endif %}
  {% if settings.header_text != blank %}color:{{ settings.header_text }};{% endif %}
{%- endcapture -%}
<header class="site-header"
  data-sticky="{% if settings.header_sticky != false %}true{% else %}false{% endif %}"
  data-border="{% if settings.header_border != false %}true{% else %}false{% endif %}"
  data-layout="{% if settings.header_layout == 'center' %}center{% else %}left{% endif %}"
  data-mobile-accordion="false"
  style="{{ header_style | strip }}">
  <div class="page-width site-header__inner">
    <a class="site-header__logo" href="{{ shop.url }}/">
      {%- if settings.header_logo_url != blank -%}
        <img src="{{ settings.header_logo_url }}" alt="{{ shop.name }}" style="height: {{ settings.header_logo_height | default: 36 }}px; width: auto;">
      {%- elsif settings.header_logo_text != blank -%}
        {{ settings.header_logo_text }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
    {%- if settings.header_show_nav != false -%}
      <button class="site-header__hamburger" type="button" aria-expanded="false" aria-controls="site-nav-{{ uid }}" aria-label="Open menu" data-nav-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
      </button>
      <div class="site-header__backdrop" data-nav-backdrop hidden></div>
      <div class="site-header__drawer" id="site-nav-{{ uid }}" data-nav-drawer>
        <div class="site-header__drawer-head">
          <span class="site-header__drawer-title">Menu</span>
          <button class="site-header__drawer-close" type="button" data-nav-close aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg></button>
        </div>
        <nav class="site-header__nav" aria-label="Main">
        {%- if nav_entries.size > 0 -%}
          {%- for entry in nav_entries -%}
            {%- assign item = nil -%}
            {%- assign label = '' -%}
            {%- assign link_url = '' -%}
            {%- if use_blocks -%}
              {%- assign label = entry.settings.label -%}
              {%- assign link_url = entry.settings.url -%}
              {%- for m in menu_links -%}
                {%- if m.label == label -%}
                  {%- assign item = m -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- assign item = entry -%}
              {%- assign label = entry.label -%}
            {%- endif -%}
            {%- assign href = link_url -%}
            {%- if item and item.url != blank -%}
              {%- assign href = item.url -%}
            {%- endif -%}
            {%- assign real_link = false -%}
            {%- if href != blank and href != '#' -%}
              {%- assign real_link = true -%}
            {%- endif -%}
            {%- assign badge = '' -%}
            {%- if item -%}
              {%- assign badge = item.badge -%}
            {%- endif -%}
            {%- assign has_panel = false -%}
            {%- if item -%}
              {%- if item.columns.size > 0 or item.promo -%}
                {%- assign has_panel = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- if has_panel -%}
              <div class="site-header__item site-header__item--mega" data-nav-top data-nav-item data-nav-label="{{ label | escape }}" data-nav-href="{% if real_link %}{{ href }}{% endif %}"{% if use_blocks %}{{ entry.attrs }}{% endif %}>
                {%- if real_link -%}
                  <a class="site-header__link" href="{{ href }}">{{ label }}{%- if badge != blank -%}<span class="menu-badge">{{ badge }}</span>{%- endif -%}</a>
                  <button class="site-header__disclosure" type="button" aria-expanded="false" aria-controls="mega-menu-{{ uid }}-{{ forloop.index }}" aria-label="{{ label | escape }} menu"><svg class="site-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                {%- else -%}
                  <button class="site-header__link site-header__disclosure site-header__disclosure--label" type="button" aria-expanded="false" aria-controls="mega-menu-{{ uid }}-{{ forloop.index }}">{{ label }}{%- if badge != blank -%}<span class="menu-badge">{{ badge }}</span>{%- endif -%}<svg class="site-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                {%- endif -%}
                <button class="site-header__drill" type="button" aria-expanded="false" aria-controls="mega-menu-{{ uid }}-{{ forloop.index }}" data-nav-drill>{{ label }}{%- if badge != blank -%}<span class="menu-badge">{{ badge }}</span>{%- endif -%}<svg class="site-header__drill-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <div class="mega-menu" id="mega-menu-{{ uid }}-{{ forloop.index }}" role="region" aria-label="{{ label | escape }}" inert>
                  <div class="mega-menu__mobile-head">
                    <button class="mega-menu__back" type="button" data-nav-back aria-label="Back to main menu"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg></button>
                    <span class="mega-menu__mobile-title">{{ label }}</span>
                    <button class="mega-menu__close" type="button" data-nav-close aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg></button>
                  </div>
                  <div class="page-width mega-menu__inner">
                    <div class="mega-menu__main">
                      {%- if real_link -%}
                        <a class="mega-menu__item-shop-all" href="{{ href }}">{{ mega_shop_all_label }} {{ label }}</a>
                      {%- endif -%}
                      {%- if item.columns.size > 0 -%}
                        <div class="mega-menu__columns">
                          {%- for col in item.columns -%}
                            {%- assign col_link = false -%}
                            {%- if col.url != blank and col.url != '#' -%}
                              {%- assign col_link = true -%}
                            {%- endif -%}
                            <div class="mega-menu__column{% if col.links.size > 0 %} mega-menu__column--has-sublinks{% endif %}">
                              <div class="mega-menu__column-header">
                                <div class="mega-menu__column-title">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</div>
                                {%- if col_link -%}
                                  <a class="mega-menu__column-link" href="{{ col.url }}">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</a>
                                {%- else -%}
                                  <span class="mega-menu__column-link">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</span>
                                {%- endif -%}
                                {%- if col.links.size > 0 -%}
                                  <button class="mega-menu__col-toggle" type="button" aria-expanded="false" aria-controls="mega-col-{{ uid }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}<svg class="mega-menu__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                                {%- endif -%}
                              </div>
                              {%- if col.links.size > 0 -%}
                                <ul class="mega-menu__sublinks" id="mega-col-{{ uid }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                                  {%- for sub in col.links -%}
                                    <li class="mega-menu__sublink-item">
                                      <a class="mega-menu__sublink" href="{{ sub.url | default: '#' }}">{{ sub.label }}{%- if sub.badge != blank -%}<span class="menu-badge">{{ sub.badge }}</span>{%- endif -%}</a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                              {%- if col_link -%}
                                <a class="mega-menu__shop-all{% if mega_shop_all == false %} mega-menu__shop-all--mobile-only{% endif %}" href="{{ col.url }}">{{ mega_shop_all_label }}</a>
                              {%- endif -%}
                            </div>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      {%- if real_link -%}
                        <a class="mega-menu__item-shop-all-mobile" href="{{ href }}">{{ mega_shop_all_label }}</a>
                      {%- endif -%}
                    </div>
                    {%- if item.promo -%}
                      {%- assign show_promo = false -%}
                      {%- if item.promo.image != blank or item.promo.title != blank or item.promo.subtitle != blank -%}
                        {%- assign show_promo = true -%}
                      {%- endif -%}
                      {%- if show_promo -%}
                        <div class="mega-menu__promo">
                          {%- if item.promo.url != blank and item.promo.url != '#' -%}
                            <a class="mega-menu__promo-link" href="{{ item.promo.url }}">
                          {%- else -%}
                            <div class="mega-menu__promo-link">
                          {%- endif -%}
                            {%- if item.promo.image != blank -%}
                              <div class="mega-menu__promo-image-wrap">
                                <img class="mega-menu__promo-image" src="{{ item.promo.image }}" alt="{{ item.promo.title | escape }}" loading="lazy" />
                              </div>
                            {%- endif -%}
                            {%- if item.promo.title != blank or item.promo.subtitle != blank -%}
                              <div class="mega-menu__promo-content">
                                {%- if item.promo.title != blank -%}
                                  <div class="mega-menu__promo-title">{{ item.promo.title }}</div>
                                {%- endif -%}
                                {%- if item.promo.subtitle != blank -%}
                                  <div class="mega-menu__promo-subtitle">{{ item.promo.subtitle }}</div>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- if item.promo.url != blank and item.promo.url != '#' -%}
                            </a>
                          {%- else -%}
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- else -%}
              <div class="site-header__item" data-nav-top data-nav-label="{{ label | escape }}" data-nav-href="{% if real_link %}{{ href }}{% endif %}">
                <a class="site-header__link" href="{{ href | default: '#' }}"{% if use_blocks %}{{ entry.attrs }}{% endif %}>{{ label }}{%- if badge != blank -%}<span class="menu-badge">{{ badge }}</span>{%- endif -%}</a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="site-header__item" data-nav-top data-nav-label="Home" data-nav-href="{{ shop.url }}/"><a class="site-header__link" href="{{ shop.url }}/">Home</a></div>
          <div class="site-header__item" data-nav-top data-nav-label="Shop all" data-nav-href="{{ shop.url }}/collections/all"><a class="site-header__link" href="{{ shop.url }}/collections/all">Shop all</a></div>
          {%- for collection in collections limit: auto_collections -%}
            <div class="site-header__item" data-nav-top data-nav-label="{{ collection.name | escape }}" data-nav-href="{{ collection.url }}"><a class="site-header__link" href="{{ collection.url }}">{{ collection.name }}</a></div>
          {%- endfor -%}
        {%- endif -%}
        <div class="site-header__item site-header__item--more" data-nav-item data-nav-more hidden>
          <button class="site-header__link site-header__disclosure site-header__disclosure--label" type="button" aria-expanded="false" aria-controls="nav-more-{{ uid }}">More<svg class="site-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <div class="site-nav__more" id="nav-more-{{ uid }}" data-nav-more-panel inert></div>
        </div>
        </nav>
      </div>
    {%- endif -%}
  </div>
  <style>
    body .site-header {
      position: sticky;
      z-index: 1000;
    }
    body .site-header:has(.mega-menu),
    body .site-header__inner:has(.mega-menu) {
      overflow: visible;
    }
    body .site-header__nav [hidden] {
      display: none !important;
    }
    /* Parts that only exist on mobile (the menu button, the drawer's own header, the drill-down) or only on desktop */
    body .site-header .site-header__hamburger,
    body .site-header .site-header__backdrop,
    body .site-header .site-header__drawer-head,
    body .site-header .site-header__drill,
    body .site-header .mega-menu__mobile-head,
    body .site-header .mega-menu__column-link,
    body .site-header .mega-menu__item-shop-all-mobile,
    body .site-header .mega-menu__col-toggle {
      display: none;
    }
    body .site-header__nav .site-header__chevron {
      width: 9px;
      height: 6px;
      margin-left: 6px;
      transition: transform 0.2s ease;
      pointer-events: none;
      opacity: 0.7;
    }
    body .site-header__nav .site-header__disclosure:not(.site-header__disclosure--label) .site-header__chevron {
      margin-left: 0;
    }
    body .site-header__nav .site-header__item.is-open > .site-header__disclosure .site-header__chevron {
      transform: rotate(180deg);
    }
    body .site-header__nav .menu-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 700;
      line-height: 1;
      padding: 2px 7px;
      border-radius: 999px;
      background: var(--accent);
      color: var(--bg);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-left: 6px;
      vertical-align: middle;
    }
    /* Accessible focus states */
    body .site-header__nav a:focus-visible,
    body .site-header__nav button:focus-visible,
    body .site-header__hamburger:focus-visible,
    body .site-header__drawer-close:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    /* Desktop navigation styles */
    @media (min-width: 769px) {
      body .site-header__drawer {
        display: contents;
      }
      body .site-header__nav {
        display: flex;
        align-items: stretch;
        flex: 0 1 auto;
        flex-wrap: nowrap;
        min-width: 0;
      }
      body .site-header__nav .site-header__item {
        position: relative;
        display: inline-flex;
        align-items: center;
        align-self: stretch;
        flex: 0 0 auto;
        min-height: 48px;
        white-space: nowrap;
      }
      body .site-header__nav .site-header__item--mega {
        position: static;
      }
      body .site-header__nav .site-header__link {
        display: inline-flex;
        align-items: center;
        height: 100%;
      }
      body .site-header__nav button.site-header__disclosure {
        appearance: none;
        -webkit-appearance: none;
        display: inline-flex;
        align-items: center;
        height: 100%;
        margin: 0;
        padding: 0 4px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        cursor: pointer;
        opacity: 0.7;
      }
      body .site-header__nav button.site-header__disclosure--label {
        padding: 0;
        opacity: 0.7;
      }
      /* Top-level hover / active colour: its own setting, else the heading colour */
      body .site-header__nav .site-header__item:hover > .site-header__link,
      body .site-header__nav .site-header__item.is-open > .site-header__link,
      body .site-header__nav .site-header__item:hover > .site-header__disclosure,
      body .site-header__nav .site-header__item.is-open > .site-header__disclosure {
        color: var(--mega-top-hover, var(--mega-heading-color, var(--accent)));
        opacity: 1;
      }
      /* Hover bridge to prevent dead zones between trigger and menu */
      body .site-header__nav .mega-menu::before,
      body .site-header__nav .site-nav__more::before {
        content: "";
        position: absolute;
        top: -24px;
        left: 0;
        right: 0;
        height: 24px;
      }
      /* Reveal: the panel slides and clips open in 360ms while it fades in over 270ms */
      body .site-header__nav .mega-menu,
      body .site-header__nav .site-nav__more {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        clip-path: inset(0 0 100% 0);
        transform: translateY(-12px);
        transition: clip-path 0.36s cubic-bezier(0.4, 0, 0.2, 1), transform 0.36s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.27s ease, visibility 0s linear 0.36s;
      }
      body .site-header__nav .site-header__item.is-open > .mega-menu,
      body .site-header__nav .site-header__item.is-open > .site-nav__more {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        clip-path: inset(-24px -60px -80px -60px);
        transform: translateY(0);
        transition: clip-path 0.36s cubic-bezier(0.4, 0, 0.2, 1), transform 0.36s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.27s ease, visibility 0s linear 0s;
      }
      /* More: the top-level items that do not fit the width */
      body .site-header__nav .site-nav__more {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 260px;
        max-width: min(92vw, 360px);
        max-height: calc(100vh - 160px);
        overflow-y: auto;
        padding: 12px 0;
        background: var(--mega-bg, var(--bg));
        color: var(--mega-link-color, var(--text));
        border: 1px solid var(--line);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
        z-index: 1000;
        text-align: left;
        white-space: normal;
        box-sizing: border-box;
      }
      body .site-header__nav .site-nav__more-group {
        padding: 6px 20px 10px;
      }
      body .site-header__nav .site-nav__more-link {
        display: block;
        padding: 6px 0;
        font-size: var(--mega-heading-size, 15px);
        font-weight: 700;
        color: var(--mega-heading-color, var(--accent));
        text-decoration: none;
        opacity: 1;
      }
      body .site-header__nav .site-nav__more-title {
        margin: 8px 0 2px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        opacity: 0.7;
      }
      body .site-header__nav a.site-nav__more-sublink {
        display: block;
        padding: 5px 0 5px 12px;
        font-size: 14px;
        color: var(--mega-link-color, var(--text));
        text-decoration: none;
        opacity: 1;
      }
      body .site-header__nav a.site-nav__more-sublink:hover,
      body .site-header__nav a.site-nav__more-link:hover {
        color: var(--mega-top-hover, var(--mega-heading-color, var(--accent)));
      }
    }
    /* Mega menu container. The panel follows the header colour (--mega-bg is set on the header from
       the "Mega menu background" or the header colour); headings, links and spacing come from the --mega-* variables. */
    body .site-header__nav .mega-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      background: var(--mega-bg, var(--bg));
      color: var(--mega-link-color, var(--text));
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
      z-index: 1000;
      text-align: left;
      box-sizing: border-box;
      overflow-x: clip;
    }
    body .site-header__nav .mega-menu__inner {
      display: flex;
      gap: 32px;
      padding-top: 28px;
      padding-bottom: 32px;
      align-items: flex-start;
      justify-content: space-between;
      box-sizing: border-box;
      /* no max-width of its own: the .page-width class sets it, so the panel is as wide as the header and the columns line up with the logo */
      width: 100%;
    }
    body .site-header__nav .mega-menu__main {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding-left: var(--mega-pad-left, 0px);
      box-sizing: border-box;
      max-width: 100%;
    }
    body .site-header__nav .mega-menu__columns {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 32px var(--mega-gap, 80px);
      box-sizing: border-box;
      max-width: 100%;
    }
    body .site-header__nav .mega-menu__column {
      min-width: 150px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    body .site-header__nav .mega-menu__column-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    /* A column heading is text, never a link: the column's link is "Shop All" at the end of the column */
    body .site-header__nav .mega-menu__column-title {
      display: flex;
      align-items: center;
      font-size: var(--mega-heading-size, 15px);
      font-weight: 700;
      line-height: 1.3;
      color: var(--mega-heading-color, var(--accent));
      text-transform: none;
      letter-spacing: normal;
      opacity: 1;
      border-radius: 0;
      padding: 0;
      margin: 0;
      text-decoration: none;
    }
    body .site-header__nav .mega-menu__sublinks {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    body .site-header__nav .mega-menu__sublink-item {
      margin: 0;
      padding: 0;
    }
    body .site-header__nav a.mega-menu__sublink {
      display: inline-flex;
      align-items: center;
      min-height: var(--mega-row, 38px);
      font-size: var(--mega-link-size, 17px);
      font-weight: 400;
      color: var(--mega-link-color, var(--text));
      text-decoration: none;
      text-transform: none;
      letter-spacing: normal;
      opacity: 1;
      padding: 0;
      border-radius: 0;
      background: transparent;
      transition: color 0.15s ease, opacity 0.15s ease, transform 0.15s ease;
    }
    body .site-header__nav a.mega-menu__sublink:hover {
      color: var(--mega-heading-color, var(--accent));
      opacity: 1;
      transform: translateX(2px);
      background: transparent;
    }
