{%- comment -%}
  Sign in / Create account: the styles shared by the auth blocks (auth-header, auth-login-form, auth-register-form,
  auth-links, auth-script). Plain on purpose. Colors follow the theme: --accent, --bg, --text.
{%- endcomment -%}
<style>
  .auth-page { --auth-accent: var(--accent, #222); --auth-text: var(--text, #222); --auth-bg: var(--bg, #fff);
    --auth-line: color-mix(in srgb, var(--auth-text) 22%, var(--auth-bg)); --auth-muted: color-mix(in srgb, var(--auth-text) 60%, var(--auth-bg));
    display: flex; justify-content: center; padding: 48px 16px 64px; color: var(--auth-text); }
  .auth-page *, .auth-page *::before, .auth-page *::after { box-sizing: border-box; }
  .auth-page .page-width { width: 100%; padding: 0; }
  .auth-page .customer-auth { width: 100%; max-width: 420px; margin: 0 auto; }
  .auth-page .customer-card { padding: 28px; border: 1px solid var(--auth-line); border-radius: 4px; background: transparent; font-size: 15px; line-height: 1.5; }
  .auth-page .auth-tabs { display: flex; gap: 20px; margin-bottom: 20px; border-bottom: 1px solid var(--auth-line); }
  .auth-page .auth-tabs a { padding: 8px 0; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--auth-muted); text-decoration: none; }
  .auth-page .auth-tabs a.is-active { border-bottom-color: var(--auth-accent); color: var(--auth-text); }
  .auth-page .auth-heading { margin-bottom: 20px; }
  .auth-page .auth-heading__title { margin: 0 0 4px; font-size: 26px; line-height: 1.2; font-weight: 600; color: var(--auth-text); text-transform: none; letter-spacing: normal; }
  .auth-page .auth-heading__text { margin: 0; font-size: 14px; color: var(--auth-muted); }
  .auth-page .auth-alert { margin: 0 0 16px; padding: 10px 12px; border: 1px solid; border-radius: 4px; font-size: 14px; }
  .auth-page .auth-alert--error { color: #c62828; border-color: #c62828; }
  .auth-page .auth-alert--success { color: #2e7d32; border-color: #2e7d32; }
  .auth-page .auth-form { display: grid; gap: 14px; margin: 0; }
  .auth-page .auth-field { display: grid; gap: 4px; min-width: 0; }
  .auth-page .auth-label { font-size: 14px; }
  .auth-page .auth-optional { color: var(--auth-muted); }
  .auth-page .auth-input { display: block; width: 100%; height: 42px; padding: 0 12px; border: 1px solid var(--auth-line); border-radius: 4px; background: var(--auth-bg); color: var(--auth-text); font: inherit; box-shadow: none; }
  .auth-page .auth-input:focus { outline: none; border-color: var(--auth-accent); }
  .auth-page .auth-field.has-error .auth-input { border-color: #c62828; }
  .auth-page .auth-error { margin: 0; font-size: 13px; color: #c62828; }
  .auth-page .auth-error[hidden] { display: none; }
  .auth-page .auth-password { position: relative; }
  .auth-page .auth-password .auth-input { padding-right: 44px; }
  .auth-page .auth-password__toggle { position: absolute; top: 0; right: 0; bottom: 0; display: inline-flex; align-items: center; justify-content: center; width: 42px; padding: 0; border: 0; background: none; color: var(--auth-muted); cursor: pointer; }
  .auth-page .auth-password__toggle:hover { color: var(--auth-text); }
  .auth-page .auth-check { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; }
  .auth-page .auth-check input { flex: none; margin: 0; accent-color: var(--auth-accent); }
  .auth-page .auth-check a { color: var(--auth-accent); }
  .auth-page .auth-submit { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; padding: 0 16px; border: 1px solid var(--auth-accent); border-radius: 4px; background: var(--auth-accent); color: var(--auth-bg); font: inherit; cursor: pointer; }
  .auth-page .auth-submit:hover { opacity: .85; }
  .auth-page .auth-submit:disabled { opacity: .5; cursor: default; }
  .auth-page .auth-submit:focus-visible, .auth-page .auth-tabs a:focus-visible, .auth-page .auth-links a:focus-visible, .auth-page .auth-password__toggle:focus-visible, .auth-page .auth-input:focus-visible { outline: 2px solid var(--auth-accent); outline-offset: 2px; }
  .auth-page .auth-links { margin-top: 20px; font-size: 14px; color: var(--auth-muted); }
  .auth-page .auth-links p { margin: 0 0 6px; }
  .auth-page .auth-links a { color: var(--auth-accent); }
  @media (max-width: 520px) { .auth-page { padding: 24px 16px 40px; } .auth-page .customer-card { padding: 20px; } }
</style>
