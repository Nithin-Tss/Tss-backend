{%- assign s = section.settings -%}
<section id="section-{{ section.id }}"
  class="section product-list card-hover--{{ s.card_hover }}{% if s.card_border %} cards--bordered{% endif %}"
  style="--cols: {{ s.columns | default: 5 }}; --cols-mobile: {{ s.columns_mobile }}; --gap: {{ s.gap }}px;{% if s.card_background != blank %} --card-bg: {{ s.card_background }};{% endif %}">
  <div class="page-width">
    {% render 'collection-header', show_image: s.show_image, show_description: s.show_description %}

    {% render 'collection-search', enabled: s.show_search %}

    {%- if collection.total_count == 0 -%}
      <div class="empty-state">{{ s.empty_text | default: 'No products yet.' }}</div>
    {%- else -%}
      {%- assign f = collection.filters -%}
      {% render 'collection-toolbar', filters: f, show_filters: s.show_filters, show_sort: s.show_sort, show_count: s.show_count, section_id: section.id, columns: s.columns %}

      {%- if collection.products_count == 0 -%}
        <div class="empty-state">No products match these filters{% if collection.filters.q != blank %} for &ldquo;{{ collection.filters.q }}&rdquo;{% endif %}. <a href="{{ collection.url }}">Clear {% if collection.filters.q != blank %}search{% else %}filters{% endif %}</a></div>
      {%- endif -%}
      <div class="product-list__grid">
        {%- if section.cart_icon -%}{% render 'cart', mode: 'script' %}{%- endif -%}
        {%- if section.wishlist_heart -%}{% render 'wishlist', with_script: true %}{%- endif -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, wishlist_ids: wishlist_ids, show_wishlist: section.wishlist_heart, show_cart_icon: section.cart_icon, return_url: return_url, show_vendor: s.show_vendor, show_price: s.show_price, show_rating: s.show_rating, show_tags: s.show_tags, show_add_to_cart: s.show_add_to_cart, ratio: s.image_ratio %}
        {%- endfor -%}
      </div>

      {% render 'collection-pagination', filters: f, section_id: section.id %}
    {%- endif -%}
  </div>
</section>
