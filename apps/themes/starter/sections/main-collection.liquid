{%- assign s = section.settings -%}
<section id="section-{{ section.id }}"
  class="section product-list card-hover--{{ s.card_hover }}{% if s.card_border %} cards--bordered{% endif %}"
  style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}; --gap: {{ s.gap }}px;{% if s.card_background != blank %} --card-bg: {{ s.card_background }};{% endif %}">
  <div class="page-width">
    {%- if s.show_image and collection.image != blank -%}
      <div class="collection-hero">
        <img src="{{ collection.image }}" alt="{{ collection.name }}">
      </div>
    {%- endif -%}
    <h1 class="section-heading">{{ collection.name }}</h1>
    {%- if s.show_description and collection.description != blank -%}
      <div class="collection-description">{{ collection.description }}</div>
    {%- endif -%}
    <style>
      .collection-hero { margin-bottom: 24px; border-radius: var(--radius, 14px); overflow: hidden; aspect-ratio: 3 / 1; background: var(--line); }
      .collection-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .collection-description { max-width: 720px; margin: -12px 0 28px; color: var(--muted); line-height: 1.6; }
      .collection-description > :first-child { margin-top: 0; }
      .collection-description > :last-child { margin-bottom: 0; }
      @media (max-width: 749px) { .collection-hero { aspect-ratio: 2 / 1; } }
    </style>

    {%- if collection.total_count == 0 -%}
      <div class="empty-state">{{ s.empty_text | default: 'No products yet.' }}</div>
    {%- else -%}
      {%- assign f = collection.filters -%}
      {%- assign can_sort = false -%}
      {%- if s.show_sort and collection.total_count > 1 -%}{%- assign can_sort = true -%}{%- endif -%}
      {%- assign can_filter = false -%}
      {%- if s.show_filters != false and collection.total_count > 1 -%}{%- assign can_filter = true -%}{%- endif -%}

      <form action="{{ collection.url }}" method="get" class="collection-filters">
        {%- if can_filter -%}
          <div class="collection-filters__bar">
            <label class="collection-filters__check"><input type="checkbox" name="available" value="1"{% if f.available %} checked{% endif %} onchange="this.form.submit()"> In stock only</label>

            <details class="collection-filters__group">
              <summary>Price{% if f.min_price != blank or f.max_price != blank %} &bull;{% endif %}</summary>
              <div class="collection-filters__panel">
                <label>From <input type="number" name="min_price" min="0" step="any" value="{{ f.min_price }}" placeholder="{{ f.price_floor }}"></label>
                <label>To <input type="number" name="max_price" min="0" step="any" value="{{ f.max_price }}" placeholder="{{ f.price_ceiling }}"></label>
                <button class="button button--outline" type="submit">Apply</button>
              </div>
            </details>

            {%- if f.vendors.size > 1 -%}
              <details class="collection-filters__group">
                <summary>Vendor</summary>
                <div class="collection-filters__panel">
                  {%- for v in f.vendors -%}
                    <label><input type="checkbox" name="vendor" value="{{ v.name }}"{% if v.selected %} checked{% endif %} onchange="this.form.submit()"> {{ v.name }} ({{ v.count }})</label>
                  {%- endfor -%}
                </div>
              </details>
            {%- endif -%}

            {%- if f.tags.size > 0 -%}
              <details class="collection-filters__group">
                <summary>Tag</summary>
                <div class="collection-filters__panel">
                  {%- for t in f.tags -%}
                    <label><input type="checkbox" name="tag" value="{{ t.name }}"{% if t.selected %} checked{% endif %} onchange="this.form.submit()"> {{ t.name }} ({{ t.count }})</label>
                  {%- endfor -%}
                </div>
              </details>
            {%- endif -%}

            {%- if f.active -%}
              <a class="collection-filters__clear" href="{{ collection.url }}?sort={{ collection.sort }}">Clear all</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.show_count or can_sort -%}
          <div class="collection-toolbar">
            {%- if s.show_count -%}
              <p class="product-list__sub" style="margin:0">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
            {%- else -%}
              <span></span>
            {%- endif -%}
            {%- if can_sort -%}
              <div class="field" style="grid-auto-flow:column;align-items:center">
                <label for="sort-{{ section.id }}">Sort by</label>
                <select id="sort-{{ section.id }}" name="sort" onchange="this.form.submit()">
                  <option value="newest"{% if collection.sort == 'newest' %} selected{% endif %}>Newest</option>
                  <option value="price-asc"{% if collection.sort == 'price-asc' %} selected{% endif %}>Price, low to high</option>
                  <option value="price-desc"{% if collection.sort == 'price-desc' %} selected{% endif %}>Price, high to low</option>
                </select>
                <noscript><button class="button button--outline" type="submit">Apply</button></noscript>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if can_filter and can_sort == false -%}<input type="hidden" name="sort" value="{{ collection.sort }}">{%- endif -%}
      </form>
      <style>
        .collection-filters__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-bottom: 16px; }
        .collection-filters__group { position: relative; }
        .collection-filters__group summary { cursor: pointer; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; list-style: none; }
        .collection-filters__group[open] summary { border-color: currentColor; }
        .collection-filters__panel { position: absolute; z-index: 5; top: calc(100% + 6px); left: 0; min-width: 200px; max-height: 280px; overflow: auto; display: grid; gap: 8px; padding: 14px; background: var(--bg, #fff); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.12); }
        .collection-filters__panel input[type=number] { width: 100%; padding: 6px 8px; }
        .collection-filters__panel label, .collection-filters__check { display: flex; align-items: center; gap: 8px; }
        .collection-filters__clear { text-decoration: underline; color: var(--muted); }
      </style>

      {%- if collection.products_count == 0 -%}
        <div class="empty-state">No products match these filters. <a href="{{ collection.url }}">Clear filters</a></div>
      {%- endif -%}
      <div class="product-list__grid">
        {%- if section.cart_icon -%}{% render 'cart', mode: 'script' %}{%- endif -%}
        {%- if section.wishlist_heart -%}{% render 'wishlist', with_script: true %}{%- endif -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, wishlist_ids: wishlist_ids, show_wishlist: section.wishlist_heart, show_cart_icon: section.cart_icon, return_url: return_url, show_vendor: s.show_vendor, show_price: s.show_price, show_rating: s.show_rating, show_tags: s.show_tags, show_add_to_cart: s.show_add_to_cart, ratio: s.image_ratio %}
        {%- endfor -%}
      </div>

      {%- if collection.pages > 1 -%}
        <nav class="pagination" aria-label="Pages">
          {%- if collection.page > 1 -%}
            <a class="button button--outline" href="{{ collection.url }}?{{ f.query | escape }}&amp;page={{ collection.page | minus: 1 }}">Previous</a>
          {%- endif -%}
          <span>Page {{ collection.page }} of {{ collection.pages }}</span>
          {%- if collection.page < collection.pages -%}
            <a class="button button--outline" href="{{ collection.url }}?{{ f.query | escape }}&amp;page={{ collection.page | plus: 1 }}">Next</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
