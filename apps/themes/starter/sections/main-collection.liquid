{%- assign s = section.settings -%}
<section id="section-{{ section.id }}" class="section">
  <div class="page-width">
    <h1 class="section-heading">{{ collection.name }}</h1>

    {%- if collection.products_count == 0 -%}
      <div class="empty-state">No products yet.</div>
    {%- else -%}
      <div class="collection-toolbar">
        <p class="product-list__sub" style="margin:0">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
        <form action="{{ collection.url }}" method="get" class="field" style="grid-auto-flow:column;align-items:center">
          <span>Sort by</span>
          <select name="sort" onchange="this.form.submit()">
            <option value="newest"{% if collection.sort == 'newest' %} selected{% endif %}>Newest</option>
            <option value="price-asc"{% if collection.sort == 'price-asc' %} selected{% endif %}>Price, low to high</option>
            <option value="price-desc"{% if collection.sort == 'price-desc' %} selected{% endif %}>Price, high to low</option>
          </select>
          <noscript><button class="button button--outline" type="submit">Sort</button></noscript>
        </form>
      </div>

      <div class="product-grid product-grid--{{ s.columns }}">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, show_vendor: s.show_vendor %}
        {%- endfor -%}
      </div>

      {%- if collection.pages > 1 -%}
        <nav class="pagination" aria-label="Pages">
          {%- if collection.page > 1 -%}
            <a class="button button--outline" href="{{ collection.url }}?sort={{ collection.sort }}&page={{ collection.page | minus: 1 }}">Previous</a>
          {%- endif -%}
          <span>Page {{ collection.page }} of {{ collection.pages }}</span>
          {%- if collection.page < collection.pages -%}
            <a class="button button--outline" href="{{ collection.url }}?sort={{ collection.sort }}&page={{ collection.page | plus: 1 }}">Next</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
