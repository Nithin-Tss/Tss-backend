{%- comment -%}
  Blog page: the store's posts, with category links and paging.
  `blog` has title, description, categories, articles, articles_count, page, pages, url and all_url.
{%- endcomment -%}
{%- assign s = section.settings -%}
{% render 'article-card', styles: true %}
<section id="section-{{ section.id }}" class="section blog">
  <div class="page-width">
    {%- if s.show_header -%}
      <header class="blog__header">
        <h1 class="section-heading">{{ blog.title }}</h1>
        {%- if blog.description != blank -%}<p class="blog__description">{{ blog.description }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    {%- if s.show_filters and blog.categories.size > 0 -%}
      <nav class="blog__filters" aria-label="Categories">
        <a href="{{ blog.all_url }}" aria-current="page">All</a>
        {%- for category in blog.categories -%}
          <a href="{{ category.url }}"{% if category.active %} aria-current="page"{% endif %}>{{ category.name }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if blog.articles.size == 0 -%}
      <div class="empty-state">No posts yet. Posts you publish will appear here.</div>
    {%- else -%}
      <div class="post-list post-list--{{ s.layout }}{% if s.layout == 'grid' and s.columns == 1 %} post-list--cols-1{% endif %}" style="--cols: {{ s.columns }}">
        {%- for article in blog.articles -%}
          {%- assign size = 'normal' -%}
          {%- if s.layout == 'featured' and forloop.first and blog.page == 1 -%}{%- assign size = 'large' -%}{%- endif -%}
          {% render 'article-card', article: article, size: size, show_image: s.show_image, show_excerpt: s.show_excerpt, show_date: s.show_date, show_author: s.show_author, show_category: s.show_category, show_reading_time: s.show_reading_time, ratio: s.image_ratio, card_style: s.card_style %}
        {%- endfor -%}
      </div>

      {%- if blog.pages > 1 -%}
        <nav class="pagination" aria-label="Pages">
          {%- if blog.page > 1 -%}
            <a class="button button--outline" href="{{ blog.url }}?page={{ blog.page | minus: 1 }}">Newer posts</a>
          {%- endif -%}
          <span>Page {{ blog.page }} of {{ blog.pages }}</span>
          {%- if blog.page < blog.pages -%}
            <a class="button button--outline" href="{{ blog.url }}?page={{ blog.page | plus: 1 }}">Older posts</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
<style>
  .blog__header { margin-bottom: 28px; }
  .blog__description { max-width: 640px; margin: -12px 0 0; color: var(--muted); font-size: 18px; }
  .blog__filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .blog__filters a { padding: 6px 14px; border: 1px solid var(--line); border-radius: 999px; font-size: 14px; text-decoration: none; color: var(--muted); }
  .blog__filters a:hover, .blog__filters a[aria-current="page"] { border-color: var(--text); color: var(--text); }
</style>
