{%- comment -%}
  Product quiz. Each "Question" block is one step with up to four answers. Every answer can
  carry a product tag; at the end shoppers go to the result page filtered by the tags of
  the answers they picked (the collection page's tag filter).
{%- endcomment -%}
{%- assign s = section.settings -%}
<section id="section-{{ section.id }}" class="section quiz align-{{ s.text_alignment }}" data-result-link="{{ s.result_link | link }}">
  <div class="page-width">
    {%- if s.heading != blank -%}<h2 class="section-heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if section.blocks.size == 0 -%}
      {%- if design_mode -%}<p class="quiz__sub">Add "Question" blocks to build the quiz.</p>{%- endif -%}
    {%- else -%}
      <div class="quiz__intro" data-quiz-intro>
        {%- if s.subheading != blank -%}<p class="quiz__sub">{{ s.subheading }}</p>{%- endif -%}
        <button class="button" type="button" data-quiz-start>{{ s.start_label }}</button>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          {%- assign q = block.settings -%}
          <div class="quiz__step" data-quiz-step hidden>
            <p class="quiz__progress">Question {{ forloop.index }} of {{ section.blocks.size }}</p>
            <h3 class="quiz__question">{{ q.question }}</h3>
            <div class="quiz__answers">
              {%- if q.option_1 != blank -%}<button class="quiz__answer" type="button" data-tag="{{ q.tag_1 | escape }}">{{ q.option_1 }}</button>{%- endif -%}
              {%- if q.option_2 != blank -%}<button class="quiz__answer" type="button" data-tag="{{ q.tag_2 | escape }}">{{ q.option_2 }}</button>{%- endif -%}
              {%- if q.option_3 != blank -%}<button class="quiz__answer" type="button" data-tag="{{ q.tag_3 | escape }}">{{ q.option_3 }}</button>{%- endif -%}
              {%- if q.option_4 != blank -%}<button class="quiz__answer" type="button" data-tag="{{ q.tag_4 | escape }}">{{ q.option_4 }}</button>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="quiz__result" data-quiz-result hidden>
        {%- if s.result_heading != blank -%}<h3 class="quiz__question">{{ s.result_heading }}</h3>{%- endif -%}
        {%- if s.result_text != blank -%}<p class="quiz__sub">{{ s.result_text }}</p>{%- endif -%}
        <a class="button" href="{{ s.result_link | link }}" data-quiz-link>{{ s.result_button_label }}</a>
        <button class="quiz__restart" type="button" data-quiz-restart>{{ s.restart_label }}</button>
      </div>
    {%- endif -%}
  </div>
</section>
<style>
  .quiz__sub { margin: 8px 0 20px; color: var(--muted); }
  .quiz__progress { margin: 0 0 6px; font-size: 13px; color: var(--muted); }
  .quiz__question { margin: 0 0 16px; }
  .quiz__answers { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .quiz__answer { min-height: 52px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--text); font: inherit; cursor: pointer; }
  .quiz__answer:hover, .quiz__answer:focus-visible { border-color: var(--accent); background: var(--soft); }
  .quiz__restart { display: block; margin: 14px auto 0; background: none; border: 0; color: var(--muted); font: inherit; text-decoration: underline; cursor: pointer; }
  .quiz.align-left .quiz__restart { margin-left: 0; }
</style>
<script>
  (function () {
    var root = document.getElementById("section-{{ section.id }}");
    var intro = root.querySelector("[data-quiz-intro]");
    if (!intro) return;
    var steps = Array.prototype.slice.call(root.querySelectorAll("[data-quiz-step]"));
    var result = root.querySelector("[data-quiz-result]");
    var link = root.querySelector("[data-quiz-link]");
    var base = root.getAttribute("data-result-link");
    var tags = [];
    var current = -1;

    function show(index) {
      current = index;
      intro.hidden = index !== -1;
      steps.forEach(function (step, i) { step.hidden = i !== index; });
      result.hidden = index !== steps.length;
      if (index === steps.length) {
        var unique = tags.filter(function (tag, i) { return tag && tags.indexOf(tag) === i; });
        var query = unique.map(function (tag) { return "tag=" + encodeURIComponent(tag); }).join("&");
        link.href = query ? base + (base.indexOf("?") === -1 ? "?" : "&") + query : base;
      }
    }

    root.querySelector("[data-quiz-start]").addEventListener("click", function () { tags = []; show(0); });
    root.querySelector("[data-quiz-restart]").addEventListener("click", function () { tags = []; show(-1); });
    steps.forEach(function (step) {
      step.addEventListener("click", function (event) {
        var answer = event.target.closest(".quiz__answer");
        if (!answer) return;
        tags.push(answer.getAttribute("data-tag"));
        show(current + 1);
      });
    });
  })();
</script>
