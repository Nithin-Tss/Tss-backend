{%- comment -%}
  Featured products. Same markup as product-carousel.liquid; "Display as"
  switches between a grid and a scrolling carousel.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign first_count = s["limit"] -%}
{%- comment -%} Pages replace "Load more": every product is drawn, the script shows one page at a time {%- endcomment -%}
{%- if s.pagination and s.layout != 'carousel' -%}{%- assign first_count = 1000 -%}{%- endif -%}
{%- if section.card -%}<style>{{ section.card.css }}</style>{%- endif -%}
{%- if s.layout == 'list' -%}
<style>
  #section-{{ section.id }}.product-list--list .product-list__grid { grid-template-columns: minmax(0, 1fr); }
  #section-{{ section.id }}.product-list--list .product-card { display: grid; grid-template-columns: 110px minmax(0, 1fr); column-gap: 16px; row-gap: 4px; align-content: start; align-items: start; height: auto; }
  #section-{{ section.id }}.product-list--list .product-card > :not(.product-card__media) { grid-column: 2; }
  #section-{{ section.id }}.product-list--list .product-card__media { grid-column: 1; grid-row: 1 / span 12; }
  @media (min-width: 750px) { #section-{{ section.id }}.product-list--list .product-card { grid-template-columns: 180px minmax(0, 1fr); } }
</style>
{%- endif -%}
{%- if s.pagination and s.layout != 'carousel' -%}
<style>
  #section-{{ section.id }} .product-list__pages { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 24px; }
  #section-{{ section.id }} .product-list__page { min-width: 38px; height: 38px; padding: 0 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--text); cursor: pointer; font: inherit; }
  #section-{{ section.id }} .product-list__page[aria-current="page"] { background: var(--text); color: var(--bg); border-color: var(--text); }
  #section-{{ section.id }} .product-list__page:disabled { opacity: .4; cursor: default; }
</style>
{%- endif -%}
<section id="section-{{ section.id }}"
  class="section product-list product-list--{{ s.layout }} card-hover--{{ s.card_hover }}{% if s.card_border %} cards--bordered{% endif %}"
  data-autoplay="{{ s.autoplay }}"
  style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}; --gap: {{ s.gap }}px;{% if s.card_background != blank %} --card-bg: {{ s.card_background }};{% endif %}">
  <div class="page-width">
    <div class="carousel__header">
      <div>
        {%- if s.heading != blank -%}<h2 class="section-heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="product-list__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
      <div class="product-list__actions">
        {%- if s.view_all_label != blank -%}
          <a class="product-list__view-all" href="{{ s.view_all_link | link }}">{{ s.view_all_label }} &rarr;</a>
        {%- endif -%}
        {%- if s.layout == 'carousel' and s.show_arrows and section.products.size > 1 -%}
          <div class="carousel__controls">
            <button class="carousel__btn" type="button" data-dir="-1" aria-label="Scroll left">&#8249;</button>
            <button class="carousel__btn" type="button" data-dir="1" aria-label="Scroll right">&#8250;</button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.products.size == 0 -%}
      <div class="empty-state">{{ s.empty_text | default: 'No products found.' }}</div>
    {%- else -%}
      <div class="{% if s.layout == 'carousel' %}carousel__track product-list__track{% else %}product-list__grid{% endif %}"
        {%- if s.layout == 'carousel' %} tabindex="0" aria-label="{{ s.heading | default: 'Products' }}"{% endif %}>
        {%- if section.cart_icon or section.card.has_cart -%}{% render 'cart', mode: 'script' %}{%- endif -%}
        {%- if section.wishlist_heart or section.card.has_wishlist -%}{% render 'wishlist', with_script: true %}{%- endif -%}
        {%- for product in section.products -%}
          {%- comment -%} "Load more": cards after the first `limit` wait, hidden, for the button {%- endcomment -%}
          {%- if s.load_more and forloop.index > first_count -%}<div data-more style="display:none">{%- endif -%}
          {%- if section.card -%}{% render 'product-card-blocks', product: product, card: section.card, wishlist_ids: wishlist_ids, return_url: return_url %}{%- else -%}{% render 'product-card', product: product, wishlist_ids: wishlist_ids, show_wishlist: section.wishlist_heart, show_cart_icon: section.cart_icon, return_url: return_url, show_vendor: s.show_vendor, show_price: s.show_price, show_rating: s.show_rating, show_tags: s.show_tags, show_add_to_cart: s.show_add_to_cart, ratio: s.image_ratio %}{%- endif -%}
          {%- if s.load_more and forloop.index > first_count -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if s.pagination and s.layout != 'carousel' and section.products.size > s.per_page -%}
        <nav class="product-list__pages" data-pages aria-label="Pages"></nav>
      {%- endif -%}
      {%- if s.load_more and s.layout != 'carousel' and section.products.size > first_count -%}
        <div class="product-list__more">
          <button class="button button--outline" type="button" data-load-more>Load more</button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- if s.pagination and s.layout != 'carousel' and section.products.size > s.per_page -%}
<script>
  (function () {
    var root = document.getElementById("section-{{ section.id }}");
    var nav = root && root.querySelector("[data-pages]");
    var grid = root && root.querySelector(".product-list__grid");
    if (!nav || !grid) return;
    var per = {{ s.per_page }};
    var cards = Array.prototype.slice.call(grid.children).filter(function (el) { return el.classList.contains("product-card-shell"); });
    var pages = Math.ceil(cards.length / per);
    var current = 1;
    function button(label, page, extra) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "product-list__page";
      b.textContent = label;
      b.setAttribute("aria-label", extra || "Page " + label);
      if (page === current && !extra) b.setAttribute("aria-current", "page");
      if (extra && (page < 1 || page > pages)) b.disabled = true;
      b.addEventListener("click", function () { show(page); });
      return b;
    }
    function show(page) {
      current = Math.min(Math.max(page, 1), pages);
      cards.forEach(function (el, i) { el.style.display = Math.floor(i / per) + 1 === current ? "" : "none"; });
      nav.innerHTML = "";
      nav.appendChild(button("‹", current - 1, "Previous page"));
      for (var p = 1; p <= pages; p++) nav.appendChild(button(String(p), p));
      nav.appendChild(button("›", current + 1, "Next page"));
    }
    show(1);
  })();
</script>
{%- endif -%}
{%- if s.load_more and s.layout != 'carousel' and s.pagination != true -%}
<script>
  (function () {
    var root = document.getElementById("section-{{ section.id }}");
    var button = root.querySelector("[data-load-more]");
    if (!button) return;
    button.addEventListener("click", function () {
      var waiting = root.querySelectorAll("[data-more]");
      for (var i = 0; i < waiting.length && i < {{ first_count }}; i++) {
        waiting[i].style.display = "contents";
        waiting[i].removeAttribute("data-more");
      }
      if (waiting.length <= {{ first_count }}) button.parentNode.remove();
    });
  })();
</script>
{%- endif -%}
{%- if s.layout == 'carousel' -%}
<script>
  (function () {
    var root = document.getElementById("section-{{ section.id }}");
    var track = root.querySelector(".carousel__track");
    if (!track) return;

    function step(dir) {
      var card = track.firstElementChild;
      var width = card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0) : track.clientWidth;
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      if (dir > 0 && atEnd) track.scrollTo({ left: 0, behavior: "smooth" });
      else track.scrollBy({ left: dir * width, behavior: "smooth" });
    }

    root.querySelectorAll(".carousel__btn").forEach(function (btn) {
      btn.addEventListener("click", function () { step(Number(btn.dataset.dir)); });
    });

    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (root.dataset.autoplay === "true" && !reduce) {
      var timer = setInterval(function () { step(1); }, 4000);
      root.addEventListener("mouseenter", function () { clearInterval(timer); });
    }
  })();
</script>
{%- endif -%}
