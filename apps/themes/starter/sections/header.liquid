</style>

<script>
    (function () {
      var DESKTOP = '(min-width: 769px)';
      var FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

      function each(list, fn) { Array.prototype.forEach.call(list, fn); }
      function make(tag, className, text) {
        var node = document.createElement(tag);
        if (className) node.className = className;
        if (text) node.textContent = text;
        return node;
      }
      // The text of a link or heading without its badge
      function plain(node) {
        var first = node && node.firstChild;
        return first && first.nodeType === 3 ? first.nodeValue : (node ? node.textContent : '');
      }

      function setup(header) {
        var nav = header.querySelector('.site-header__nav');
        if (!nav || header.getAttribute('data-nav-ready')) return;
        header.setAttribute('data-nav-ready', 'true');

        var query = window.matchMedia(DESKTOP);
        var drawer = header.querySelector('[data-nav-drawer]');
        var backdrop = header.querySelector('[data-nav-backdrop]');
        var burger = header.querySelector('[data-nav-open]');
        var items = Array.prototype.slice.call(nav.querySelectorAll('[data-nav-item]'));
        var tops = Array.prototype.slice.call(nav.querySelectorAll('[data-nav-top]'));
        var more = nav.querySelector('[data-nav-more]');
        var morePanel = more && more.querySelector('[data-nav-more-panel]');
        var drawerOpen = false;
        var scrollState = null;

        function panelOf(item) { return item.querySelector('.mega-menu, [data-nav-more-panel]'); }
        function toggleOf(item) { return item.querySelector('.site-header__disclosure'); }
        function isOpen(item) { return item.classList.contains('is-open'); }

        // Open or close one item: the class, aria-expanded on its buttons, and inert on a closed panel
        function setOpen(item, open) {
          var panel = panelOf(item);
          var buttons = [toggleOf(item), item.querySelector('[data-nav-drill]')];
          if (open) item.classList.add('is-open'); else item.classList.remove('is-open');
          buttons.forEach(function (button) {
            if (button) button.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          if (panel) {
            if (open) panel.removeAttribute('inert'); else panel.setAttribute('inert', '');
          }
          if (!open) item.mode = null;
        }
        function closeAll(except) {
          items.forEach(function (item) { if (item !== except && isOpen(item)) setOpen(item, false); });
        }
        function openItem(item, mode) {
          if (item.leaveTimer) { clearTimeout(item.leaveTimer); item.leaveTimer = null; }
          closeAll(item);
          setOpen(item, true);
          item.mode = mode;
        }

        // ---- Desktop: hover, click on the disclosure button, Esc, click outside
        items.forEach(function (item) {
          var toggle = toggleOf(item);
          var drill = item.querySelector('[data-nav-drill]');
          var back = item.querySelector('[data-nav-back]');
          var panel = panelOf(item);

          item.addEventListener('mouseenter', function () {
            if (!query.matches) return;
            if (item.leaveTimer) { clearTimeout(item.leaveTimer); item.leaveTimer = null; }
            if (!isOpen(item)) openItem(item, 'hover');
          });
          item.addEventListener('mouseleave', function () {
            if (!query.matches || item.mode !== 'hover') return;
            item.leaveTimer = setTimeout(function () {
              if (item.mode === 'hover') setOpen(item, false);
            }, 220);
          });
          item.addEventListener('focusout', function () {
            if (!query.matches) return;
            setTimeout(function () {
              if (!isOpen(item) || item.contains(document.activeElement)) return;
              if (item.mode === 'hover' || item.matches(':hover')) return;
              setOpen(item, false);
            }, 0);
          });
          // Enter and Space press the button, which toggles the panel; Tab then walks the panel's links
          if (toggle) {
            toggle.addEventListener('click', function (event) {
              if (!query.matches) return;
              event.preventDefault();
              if (isOpen(item) && item.mode === 'hover') { item.mode = 'pinned'; return; }
              if (isOpen(item)) setOpen(item, false); else openItem(item, 'pinned');
            });
          }
          if (panel) {
            panel.addEventListener('click', function (event) {
              var link = event.target.closest ? event.target.closest('a') : null;
              var href = link && link.getAttribute('href');
              if (!href || href === '#') return;
              if (query.matches) setOpen(item, false); else closeDrawer(false);
            });
          }

          // ---- Mobile drill-down: a top item opens its own panel, the back arrow returns
          if (drill) {
            drill.addEventListener('click', function () {
              openItem(item, 'drill');
              drawer.classList.add('has-panel');
              var target = back || panel;
              window.requestAnimationFrame(function () { if (target) target.focus(); });
            });
          }
          if (back) {
            back.addEventListener('click', function () {
              setOpen(item, false);
              drawer.classList.remove('has-panel');
              if (drill) drill.focus();
            });
          }
        });

        document.addEventListener('pointerdown', function (event) {
          if (!query.matches) return;
          items.forEach(function (item) {
            if (isOpen(item) && !item.contains(event.target)) setOpen(item, false);
          });
        });

        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape' && event.key !== 'Esc') return;
          if (drawerOpen) { event.preventDefault(); closeDrawer(true); return; }
          var current = items.filter(isOpen)[0];
          if (!current) return;
          var focused = current.contains(document.activeElement);
          setOpen(current, false);
          var toggle = toggleOf(current);
          if (focused && toggle) toggle.focus();
        });

        // ---- Mobile drawer: backdrop, scroll lock, focus trap
        function lockScroll(on) {
          var html = document.documentElement;
          var body = document.body;
          if (on) {
            scrollState = [html.style.overflow, body.style.overflow];
            html.style.overflow = 'hidden';
            body.style.overflow = 'hidden';
          } else if (scrollState) {
            html.style.overflow = scrollState[0];
            body.style.overflow = scrollState[1];
            scrollState = null;
          }
        }
        function openDrawer() {
          if (!drawer || query.matches || drawerOpen) return;
          drawerOpen = true;
          drawer.classList.add('is-open');
          drawer.setAttribute('role', 'dialog');
          drawer.setAttribute('aria-modal', 'true');
          drawer.setAttribute('aria-label', 'Menu');
          if (backdrop) backdrop.hidden = false;
          if (burger) burger.setAttribute('aria-expanded', 'true');
          lockScroll(true);
          var first = drawer.querySelector('[data-nav-close]');
          window.requestAnimationFrame(function () { if (first) first.focus(); });
        }
        function closeDrawer(restoreFocus) {
          if (!drawerOpen) return;
          drawerOpen = false;
          closeAll(null);
          drawer.classList.remove('is-open');
          drawer.classList.remove('has-panel');
          drawer.removeAttribute('role');
          drawer.removeAttribute('aria-modal');
          drawer.removeAttribute('aria-label');
          if (backdrop) backdrop.hidden = true;
          if (burger) burger.setAttribute('aria-expanded', 'false');
          lockScroll(false);
          if (restoreFocus && burger) burger.focus();
        }
        if (burger) burger.addEventListener('click', function () { if (drawerOpen) closeDrawer(true); else openDrawer(); });
        if (backdrop) backdrop.addEventListener('click', function () { closeDrawer(true); });
        each(header.querySelectorAll('[data-nav-close]'), function (button) {
          button.addEventListener('click', function () { closeDrawer(true); });
        });
        header.addEventListener('keydown', function (event) {
          if (event.key !== 'Tab' || !drawerOpen) return;
          // While a panel is drilled into, Tab stays inside it
          var panel = nav.querySelector('.site-header__item.is-open > .mega-menu');
          var root = panel || drawer;
          var list = Array.prototype.filter.call(root.querySelectorAll(FOCUSABLE), function (node) {
            return !node.closest('[inert]') && !node.hidden && node.getClientRects().length > 0;
          });
          if (!list.length) { event.preventDefault(); return; }
          var first = list[0];
          var last = list[list.length - 1];
          var active = document.activeElement;
          if (!root.contains(active)) { event.preventDefault(); first.focus(); }
          else if (event.shiftKey && active === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && active === last) { event.preventDefault(); first.focus(); }
        });

        // Mobile "Accordion" setting: a column heading expands and collapses its links
        each(nav.querySelectorAll('.mega-menu__col-toggle'), function (button) {
          button.addEventListener('click', function () {
            var column = button.closest('.mega-menu__column');
            if (!column) return;
            var open = !column.classList.contains('is-col-open');
            if (open) column.classList.add('is-col-open'); else column.classList.remove('is-col-open');
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        });

        // ---- Desktop: items that do not fit the width move into "More"
        function fillMore(list) {
          list.forEach(function (top) {
            var href = top.getAttribute('data-nav-href');
            var group = make('div', 'site-nav__more-group');
            var head = make(href ? 'a' : 'span', 'site-nav__more-link', top.getAttribute('data-nav-label') || '');
            if (href) head.setAttribute('href', href);
            group.appendChild(head);
            each(top.querySelectorAll('.mega-menu__column'), function (column) {
              group.appendChild(make('div', 'site-nav__more-title', plain(column.querySelector('.mega-menu__column-title'))));
              each(column.querySelectorAll('.mega-menu__sublink, .mega-menu__shop-all'), function (anchor) {
                var link = make('a', 'site-nav__more-sublink', anchor.className.indexOf('shop-all') > -1 ? anchor.textContent : plain(anchor));
                link.setAttribute('href', anchor.getAttribute('href'));
                group.appendChild(link);
              });
            });
            morePanel.appendChild(group);
          });
        }
        function layout() {
          if (!more || !morePanel) return;
          if (isOpen(more)) setOpen(more, false);
          tops.forEach(function (top) { top.hidden = false; });
          more.hidden = true;
          while (morePanel.firstChild) morePanel.removeChild(morePanel.firstChild);
          if (!query.matches) return;
          function overflows() { return nav.scrollWidth > nav.clientWidth + 1; }
          if (!overflows()) return;
          more.hidden = false;
          var moved = [];
          for (var i = tops.length - 1; i >= 0 && overflows(); i--) {
            tops[i].hidden = true;
            moved.unshift(tops[i]);
          }
          fillMore(moved);
        }
        var frame = null;
        function schedule() {
          if (frame) return;
          frame = window.requestAnimationFrame(function () { frame = null; layout(); });
        }

        function onModeChange() {
          closeAll(null);
          if (drawerOpen) closeDrawer(false);
          lockScroll(false);
          schedule();
        }
        if (query.addEventListener) query.addEventListener('change', onModeChange);
        else if (query.addListener) query.addListener(onModeChange);

        var inner = header.querySelector('.site-header__inner');
        if (window.ResizeObserver && inner) new ResizeObserver(schedule).observe(inner);
        else window.addEventListener('resize', schedule);
        window.addEventListener('load', schedule);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(schedule);
        layout();
      }

      function initMegaMenus() {
        each(document.querySelectorAll('.site-header'), setup);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMegaMenus);
      } else {
        initMegaMenus();
      }
    })();
</script>

{% schema %}
{
  "name": "Header",
  "max_blocks": 12,
  "settings": [
    {"type": "text", "id": "announcement_text", "label": "Announcement text", "default": "", "info": "The first message of the bar above the header. Add Announcement blocks for more messages; with none, the bar is hidden."},
    {"type": "url", "id": "announcement_link", "label": "Announcement link", "default": "", "info": "Optional. Makes the message a link."},
    {"type": "checkbox", "id": "announcement_autoplay", "label": "Rotate the messages automatically", "default": true},
    {"type": "range", "id": "announcement_speed", "label": "Time on each message", "min": 2, "max": 15, "step": 1, "unit": "s", "default": 5},
    {"type": "checkbox", "id": "announcement_arrows", "label": "Show previous and next arrows", "default": true},
    {"type": "color", "id": "announcement_bg", "label": "Announcement colour", "default": "", "info": "None uses the accent colour."},
    {"type": "color", "id": "announcement_color", "label": "Announcement text colour", "default": ""},
    {"type": "range", "id": "announcement_font_size", "label": "Announcement font size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13},
    {"type": "range", "id": "announcement_spacing", "label": "Announcement spacing", "min": 2, "max": 24, "step": 1, "unit": "px", "default": 8, "info": "Space above and below the message."},
    {"type": "color", "id": "announcement_divider_color", "label": "Divider colour", "default": "#D4AF37", "info": "The line under the announcement bar."},
    {"type": "range", "id": "announcement_divider_width", "label": "Divider thickness", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1, "info": "0 hides the line."},
    {"type": "text", "id": "logo_text", "label": "Logo text", "default": "", "info": "Empty uses the store name."},
    {"type": "image", "id": "logo_image", "label": "Logo image", "default": "", "info": "Optional. Shown instead of the logo text."},
    {"type": "range", "id": "logo_height", "label": "Logo image height", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 36},
    {"type": "radio", "id": "layout", "label": "Logo position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Centred"}], "default": "left"},
    {"type": "checkbox", "id": "show_nav", "label": "Show the navigation menu", "default": true},
    {"type": "range", "id": "collections", "label": "Collections in the automatic menu", "min": 0, "max": 8, "step": 1, "default": 4, "info": "Used only when there are no menu links."},
    {"type": "checkbox", "id": "sticky", "label": "Keep the header at the top while scrolling", "default": true},
    {"type": "checkbox", "id": "border", "label": "Line under the header", "default": true},
    {"type": "color", "id": "background", "label": "Header colour", "default": "", "info": "None uses the background colour."},
    {"type": "color", "id": "text_color", "label": "Header text colour", "default": ""},
    {"type": "color", "id": "mega_bg", "label": "Mega menu background", "default": "", "info": "The panel that opens under a menu item with columns (set in Admin > Menus). None uses the header colour."},
    {"type": "color", "id": "mega_heading_color", "label": "Mega menu heading colour", "default": "", "info": "The column headings (plain text). None uses the accent colour."},
    {"type": "range", "id": "mega_heading_size", "label": "Mega menu heading size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 15},
    {"type": "color", "id": "mega_link_color", "label": "Mega menu link colour", "default": "", "info": "None uses the header text colour, else the theme text colour. Make it readable on the panel colour."},
    {"type": "range", "id": "mega_link_size", "label": "Mega menu link size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17},
    {"type": "range", "id": "mega_row_spacing", "label": "Mega menu row spacing", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 38, "info": "The height of each link row."},
