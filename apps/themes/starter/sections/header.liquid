    body .site-header__nav .mega-menu__promo:hover {
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }
    body .site-header__nav .mega-menu__inner > .mega-menu__promo:only-child {
      margin: 0 auto;
      max-width: 320px;
    }
    body .site-header__nav a.mega-menu__promo-link,
    body .site-header__nav div.mega-menu__promo-link {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      text-decoration: none;
      color: inherit;
      border-radius: 0;
      padding: 0;
      opacity: 1;
    }
    body .site-header__nav a.mega-menu__promo-link:hover {
      opacity: 0.98;
    }
    body .site-header__nav .mega-menu__promo-image-wrap {
      width: 100%;
      aspect-ratio: 16 / 10;
      max-height: 155px;
      min-height: 110px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.04);
      display: flex;
      align-items: center;
      justify-content: center;
