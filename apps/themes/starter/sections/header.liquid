    @media (max-width: 768px) {
      body .site-header__inner {
        flex-wrap: wrap;
      }
      body .site-header__nav {
        order: 3;
        flex: 1 0 100%;
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0;
        margin-top: 10px;
        padding-top: 4px;
        border-top: 1px solid var(--line);
        box-sizing: border-box;
      }
      body .site-header__nav .site-header__item,
      body .site-header__nav > a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        min-height: 44px;
        box-sizing: border-box;
        border-bottom: 1px solid var(--line);
