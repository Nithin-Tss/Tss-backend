{%- comment -%}
  Header and navigation, with the announcement banner above it. Its options and menu links are edited in the customizer's
  left sidebar (Header) or here, in the schema at the end of this file: the two stay in step.
  Read values only through section.settings and block.settings.
  {{ section.attrs }} and {{ block.attrs }} let the customizer's Edit mode select the header
  and its links; they are empty on the store. Keep {{ section.attrs }} on the <header> element
  (not on a wrapper), so a sticky header still sticks.
  No menu links: Home, Shop all and the first collections are shown.
  The "Wishlist icon" block shows the heart with the saved count, on the right. It only links to
  the wishlist page: everything the wishlist does is in snippets/wishlist.liquid.
  The "Cart icon" block shows the cart with the number of items. It opens the side drawer or the cart
  page: everything the cart does is in snippets/cart.liquid.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
{%- assign wishlist_blocks = section.blocks | where: 'type', 'wishlist' -%}
{%- assign cart_blocks = section.blocks | where: 'type', 'cart' -%}
{%- assign search_blocks = section.blocks | where: 'type', 'search' -%}
{%- capture header_style -%}
  {% if s.background != blank %}background:{{ s.background }};{% endif %}
  {% if s.text_color != blank %}color:{{ s.text_color }};{% endif %}
{%- endcapture -%}
{%- comment -%}
  Announcement bar: the "Announcement text" setting is the first message and each "Announcement" block
  adds one more. Two or more messages rotate, with previous/next arrows; hovering or focusing the bar
  pauses it. Nothing shows when there are no messages.
{%- endcomment -%}
{%- assign announcement_blocks = section.blocks | where: 'type', 'announcement' -%}
{%- assign announcement_count = announcement_blocks.size -%}
{%- if s.announcement_text != blank -%}{%- assign announcement_count = announcement_count | plus: 1 -%}{%- endif -%}
{%- if announcement_count > 0 -%}
  {%- capture announcement_style -%}
    {% if s.announcement_bg != blank %}background:{{ s.announcement_bg }};{% endif %}
    {% if s.announcement_color != blank %}color:{{ s.announcement_color }};{% endif %}
    font-size:{{ s.announcement_font_size | default: 13 }}px;
    padding-top:{{ s.announcement_spacing | default: 8 }}px;padding-bottom:{{ s.announcement_spacing | default: 8 }}px;
    border-bottom:{{ s.announcement_divider_width | default: 0 }}px solid {{ s.announcement_divider_color | default: '#D4AF37' }} !important;
  {%- endcapture -%}
  {%- assign announcement_rotates = false -%}
  {%- if announcement_count > 1 -%}{%- assign announcement_rotates = true -%}{%- endif -%}
  <div class="announcement announcement-bar" data-announcement-bar
    data-autoplay="{% if announcement_rotates and s.announcement_autoplay %}true{% else %}false{% endif %}"
    data-speed="{{ s.announcement_speed | default: 5 | times: 1000 }}"
    {% if announcement_rotates %}role="region" aria-roledescription="carousel" aria-label="Announcements"{% endif %}
    style="{{ announcement_style | strip }}">
    <div class="page-width announcement-bar__inner">
      {%- if announcement_rotates and s.announcement_arrows -%}
        <button class="announcement-bar__button" type="button" data-announcement-prev aria-label="Previous announcement" aria-controls="announcement-slides-{{ section.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
        </button>
      {%- endif -%}
      <div class="announcement-bar__slides" id="announcement-slides-{{ section.id }}"{% if announcement_rotates %} aria-live="off"{% endif %}>
        {%- assign announcement_index = 0 -%}
        {%- if s.announcement_text != blank -%}
          {%- assign announcement_index = 1 -%}
          <div class="announcement-bar__slide is-active"{% if announcement_rotates %} role="group" aria-roledescription="slide" aria-label="1 of {{ announcement_count }}"{% endif %}>
            {%- if s.announcement_link != blank -%}
              <a class="announcement-bar__link" href="{{ s.announcement_link | link }}">{{ s.announcement_text }}</a>
            {%- else -%}
              <span>{{ s.announcement_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- for block in announcement_blocks -%}
          {%- assign announcement_index = announcement_index | plus: 1 -%}
          <div class="announcement-bar__slide{% if announcement_index == 1 %} is-active{% endif %}"{% if announcement_index != 1 %} hidden{% endif %}{% if announcement_rotates %} role="group" aria-roledescription="slide" aria-label="{{ announcement_index }} of {{ announcement_count }}"{% endif %}{{ block.attrs }}>
            {%- if block.settings.link != blank -%}
              <a class="announcement-bar__link" href="{{ block.settings.link | link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if announcement_rotates and s.announcement_arrows -%}
        <button class="announcement-bar__button" type="button" data-announcement-next aria-label="Next announcement" aria-controls="announcement-slides-{{ section.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      {%- endif -%}
      {%- if announcement_rotates and s.announcement_autoplay -%}
        <button class="announcement-bar__button announcement-bar__pause" type="button" data-announcement-pause aria-label="Pause announcements" aria-pressed="false">
          <svg class="announcement-bar__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><line x1="9" y1="6" x2="9" y2="18" /><line x1="15" y1="6" x2="15" y2="18" /></svg>
          <svg class="announcement-bar__icon-play" viewBox="0 0 24 24" aria-hidden="true"><polygon points="8 5 19 12 8 19 8 5" /></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
  <style>
    .announcement-bar { padding-left: 0; padding-right: 0; line-height: 1.4; }
    .announcement-bar [class*="announcement"] { border: 0 !important; }
    .announcement-bar__inner { display: flex; align-items: center; justify-content: center; gap: 8px; }
    .announcement-bar__slides { flex: 1 1 auto; min-width: 0; text-align: center; overflow-wrap: anywhere; }
    .announcement-bar__slide[hidden] { display: none; }
    .announcement-bar__slide.is-active { animation: announcement-bar-in .35s ease; }
    .announcement-bar__link { color: inherit; text-decoration: none; }
    .announcement-bar__link:hover { text-decoration: underline; }
    .announcement-bar__button { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; opacity: .8; }
    .announcement-bar__button:hover { opacity: 1; }
    .announcement-bar__button:focus-visible, .announcement-bar__link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    .announcement-bar__button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .announcement-bar__pause svg { width: 12px; height: 12px; }
    .announcement-bar__icon-play, .announcement-bar.is-paused .announcement-bar__icon-pause { display: none; }
    .announcement-bar.is-paused .announcement-bar__icon-play { display: block; }
    @keyframes announcement-bar-in { from { opacity: 0; } to { opacity: 1; } }
    @media (max-width: 749px) {
      .announcement-bar__inner { gap: 4px; padding-left: 8px; padding-right: 8px; }
      .announcement-bar__button { width: 32px; height: 32px; }
    }
    @media (prefers-reduced-motion: reduce) { .announcement-bar__slide.is-active { animation: none; } }
  </style>
  <script>
    (function () {
      var bar = document.currentScript && document.currentScript.previousElementSibling;
      while (bar && !bar.hasAttribute('data-announcement-bar')) bar = bar.previousElementSibling;
      if (!bar) return;
      var slides = bar.querySelectorAll('.announcement-bar__slide');
      if (slides.length < 2) return;
      var current = 0, timer = null, hovered = false, focused = false, stopped = false;
      var speed = parseInt(bar.getAttribute('data-speed'), 10) || 5000;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var autoplay = bar.getAttribute('data-autoplay') === 'true' && !reduced;
      var live = bar.querySelector('.announcement-bar__slides');
      var pauseButton = bar.querySelector('[data-announcement-pause]');
      function show(index) {
        slides[current].classList.remove('is-active');
        slides[current].hidden = true;
        current = (index + slides.length) % slides.length;
        slides[current].hidden = false;
        slides[current].classList.add('is-active');
      }
      function stop() { clearInterval(timer); timer = null; }
      function start() {
        stop();
        if (autoplay && !hovered && !focused && !stopped) timer = setInterval(function () { show(current + 1); }, speed);
        // Screen readers hear a message change only when the visitor caused it
        live.setAttribute('aria-live', timer ? 'off' : 'polite');
      }
      function step(by) { show(current + by); start(); }
      var prev = bar.querySelector('[data-announcement-prev]');
      var next = bar.querySelector('[data-announcement-next]');
      if (prev) prev.addEventListener('click', function () { step(-1); });
      if (next) next.addEventListener('click', function () { step(1); });
      if (pauseButton) {
        if (!autoplay) pauseButton.hidden = true;
        pauseButton.addEventListener('click', function () {
          stopped = !stopped;
          bar.classList.toggle('is-paused', stopped);
          pauseButton.setAttribute('aria-pressed', stopped ? 'true' : 'false');
          pauseButton.setAttribute('aria-label', stopped ? 'Play announcements' : 'Pause announcements');
          start();
        });
      }
      bar.addEventListener('mouseenter', function () { hovered = true; start(); });
      bar.addEventListener('mouseleave', function () { hovered = false; start(); });
      bar.addEventListener('focusin', function () { focused = true; start(); });
      bar.addEventListener('focusout', function (e) { if (!bar.contains(e.relatedTarget)) { focused = false; start(); } });
      bar.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
      });
      start();
    })();
  </script>
{%- endif -%}
<header class="site-header"{{ section.attrs }}
  data-sticky="{% if s.sticky %}true{% else %}false{% endif %}"
  data-border="{% if s.border %}true{% else %}false{% endif %}"
  data-layout="{% if s.layout == 'center' %}center{% else %}left{% endif %}"
  style="{{ header_style | strip }}">
  <div class="page-width site-header__inner">
    <a class="site-header__logo" href="{{ shop.url }}/">
      {%- if s.logo_image != blank -%}
        <img src="{{ s.logo_image }}" alt="{{ shop.name }}" style="height: {{ s.logo_height }}px; width: auto;">
      {%- elsif s.logo_text != blank -%}
        {{ s.logo_text }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
    {%- if s.show_nav -%}
      <nav class="site-header__nav" aria-label="Main">
        {%- if link_blocks.size > 0 -%}
          {%- for block in link_blocks -%}
            {%- assign item = nil -%}
            {%- for m in menu_links -%}
              {%- if m.label == block.settings.label -%}
                {%- assign item = m -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign render_mega = false -%}
            {%- if item and item.is_mega -%}
              {%- if item.columns.size > 0 or item.promo -%}
                {%- assign render_mega = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- if render_mega -%}
              <div class="site-header__item site-header__item--mega" data-nav-item{{ block.attrs }}>
                <a class="site-header__link" href="{{ item.url | default: block.settings.url | default: '#' }}" aria-haspopup="true" aria-expanded="false" id="nav-item-{{ forloop.index }}" aria-controls="mega-menu-{{ forloop.index }}">{{ block.settings.label }}{%- if item.badge != blank -%}<span class="menu-badge">{{ item.badge }}</span>{%- endif -%}<svg class="site-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <button class="site-header__mobile-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ block.settings.label | escape }} menu" aria-controls="mega-menu-{{ forloop.index }}">
                  <svg class="site-header__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="mega-menu" id="mega-menu-{{ forloop.index }}" role="region" aria-label="{{ block.settings.label | escape }}">
                  <div class="page-width mega-menu__inner">
                    {%- if item.columns.size > 0 -%}
                      <div class="mega-menu__columns">
                        {%- for col in item.columns -%}
                          <div class="mega-menu__column{% if col.links.size > 0 %} mega-menu__column--has-sublinks{% endif %}">
                            <div class="mega-menu__column-header">
                              {%- if col.url != blank and col.url != '#' -%}
                                <a class="mega-menu__column-title mega-menu__column-title--link" href="{{ col.url }}">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</a>
                              {%- else -%}
                                <div class="mega-menu__column-title">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</div>
                              {%- endif -%}
                              {%- if col.links.size > 0 -%}
                                <button class="mega-menu__col-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ col.label | escape }} sublinks" aria-controls="mega-col-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                                  <svg class="mega-menu__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                              {%- endif -%}
                            </div>
                            {%- if col.links.size > 0 -%}
                              <ul class="mega-menu__sublinks" id="mega-col-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                                {%- for sub in col.links -%}
                                  <li class="mega-menu__sublink-item">
                                    <a class="mega-menu__sublink" href="{{ sub.url | default: '#' }}">{{ sub.label }}{%- if sub.badge != blank -%}<span class="menu-badge">{{ sub.badge }}</span>{%- endif -%}</a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    {%- if item.promo -%}
                      {%- assign show_promo = false -%}
                      {%- if item.promo.image != blank or item.promo.title != blank or item.promo.subtitle != blank -%}
                        {%- assign show_promo = true -%}
                      {%- endif -%}
                      {%- if show_promo -%}
                        <div class="mega-menu__promo">
                          {%- if item.promo.url != blank and item.promo.url != '#' -%}
                            <a class="mega-menu__promo-link" href="{{ item.promo.url }}">
                          {%- else -%}
                            <div class="mega-menu__promo-link">
                          {%- endif -%}
                            {%- if item.promo.image != blank -%}
                              <div class="mega-menu__promo-image-wrap">
                                <img class="mega-menu__promo-image" src="{{ item.promo.image }}" alt="{{ item.promo.title | escape }}" loading="lazy" />
                              </div>
                            {%- endif -%}
                            {%- if item.promo.title != blank or item.promo.subtitle != blank -%}
                              <div class="mega-menu__promo-content">
                                {%- if item.promo.title != blank -%}
                                  <div class="mega-menu__promo-title">{{ item.promo.title }}</div>
                                {%- endif -%}
                                {%- if item.promo.subtitle != blank -%}
                                  <div class="mega-menu__promo-subtitle">{{ item.promo.subtitle }}</div>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- if item.promo.url != blank and item.promo.url != '#' -%}
                            </a>
                          {%- else -%}
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- elsif item and item.has_dropdown -%}
              <div class="site-header__item site-header__item--has-dropdown" data-nav-item{{ block.attrs }}>
                <a class="site-header__link" href="{{ item.url | default: block.settings.url | default: '#' }}" aria-haspopup="true" aria-expanded="false" id="nav-item-dropdown-{{ forloop.index }}" aria-controls="dropdown-{{ forloop.index }}">{{ block.settings.label }}{%- if item.badge != blank -%}<span class="menu-badge">{{ item.badge }}</span>{%- endif -%}<svg class="site-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <button class="site-header__mobile-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ block.settings.label | escape }} submenu" aria-controls="dropdown-{{ forloop.index }}">
                  <svg class="site-header__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="site-nav__dropdown" id="dropdown-{{ forloop.index }}" role="menu">
                  <ul class="site-nav__dropdown-list">
                    {%- for col in item.columns -%}
                      <li class="site-nav__dropdown-item{% if col.links.size > 0 %} site-nav__dropdown-item--has-sub{% endif %}" role="none">
                        <div class="site-nav__dropdown-header">
                          <a class="site-nav__dropdown-link" href="{{ col.url | default: '#' }}" role="menuitem">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</a>
                          {%- if col.links.size > 0 -%}
                            <button class="site-nav__dropdown-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ col.label | escape }} sublinks" aria-controls="dropdown-sub-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                              <svg class="site-nav__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                          {%- endif -%}
                        </div>
                        {%- if col.links.size > 0 -%}
                          <ul class="site-nav__subdropdown-list" id="dropdown-sub-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                            {%- for sub in col.links -%}
                              <li class="site-nav__subdropdown-item">
                                <a class="site-nav__subdropdown-link" href="{{ sub.url | default: '#' }}">{{ sub.label }}{%- if sub.badge != blank -%}<span class="menu-badge">{{ sub.badge }}</span>{%- endif -%}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- elsif item and item.badge != blank -%}
              <a href="{{ block.settings.url | default: '#' }}"{{ block.attrs }}>{{ block.settings.label }}<span class="menu-badge">{{ item.badge }}</span></a>
            {%- else -%}
              <a href="{{ block.settings.url | default: '#' }}"{{ block.attrs }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif menu_links.size > 0 -%}
          {%- for item in menu_links -%}
            {%- assign render_mega = false -%}
            {%- if item.is_mega -%}
              {%- if item.columns.size > 0 or item.promo -%}
                {%- assign render_mega = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- if render_mega -%}
              <div class="site-header__item site-header__item--mega" data-nav-item>
                <a class="site-header__link" href="{{ item.url | default: '#' }}" aria-haspopup="true" aria-expanded="false" id="nav-item-sec-{{ forloop.index }}" aria-controls="mega-menu-sec-{{ forloop.index }}">{{ item.label }}{%- if item.badge != blank -%}<span class="menu-badge">{{ item.badge }}</span>{%- endif -%}<svg class="site-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <button class="site-header__mobile-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ item.label | escape }} menu" aria-controls="mega-menu-sec-{{ forloop.index }}">
                  <svg class="site-header__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="mega-menu" id="mega-menu-sec-{{ forloop.index }}" role="region" aria-label="{{ item.label | escape }}">
                  <div class="page-width mega-menu__inner">
                    {%- if item.columns.size > 0 -%}
                      <div class="mega-menu__columns">
                        {%- for col in item.columns -%}
                          <div class="mega-menu__column{% if col.links.size > 0 %} mega-menu__column--has-sublinks{% endif %}">
                            <div class="mega-menu__column-header">
                              {%- if col.url != blank and col.url != '#' -%}
                                <a class="mega-menu__column-title mega-menu__column-title--link" href="{{ col.url }}">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</a>
                              {%- else -%}
                                <div class="mega-menu__column-title">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</div>
                              {%- endif -%}
                              {%- if col.links.size > 0 -%}
                                <button class="mega-menu__col-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ col.label | escape }} sublinks" aria-controls="mega-col-sec-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                                  <svg class="mega-menu__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                              {%- endif -%}
                            </div>
                            {%- if col.links.size > 0 -%}
                              <ul class="mega-menu__sublinks" id="mega-col-sec-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                                {%- for sub in col.links -%}
                                  <li class="mega-menu__sublink-item">
                                    <a class="mega-menu__sublink" href="{{ sub.url | default: '#' }}">{{ sub.label }}{%- if sub.badge != blank -%}<span class="menu-badge">{{ sub.badge }}</span>{%- endif -%}</a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    {%- if item.promo -%}
                      {%- assign show_promo = false -%}
                      {%- if item.promo.image != blank or item.promo.title != blank or item.promo.subtitle != blank -%}
                        {%- assign show_promo = true -%}
                      {%- endif -%}
                      {%- if show_promo -%}
                        <div class="mega-menu__promo">
                          {%- if item.promo.url != blank and item.promo.url != '#' -%}
                            <a class="mega-menu__promo-link" href="{{ item.promo.url }}">
                          {%- else -%}
                            <div class="mega-menu__promo-link">
                          {%- endif -%}
                            {%- if item.promo.image != blank -%}
                              <div class="mega-menu__promo-image-wrap">
                                <img class="mega-menu__promo-image" src="{{ item.promo.image }}" alt="{{ item.promo.title | escape }}" loading="lazy" />
                              </div>
                            {%- endif -%}
                            {%- if item.promo.title != blank or item.promo.subtitle != blank -%}
                              <div class="mega-menu__promo-content">
                                {%- if item.promo.title != blank -%}
                                  <div class="mega-menu__promo-title">{{ item.promo.title }}</div>
                                {%- endif -%}
                                {%- if item.promo.subtitle != blank -%}
                                  <div class="mega-menu__promo-subtitle">{{ item.promo.subtitle }}</div>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- if item.promo.url != blank and item.promo.url != '#' -%}
                            </a>
                          {%- else -%}
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- elsif item.has_dropdown -%}
              <div class="site-header__item site-header__item--has-dropdown" data-nav-item>
                <a class="site-header__link" href="{{ item.url | default: '#' }}" aria-haspopup="true" aria-expanded="false" id="nav-item-dropdown-sec-{{ forloop.index }}" aria-controls="dropdown-sec-{{ forloop.index }}">{{ item.label }}{%- if item.badge != blank -%}<span class="menu-badge">{{ item.badge }}</span>{%- endif -%}<svg class="site-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <button class="site-header__mobile-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ item.label | escape }} submenu" aria-controls="dropdown-sec-{{ forloop.index }}">
                  <svg class="site-header__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="site-nav__dropdown" id="dropdown-sec-{{ forloop.index }}" role="menu">
                  <ul class="site-nav__dropdown-list">
                    {%- for col in item.columns -%}
                      <li class="site-nav__dropdown-item{% if col.links.size > 0 %} site-nav__dropdown-item--has-sub{% endif %}" role="none">
                        <div class="site-nav__dropdown-header">
                          <a class="site-nav__dropdown-link" href="{{ col.url | default: '#' }}" role="menuitem">{{ col.label }}{%- if col.badge != blank -%}<span class="menu-badge">{{ col.badge }}</span>{%- endif -%}</a>
                          {%- if col.links.size > 0 -%}
                            <button class="site-nav__dropdown-toggle" type="button" aria-expanded="false" aria-label="Toggle {{ col.label | escape }} sublinks" aria-controls="dropdown-sub-sec-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                              <svg class="site-nav__toggle-icon" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                          {%- endif -%}
                        </div>
                        {%- if col.links.size > 0 -%}
                          <ul class="site-nav__subdropdown-list" id="dropdown-sub-sec-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                            {%- for sub in col.links -%}
                              <li class="site-nav__subdropdown-item">
                                <a class="site-nav__subdropdown-link" href="{{ sub.url | default: '#' }}">{{ sub.label }}{%- if sub.badge != blank -%}<span class="menu-badge">{{ sub.badge }}</span>{%- endif -%}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- elsif item.badge != blank -%}
              <a href="{{ item.url }}">{{ item.label }}<span class="menu-badge">{{ item.badge }}</span></a>
            {%- else -%}
              <a href="{{ item.url }}">{{ item.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <a href="{{ shop.url }}/">Home</a>
          <a href="{{ shop.url }}/collections/all">Shop all</a>
          {%- for collection in collections limit: s.collections -%}
            <a href="{{ collection.url }}">{{ collection.name }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>
    {%- endif -%}
    {%- assign has_actions = false -%}
    {%- if s.show_account != false or wishlist_blocks.size > 0 or cart_blocks.size > 0 or search_blocks.size > 0 -%}{%- assign has_actions = true -%}{%- endif -%}
    {%- if has_actions -%}
      <div class="site-header__actions">
        {%- if s.show_account != false -%}
          <style>.site-header__account:hover { background: transparent; opacity: 1; }</style>
          {%- if customer_logged_in -%}
            <a class="site-header__account" href="{{ shop.url }}/account/" aria-label="Account" title="Account">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><circle cx="12" cy="10" r="3" /><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" />
              </svg>
            </a>
          {%- else -%}
            <a class="site-header__account" href="{{ shop.url }}/account/login" aria-label="Sign in or create account" title="Sign in or create account">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><circle cx="12" cy="10" r="3" /><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" />
              </svg>
            </a>
          {%- endif -%}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'search' -%}
            <div class="site-header__search-block" data-header-search{{ block.attrs }}>
              <button class="site-header__search" type="button" aria-label="{{ block.settings.label | default: 'Search' | escape }}" title="{{ block.settings.label | default: 'Search' | escape }}" aria-expanded="false" aria-controls="header-search-{{ section.id }}-{{ forloop.index }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
              </button>
              <form class="site-header__search-panel" id="header-search-{{ section.id }}-{{ forloop.index }}" action="{{ shop.url }}/collections/all" method="get" role="search" hidden>
                <input class="site-header__search-input" id="header-search-input-{{ section.id }}-{{ forloop.index }}" type="search" name="q" aria-label="{{ block.settings.label | default: 'Search' | escape }}" placeholder="{{ block.settings.placeholder | default: 'Search products' | escape }}" autocomplete="off">
                <button class="site-header__search-submit" type="submit">Search</button>
              </form>
              <script>
                (function () {
                  var root = document.currentScript && document.currentScript.closest('[data-header-search]');
                  if (!root) return;
                  var toggle = root.querySelector('.site-header__search');
                  var panel = root.querySelector('.site-header__search-panel');
                  var input = root.querySelector('.site-header__search-input');
                  function positionPanel() {
                    var rootRect = root.getBoundingClientRect();
                    var iconRect = toggle.getBoundingClientRect();
                    var width = panel.getBoundingClientRect().width || panel.offsetWidth;
                    var desiredLeft = iconRect.right - width;
                    var left = Math.max(12, Math.min(desiredLeft, window.innerWidth - width - 12));
                    if (left !== desiredLeft) {
                      panel.style.left = (left - rootRect.left) + 'px';
                      panel.style.right = 'auto';
                    } else {
                      panel.style.left = 'auto';
                      panel.style.right = '0';
                    }
                  }
                  function close(restoreFocus) {
                    panel.hidden = true;
                    toggle.setAttribute('aria-expanded', 'false');
                    if (restoreFocus) toggle.focus();
                  }
                  toggle.addEventListener('click', function () {
                    var opening = panel.hidden;
                    panel.hidden = !opening;
                    toggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
                    if (opening) window.requestAnimationFrame(function () { positionPanel(); input.focus(); });
                  });
                  window.addEventListener('resize', function () { if (!panel.hidden) positionPanel(); });
                  window.addEventListener('scroll', function () { if (!panel.hidden) positionPanel(); }, true);
                  document.addEventListener('click', function (event) {
                    if (!root.contains(event.target) && !panel.hidden) close(false);
                  });
                  document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && !panel.hidden && root.contains(document.activeElement)) {
                      close(true);
                    }
                  });
                })();
              </script>
            </div>
          {%- elsif block.type == 'wishlist' -%}
            {% render 'wishlist', mode: 'icon', count: wishlist_count, label: block.settings.label, show_count: block.settings.show_count, attrs: block.attrs %}
          {%- elsif block.type == 'cart' -%}
            {% render 'cart', mode: 'icon', count: cart_count, session: cart_session, settings: block.settings, attrs: block.attrs %}
          {%- elsif block.type == 'profile' -%}
            <a class="site-header__profile" href="{{ block.settings.url | default: '/account' }}"{{ block.attrs }}><img src="{{ block.settings.image }}" alt="" width="{{ block.settings.size }}"></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</header>

<style>
    body .site-header {
      position: sticky;
      z-index: 1000;
    }
    body .site-header:has(.mega-menu) {
      overflow: visible;
    }
    body .site-header__inner:has(.mega-menu) {
      overflow: visible;
    }
    body .site-header__nav .site-header__item {
      position: relative;
      display: inline-flex;
      align-items: center;
    }
    body .site-header__nav .site-header__chevron {
      width: 9px;
      height: 6px;
      margin-left: 6px;
      transition: transform 0.2s ease;
      pointer-events: none;
      opacity: 0.7;
    }
    body .site-header__nav .site-header__item:hover .site-header__chevron,
    body .site-header__nav .site-header__item.is-open .site-header__chevron,
    body .site-header__nav .site-header__item:focus-within .site-header__chevron {
      transform: rotate(180deg);
    }
    body .site-header__nav .menu-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 700;
      line-height: 1;
      padding: 2px 7px;
      border-radius: 999px;
      background: var(--accent);
      color: var(--bg);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-left: 6px;
      vertical-align: middle;
    }
    /* Accessible focus states */
    body .site-header__nav a:focus-visible,
    body .site-header__nav button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    /* Desktop navigation styles */
    @media (min-width: 769px) {
      body .site-header__nav {
        display: flex;
        align-items: stretch;
      }
      body .site-header__nav .site-header__item {
        display: inline-flex;
        align-items: center;
        align-self: stretch;
        min-height: 48px;
      }
      body .site-header__nav .site-header__link {
        display: inline-flex;
        align-items: center;
        height: 100%;
      }
      body .site-header__nav .site-header__mobile-toggle,
      body .site-header__nav .mega-menu__col-toggle,
      body .site-header__nav .site-nav__dropdown-toggle {
        display: none !important;
      }
      /* Hover bridge to prevent dead zones between trigger and menu */
      body .site-header__nav .site-nav__dropdown::before,
      body .site-header__nav .mega-menu::before {
        content: "";
        position: absolute;
        top: -24px;
        left: 0;
        right: 0;
        height: 24px;
      }
    }
    /* Standard dropdown */
    body .site-header__nav .site-nav__dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 220px;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--line);
      border-radius: 8px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.14);
      padding: 8px 0;
      z-index: 1000;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.18s ease, transform 0.18s ease;
      transform: translateY(8px);
      text-align: left;
    }
    body .site-header__nav .site-header__item--has-dropdown:hover .site-nav__dropdown,
    body .site-header__nav .site-header__item--has-dropdown.is-open .site-nav__dropdown,
    body .site-header__nav .site-header__item--has-dropdown:focus-within .site-nav__dropdown {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }
    body .site-header__nav .site-nav__dropdown-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    body .site-header__nav .site-nav__dropdown-item {
      position: relative;
      margin: 0;
      padding: 0;
    }
    body .site-header__nav a.site-nav__dropdown-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 18px;
      font-size: 13px;
      font-weight: 500;
      text-transform: none;
      letter-spacing: normal;
      color: var(--text);
      opacity: 0.85;
      border-radius: 0;
      transition: background 0.15s ease, color 0.15s ease, opacity 0.15s ease;
    }
    body .site-header__nav a.site-nav__dropdown-link:hover {
      background: var(--soft);
      color: var(--accent);
      opacity: 1;
    }
    body .site-header__nav .site-nav__subdropdown-list {
      list-style: none;
      margin: 4px 0 6px 18px;
      padding: 0 0 0 12px;
      border-left: 2px solid var(--line);
    }
    body .site-header__nav .site-nav__subdropdown-item {
      margin: 0;
      padding: 0;
    }
    body .site-header__nav a.site-nav__subdropdown-link {
      display: flex;
      align-items: center;
      padding: 4px 8px;
      font-size: 12px;
      font-weight: 400;
      text-transform: none;
      letter-spacing: normal;
      color: var(--muted);
      opacity: 0.8;
      border-radius: 0;
      transition: color 0.15s ease, opacity 0.15s ease;
    }
    body .site-header__nav a.site-nav__subdropdown-link:hover {
      color: var(--text);
      opacity: 1;
    }
    /* Mega menu container */
    body .site-header__nav .site-header__item--mega {
      position: static;
    }
    body .site-header__nav .mega-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      background: var(--bg);
      color: var(--text);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
      z-index: 1000;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
      transform: translateY(8px);
      text-align: left;
