      }
      body .site-header__nav .mega-menu__column.is-col-open .mega-menu__toggle-icon {
        transform: rotate(180deg);
      }
      body .site-header[data-mobile-accordion="true"] .mega-menu__column--has-sublinks:not(.is-col-open) .mega-menu__sublinks,
      body .site-header__nav a.mega-menu__shop-all {
