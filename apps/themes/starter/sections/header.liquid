{%- comment -%}
  Header and navigation. Its options and menu links are edited in the customizer's
  left sidebar (Header) or here, in the schema at the end of this file: the two stay in step.
  Read values only through section.settings and block.settings.
  {{ section.attrs }} and {{ block.attrs }} let the customizer's Edit mode select the header
  and its links; they are empty on the store. Keep {{ section.attrs }} on the <header> element
  (not on a wrapper), so a sticky header still sticks.
  No menu links: Home, Shop all and the first collections are shown.
  The "Wishlist icon" block shows the heart with the saved count, on the right. It only links to
  the wishlist page: everything the wishlist does is in snippets/wishlist.liquid.
  The "Cart icon" block shows the cart with the number of items. It opens the side drawer or the cart
  page: everything the cart does is in snippets/cart.liquid.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
{%- assign wishlist_blocks = section.blocks | where: 'type', 'wishlist' -%}
{%- assign cart_blocks = section.blocks | where: 'type', 'cart' -%}
{%- capture header_style -%}
  {% if s.background != blank %}background:{{ s.background }};{% endif %}
  {% if s.text_color != blank %}color:{{ s.text_color }};{% endif %}
{%- endcapture -%}
<header class="site-header"{{ section.attrs }}
  data-sticky="{% if s.sticky %}true{% else %}false{% endif %}"
  data-border="{% if s.border %}true{% else %}false{% endif %}"
  data-layout="{% if s.layout == 'center' %}center{% else %}left{% endif %}"
  style="{{ header_style | strip }}">
  <div class="page-width site-header__inner">
    <a class="site-header__logo" href="{{ shop.url }}/">
      {%- if s.logo_image != blank -%}
        <img src="{{ s.logo_image }}" alt="{{ shop.name }}" style="height: {{ s.logo_height }}px; width: auto;">
      {%- elsif s.logo_text != blank -%}
        {{ s.logo_text }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
    {%- if s.show_nav -%}
      <nav class="site-header__nav" aria-label="Main">
        {%- if link_blocks.size > 0 -%}
          {%- for block in link_blocks -%}
            <a href="{{ block.settings.url | default: '#' }}"{{ block.attrs }}>{{ block.settings.label }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ shop.url }}/">Home</a>
          <a href="{{ shop.url }}/collections/all">Shop all</a>
          {%- for collection in collections limit: s.collections -%}
            <a href="{{ collection.url }}">{{ collection.name }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>
    {%- endif -%}
    {%- if wishlist_blocks.size > 0 or cart_blocks.size > 0 -%}
      <div class="site-header__actions">
        {%- for block in section.blocks -%}
          {%- if block.type == 'wishlist' -%}
            {% render 'wishlist', mode: 'icon', count: wishlist_count, label: block.settings.label, show_count: block.settings.show_count, attrs: block.attrs %}
          {%- elsif block.type == 'cart' -%}
            {% render 'cart', mode: 'icon', count: cart_count, session: cart_session, settings: block.settings, attrs: block.attrs %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "max_blocks": 12,
  "settings": [
    {"type": "text", "id": "logo_text", "label": "Logo text", "default": "", "info": "Empty uses the store name."},
    {"type": "image", "id": "logo_image", "label": "Logo image", "default": "", "info": "Optional. Shown instead of the logo text."},
    {"type": "range", "id": "logo_height", "label": "Logo image height", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 36},
    {"type": "radio", "id": "layout", "label": "Logo position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Centred"}], "default": "left"},
    {"type": "checkbox", "id": "show_nav", "label": "Show the navigation menu", "default": true},
    {"type": "range", "id": "collections", "label": "Collections in the automatic menu", "min": 0, "max": 8, "step": 1, "default": 4, "info": "Used only when there are no menu links."},
    {"type": "checkbox", "id": "sticky", "label": "Keep the header at the top while scrolling", "default": true},
    {"type": "checkbox", "id": "border", "label": "Line under the header", "default": true},
    {"type": "color", "id": "background", "label": "Header colour", "default": "", "info": "None uses the background colour."},
    {"type": "color", "id": "text_color", "label": "Header text colour", "default": ""}
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu link",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "New link"},
        {"type": "url", "id": "url", "label": "Link", "default": "/collections/all", "info": "A page of your store (/collections/all) or a full web address."}
      ]
    },
    {
      "type": "wishlist",
      "name": "Wishlist icon",
      "settings": [
        {"type": "text", "id": "label", "label": "Label (for screen readers)", "default": "Wishlist"},
        {"type": "checkbox", "id": "show_count", "label": "Show the number of saved products", "default": true}
      ]
    },
    {
      "type": "cart",
      "name": "Cart icon",
      "settings": [
        {"type": "text", "id": "label", "label": "Label (for screen readers)", "default": "Cart"},
        {"type": "checkbox", "id": "show_count", "label": "Show the number of items", "default": true},
        {"type": "radio", "id": "opens", "label": "Clicking the icon opens", "options": [{"value": "drawer", "label": "Side drawer"}, {"value": "page", "label": "Cart page"}], "default": "drawer"},
        {"type": "range", "id": "size", "label": "Icon size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 24},
        {"type": "text", "id": "drawer_title", "label": "Drawer title", "default": "Cart"},
        {"type": "text", "id": "checkout_label", "label": "Checkout button text", "default": "Check out"},
        {"type": "url", "id": "checkout_url", "label": "Checkout button link", "default": "", "info": "Where \"Check out\" goes. Empty shows \"Checkout is coming soon\"."},
        {"type": "text", "id": "empty_message", "label": "Empty cart message", "default": "Your cart is empty"},
        {"type": "checkbox", "id": "show_discount", "label": "Show the discount row", "default": true},
        {"type": "checkbox", "id": "show_login", "label": "Show \"Have an account? Log in\" in the empty cart", "default": false},
        {"type": "url", "id": "login_url", "label": "Log in link", "default": "/account"}
      ]
    }
  ],
  "default": {"blocks": [{"type": "wishlist", "settings": {"label": "Wishlist", "show_count": true}}, {"type": "cart", "settings": {}}]}
}
{% endschema %}
