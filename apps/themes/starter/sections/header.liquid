      }
      body .site-header__nav .site-header__mobile-toggle {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: transparent;
        border: 0;
        color: inherit;
        cursor: pointer;
        opacity: 0.8;
        padding: 0;
        margin-left: auto;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      body .site-header__nav .site-header__mobile-toggle:hover {
        opacity: 1;
      }
      body .site-header__nav .site-header__mobile-toggle svg {
        width: 11px;
        height: 7px;
        transition: transform 0.2s ease;
      }
      body .site-header__nav .site-header__item.is-open .site-header__mobile-toggle svg {
        transform: rotate(180deg);
      }
      /* Accordion Panel */
      body .site-header__nav .mega-menu,
      body .site-header__nav .site-nav__dropdown {
        position: static;
        width: 100%;
        max-width: 100%;
        box-shadow: none;
        border: 0;
        border-radius: 0;
        transform: none;
        transition: none;
        opacity: 1;
        visibility: visible;
        display: none;
        padding: 0 0 12px 14px;
        box-sizing: border-box;
      }
      body .site-header__nav .site-header__item.is-open > .mega-menu,
      body .site-header__nav .site-header__item.is-open > .site-nav__dropdown {
        display: block;
      }
      body .site-header__nav .mega-menu__inner {
        flex-direction: column;
        gap: 16px;
        padding: 8px 0;
        box-sizing: border-box;
      }
      body .site-header__nav .mega-menu__columns {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
      }
      body .site-header__nav .mega-menu__column {
        width: 100%;
        border-bottom: 1px dashed var(--line);
        padding-bottom: 8px;
        box-sizing: border-box;
      }
      body .site-header__nav .mega-menu__column:last-child {
        border-bottom: none;
      }
      body .site-header__nav .mega-menu__column-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 40px;
        width: 100%;
        margin-bottom: 0;
        cursor: pointer;
      }
      body .site-header__nav .mega-menu__column-title,
      body .site-header__nav a.mega-menu__column-title {
        flex: 1 1 auto;
        min-height: 40px;
        margin-bottom: 0;
        display: flex;
        align-items: center;
      }
      body .site-header__nav .mega-menu__col-toggle {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: transparent;
        border: 0;
        color: inherit;
        cursor: pointer;
        opacity: 0.7;
        padding: 0;
        transition: transform 0.2s ease;
      }
      body .site-header__nav .mega-menu__col-toggle svg {
        width: 10px;
        height: 6px;
        transition: transform 0.2s ease;
      }
      body .site-header__nav .mega-menu__column.is-col-open .mega-menu__col-toggle svg {
        transform: rotate(180deg);
      }
      body .site-header__nav .mega-menu__column--has-sublinks .mega-menu__sublinks {
        display: none;
        padding-left: 14px;
        padding-top: 4px;
        padding-bottom: 8px;
        gap: 6px;
      }
      body .site-header__nav .mega-menu__column.is-col-open .mega-menu__sublinks {
        display: flex;
      }
      body .site-header__nav a.mega-menu__sublink {
        min-height: 38px;
        display: flex;
        align-items: center;
        padding: 6px 0;
        font-size: 14px;
      }
      body .site-header__nav .mega-menu__promo {
        width: 100%;
        max-width: 100%;
        margin: 16px 0 8px;
        align-self: stretch;
        box-sizing: border-box;
      }
      body .site-header__nav .mega-menu__promo-image-wrap {
        aspect-ratio: 16 / 9;
        height: auto;
        max-height: 140px;
      }
      /* Standard dropdown on mobile */
      body .site-header__nav .site-nav__dropdown-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 40px;
        width: 100%;
        cursor: pointer;
      }
      body .site-header__nav .site-nav__dropdown-link {
        flex: 1 1 auto;
        min-height: 40px;
        padding: 8px 0;
      }
      body .site-header__nav .site-nav__dropdown-toggle {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: transparent;
        border: 0;
        color: inherit;
        cursor: pointer;
        opacity: 0.7;
      }
      body .site-header__nav .site-nav__dropdown-toggle svg {
        width: 10px;
        height: 6px;
        transition: transform 0.2s ease;
      }
      body .site-header__nav .site-nav__dropdown-item.is-sub-open .site-nav__dropdown-toggle svg {
        transform: rotate(180deg);
      }
      body .site-header__nav .site-nav__dropdown-item--has-sub .site-nav__subdropdown-list {
        display: none;
        padding-left: 14px;
      }
      body .site-header__nav .site-nav__dropdown-item.is-sub-open .site-nav__subdropdown-list {
        display: block;
      }
    }
  </style>

  <script>
    (function () {
      function initMegaMenus() {
        var headers = document.querySelectorAll('.site-header');
        headers.forEach(function (header) {
          var navItems = header.querySelectorAll('[data-nav-item]');
          navItems.forEach(function (item) {
            var trigger = item.querySelector('.site-header__link');
            var mobileToggle = item.querySelector('.site-header__mobile-toggle');
            var panel = item.querySelector('.mega-menu, .site-nav__dropdown');
            if (!panel) return;

            var leaveTimer = null;

            function openItem() {
              if (leaveTimer) {
                clearTimeout(leaveTimer);
                leaveTimer = null;
              }
              navItems.forEach(function (other) {
                if (other !== item && other.classList.contains('is-open')) {
                  other.classList.remove('is-open');
                  var ot = other.querySelector('.site-header__link');
                  if (ot) ot.setAttribute('aria-expanded', 'false');
                  var omt = other.querySelector('.site-header__mobile-toggle');
                  if (omt) omt.setAttribute('aria-expanded', 'false');
                }
              });
              item.classList.add('is-open');
              if (trigger) trigger.setAttribute('aria-expanded', 'true');
              if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'true');

              if (panel.classList.contains('site-nav__dropdown')) {
                var rect = panel.getBoundingClientRect();
                var docWidth = window.innerWidth || document.documentElement.clientWidth;
                if (rect.right > docWidth - 10) {
                  panel.style.left = 'auto';
                  panel.style.right = '0';
                } else {
                  panel.style.left = '';
                  panel.style.right = '';
                }
              }
            }

            function closeItem(restoreFocus) {
              if (leaveTimer) {
                clearTimeout(leaveTimer);
                leaveTimer = null;
              }
              item.classList.remove('is-open');
              if (trigger) trigger.setAttribute('aria-expanded', 'false');
              if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'false');
              if (restoreFocus && trigger) {
                trigger.focus();
              }
            }

            // Desktop hover with debounce
            item.addEventListener('mouseenter', function () {
              if (window.matchMedia('(min-width: 769px)').matches) {
                openItem();
              }
            });

            item.addEventListener('mouseleave', function () {
              if (window.matchMedia('(min-width: 769px)').matches) {
                leaveTimer = setTimeout(function () {
                  closeItem(false);
                }, 280);
              }
            });

            // Focus management
            item.addEventListener('focusin', function () {
              if (window.matchMedia('(min-width: 769px)').matches) {
                openItem();
              }
            });

            item.addEventListener('focusout', function () {
              setTimeout(function () {
                if (!item.contains(document.activeElement)) {
                  closeItem(false);
                }
              }, 15);
            });

            // Trigger link interaction
            if (trigger) {
              trigger.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown' || e.key === ' ' || e.key === 'Enter') {
                  if (!item.classList.contains('is-open')) {
                    e.preventDefault();
                    openItem();
                    var firstInteractive = panel.querySelector('a, button');
                    if (firstInteractive) {
                      firstInteractive.focus();
                    }
                  }
                }
              });

              trigger.addEventListener('click', function (e) {
                var href = trigger.getAttribute('href');
                var isDummy = !href || href === '#' || href === 'javascript:void(0)';
                var isMobile = window.matchMedia('(max-width: 768px)').matches;

                if (isMobile) {
                  if (isDummy) {
                    e.preventDefault();
                    if (item.classList.contains('is-open')) {
                      closeItem(false);
                    } else {
                      openItem();
                    }
                  } else {
                    if (!item.classList.contains('is-open')) {
                      e.preventDefault();
                      openItem();
                    }
                  }
                } else {
                  if (isDummy) {
                    e.preventDefault();
                    if (item.classList.contains('is-open')) {
                      closeItem(false);
                    } else {
                      openItem();
                    }
                  } else {
                    if (!item.classList.contains('is-open')) {
                      e.preventDefault();
                      openItem();
                    }
                  }
                }
              });
            }

            // Mobile toggle button
            if (mobileToggle) {
              mobileToggle.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (item.classList.contains('is-open')) {
                  closeItem(false);
                } else {
                  openItem();
                }
              });
            }

            // Escape key closes menu and restores focus
            item.addEventListener('keydown', function (e) {
              if (e.key === 'Escape') {
                if (item.classList.contains('is-open')) {
                  e.preventDefault();
                  e.stopPropagation();
                  closeItem(true);
                }
              }
            });

            // Sublinks navigation closes menu
            panel.addEventListener('click', function (e) {
              var link = e.target.closest('a');
              if (link && link.getAttribute('href') && link.getAttribute('href') !== '#') {
                closeItem(false);
              }
            });

            // Column sublinks accordion (Level 2 -> Level 3)
            var colToggles = panel.querySelectorAll('.mega-menu__col-toggle');
            colToggles.forEach(function (btn) {
              btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var col = btn.closest('.mega-menu__column');
                if (!col) return;
                var isColOpen = col.classList.toggle('is-col-open');
                btn.setAttribute('aria-expanded', isColOpen ? 'true' : 'false');
              });
            });

            // Header title click on mobile to toggle sublinks if heading has no custom link
            var colHeaders = panel.querySelectorAll('.mega-menu__column-header');
            colHeaders.forEach(function (hdr) {
              hdr.addEventListener('click', function (e) {
                if (e.target.closest('.mega-menu__col-toggle')) return;
                var link = e.target.closest('a');
                var href = link ? link.getAttribute('href') : null;
                var isDummy = !href || href === '#' || href === 'javascript:void(0)';
                if (!link || isDummy) {
                  if (window.matchMedia('(max-width: 768px)').matches) {
                    var col = hdr.closest('.mega-menu__column');
                    if (col && col.classList.contains('mega-menu__column--has-sublinks')) {
                      var isColOpen = col.classList.toggle('is-col-open');
                      var btn = col.querySelector('.mega-menu__col-toggle');
                      if (btn) btn.setAttribute('aria-expanded', isColOpen ? 'true' : 'false');
                    }
                  }
                }
              });
            });

            // Standard dropdown item accordion
            var dropToggles = panel.querySelectorAll('.site-nav__dropdown-toggle');
            dropToggles.forEach(function (btn) {
              btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var dropItem = btn.closest('.site-nav__dropdown-item');
                if (!dropItem) return;
                var isSubOpen = dropItem.classList.toggle('is-sub-open');
                btn.setAttribute('aria-expanded', isSubOpen ? 'true' : 'false');
              });
            });

            var dropHeaders = panel.querySelectorAll('.site-nav__dropdown-header');
            dropHeaders.forEach(function (hdr) {
              hdr.addEventListener('click', function (e) {
                if (e.target.closest('.site-nav__dropdown-toggle')) return;
                var link = e.target.closest('a');
                var href = link ? link.getAttribute('href') : null;
                var isDummy = !href || href === '#' || href === 'javascript:void(0)';
                if (!link || isDummy) {
                  if (window.matchMedia('(max-width: 768px)').matches) {
                    var dropItem = hdr.closest('.site-nav__dropdown-item');
                    if (dropItem && dropItem.classList.contains('site-nav__dropdown-item--has-sub')) {
                      var isSubOpen = dropItem.classList.toggle('is-sub-open');
                      var btn = dropItem.querySelector('.site-nav__dropdown-toggle');
                      if (btn) btn.setAttribute('aria-expanded', isSubOpen ? 'true' : 'false');
                    }
                  }
                }
              });
            });
          });

          // Document click outside closes open menus
          document.addEventListener('pointerdown', function (e) {
            navItems.forEach(function (item) {
              if (item.classList.contains('is-open') && !item.contains(e.target)) {
                item.classList.remove('is-open');
                var t = item.querySelector('.site-header__link');
                if (t) t.setAttribute('aria-expanded', 'false');
                var mt = item.querySelector('.site-header__mobile-toggle');
                if (mt) mt.setAttribute('aria-expanded', 'false');
              }
            });
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMegaMenus);
      } else {
        initMegaMenus();
      }
    })();
  </script>

{% schema %}
{
  "name": "Header",
  "max_blocks": 12,
  "settings": [
    {"type": "text", "id": "announcement_text", "label": "Announcement text", "default": "", "info": "The first message of the bar above the header. Add Announcement blocks for more messages; with none, the bar is hidden."},
    {"type": "url", "id": "announcement_link", "label": "Announcement link", "default": "", "info": "Optional. Makes the message a link."},
    {"type": "checkbox", "id": "announcement_autoplay", "label": "Rotate the messages automatically", "default": true},
    {"type": "range", "id": "announcement_speed", "label": "Time on each message", "min": 2, "max": 15, "step": 1, "unit": "s", "default": 5},
    {"type": "checkbox", "id": "announcement_arrows", "label": "Show previous and next arrows", "default": true},
    {"type": "color", "id": "announcement_bg", "label": "Announcement colour", "default": "", "info": "None uses the accent colour."},
    {"type": "color", "id": "announcement_color", "label": "Announcement text colour", "default": ""},
    {"type": "range", "id": "announcement_font_size", "label": "Announcement font size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13},
    {"type": "range", "id": "announcement_spacing", "label": "Announcement spacing", "min": 2, "max": 24, "step": 1, "unit": "px", "default": 8, "info": "Space above and below the message."},
    {"type": "color", "id": "announcement_divider_color", "label": "Divider colour", "default": "#D4AF37", "info": "The line under the announcement bar."},
    {"type": "range", "id": "announcement_divider_width", "label": "Divider thickness", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1, "info": "0 hides the line."},
    {"type": "text", "id": "logo_text", "label": "Logo text", "default": "", "info": "Empty uses the store name."},
    {"type": "image", "id": "logo_image", "label": "Logo image", "default": "", "info": "Optional. Shown instead of the logo text."},
    {"type": "range", "id": "logo_height", "label": "Logo image height", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 36},
    {"type": "radio", "id": "layout", "label": "Logo position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Centred"}], "default": "left"},
    {"type": "checkbox", "id": "show_nav", "label": "Show the navigation menu", "default": true},
    {"type": "range", "id": "collections", "label": "Collections in the automatic menu", "min": 0, "max": 8, "step": 1, "default": 4, "info": "Used only when there are no menu links."},
    {"type": "checkbox", "id": "sticky", "label": "Keep the header at the top while scrolling", "default": true},
    {"type": "checkbox", "id": "border", "label": "Line under the header", "default": true},
    {"type": "color", "id": "background", "label": "Header colour", "default": "", "info": "None uses the background colour."},
    {"type": "color", "id": "text_color", "label": "Header text colour", "default": ""}
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {"type": "text", "id": "text", "label": "Text", "default": "Free shipping on all orders"},
        {"type": "url", "id": "link", "label": "Link", "default": "", "info": "Optional. Makes the message a link."}
      ]
    },
    {
      "type": "link",
      "name": "Menu link",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "New link"},
        {"type": "url", "id": "url", "label": "Link", "default": "/collections/all", "info": "A page of your store (/collections/all) or a full web address."}
      ]
    },
    {
      "type": "search",
      "name": "Search",
      "settings": [
        {"type": "text", "id": "label", "label": "Label (for screen readers)", "default": "Search"},
        {"type": "text", "id": "placeholder", "label": "Search field placeholder", "default": "Search products"}
      ]
    },
    {
      "type": "wishlist",
      "name": "Wishlist icon",
      "settings": [
        {"type": "text", "id": "label", "label": "Label (for screen readers)", "default": "Wishlist"},
        {"type": "checkbox", "id": "show_count", "label": "Show the number of saved products", "default": true}
      ]
    },
    {
      "type": "cart",
      "name": "Cart icon",
      "settings": [
        {"type": "text", "id": "label", "label": "Label (for screen readers)", "default": "Cart"},
        {"type": "checkbox", "id": "show_count", "label": "Show the number of items", "default": true},
        {"type": "radio", "id": "opens", "label": "Clicking the icon opens", "options": [{"value": "drawer", "label": "Side drawer"}, {"value": "page", "label": "Cart page"}], "default": "drawer"},
        {"type": "range", "id": "size", "label": "Icon size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 24},
        {"type": "text", "id": "drawer_title", "label": "Drawer title", "default": "Cart"},
        {"type": "text", "id": "checkout_label", "label": "Checkout button text", "default": "Check out"},
        {"type": "url", "id": "checkout_url", "label": "Checkout button link", "default": "", "info": "Where \"Check out\" goes. Empty shows \"Checkout is coming soon\"."},
        {"type": "text", "id": "empty_message", "label": "Empty cart message", "default": "Your cart is empty"},
        {"type": "checkbox", "id": "show_discount", "label": "Show the discount row", "default": true},
        {"type": "checkbox", "id": "show_login", "label": "Show \"Have an account? Log in\" in the empty cart", "default": false},
        {"type": "url", "id": "login_url", "label": "Log in link", "default": "/account"}
      ]
    }
  ],
  "default": {"blocks": [{"type": "search", "settings": {"label": "Search", "placeholder": "Search products"}}, {"type": "wishlist", "settings": {"label": "Wishlist", "show_count": true}}, {"type": "cart", "settings": {}}]}
}
{% endschema %}
