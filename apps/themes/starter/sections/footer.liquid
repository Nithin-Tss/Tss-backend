{%- comment -%}
  Footer. Its options and blocks are edited in the customizer's left sidebar
  (Footer) or here, in the schema at the end of this file: the two stay in step.
  Read values only through section.settings and block.settings.
  {{ block.attrs }} lets the customizer's Edit mode select a block; it is empty on the store.
  Blocks: logo (Logo and text), links (Menu column), social (Social links), text, newsletter, payment.
  A Menu column takes its links from a menu in Admin > Menus when "Links come from" says so.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign year = 'now' | date: '%Y' -%}
{%- capture heading_style -%}
  {% if s.heading_color != blank %}color:{{ s.heading_color }};{% endif %}
  {% if s.heading_size and s.heading_size != 0 %}font-size:{{ s.heading_size }}px;{% endif %}
  {% if s.heading_case == 'uppercase' or s.heading_case == 'capitalize' %}text-transform:{{ s.heading_case }};{% endif %}
  {% if s.heading_spacing and s.heading_spacing != 0 %}letter-spacing:{{ s.heading_spacing }}px;{% endif %}
{%- endcapture -%}
{%- capture heading_attr -%}{% if heading_style contains ':' %} style="{{ heading_style | strip }}"{% endif %}{%- endcapture -%}
{%- capture link_style -%}
  {% if s.link_color != blank %}color:{{ s.link_color }};{% endif %}
  {% if s.link_size and s.link_size != 0 %}font-size:{{ s.link_size }}px;{% endif %}
{%- endcapture -%}
{%- capture link_attr -%}{% if link_style contains ':' %} style="{{ link_style | strip }}"{% endif %}{%- endcapture -%}
{%- capture footer_style -%}
  {% if s.background != blank %}background:{{ s.background }};{% endif %}
  {% if s.text_color != blank %}color:{{ s.text_color }};{% endif %}
  {% if s.link_hover_color != blank %}--sf-hover:{{ s.link_hover_color }};{% endif %}
  {% if s.divider_color != blank %}--sf-divider:{{ s.divider_color }};{% endif %}
  {% if s.padding_top and s.padding_top != 0 %}padding-top:{{ s.padding_top }}px;{% endif %}
  {% if s.padding_bottom and s.padding_bottom != 0 %}padding-bottom:{{ s.padding_bottom }}px;{% endif %}
  {% if s.text_align == 'center' or s.text_align == 'right' %}text-align:{{ s.text_align }};{% endif %}
{%- endcapture -%}
{%- capture top_style -%}
  {% if s.max_width and s.max_width != 0 %}max-width:{{ s.max_width }}px;margin-left:auto;margin-right:auto;{% endif %}
  {% if s.column_gap and s.column_gap != 0 %}gap:{{ s.column_gap }}px;{% endif %}
  --sf-cols:{{ section.blocks.size | minus: 1 }};
{%- endcapture -%}
{%- assign first_block = section.blocks | first -%}
{%- assign wide_first = false -%}
{%- if s.layout != 'equal' and section.blocks.size > 1 and section.blocks.size < 7 -%}
  {%- if first_block.type == 'logo' or first_block.type == 'text' -%}{%- assign wide_first = true -%}{%- endif -%}
{%- endif -%}
<footer class="site-footer" data-hover="{% if s.link_hover_color != blank %}true{% else %}false{% endif %}" data-mobile-align="{{ s.mobile_align | default: 'same' }}" data-accordion="{% if s.accordion_mobile == false %}false{% else %}true{% endif %}" style="{{ footer_style | strip }}">
  {%- if section.blocks.size > 0 -%}
    <div class="page-width site-footer__top" data-wide-first="{{ wide_first }}" style="{{ top_style | strip }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- case block.type -%}
          {%- when 'logo' -%}
            <div class="site-footer__brand site-footer__logo-row"{{ block.attrs }}>
              <a class="site-footer__logo" href="{{ shop.url }}/">
                {%- if b.image != blank -%}
                  <img src="{{ b.image }}" alt="{{ shop.name }}" style="height: {{ b.height }}px; width: auto;">
                {%- elsif b.text != blank -%}
                  {{ b.text }}
                {%- else -%}
                  {{ shop.name }}
                {%- endif -%}
              </a>
              {%- if b.description != blank -%}<p>{{ b.description }}</p>{%- endif -%}
            </div>
          {%- when 'text' -%}
            <div class="site-footer__about"{{ block.attrs }}>
              {%- if b.image != blank -%}
                <div class="site-footer__icon">
                  <img src="{{ b.image }}" alt="{{ b.heading | default: shop.name | escape }}" loading="lazy">
                </div>
              {%- endif -%}
              {%- if b.heading != blank -%}<h2 class="site-footer__heading"{{ heading_attr }}>{{ b.heading }}</h2>{%- endif -%}
              {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
            </div>
          {%- when 'links' -%}
            {%- if b.source == 'menu' -%}
              {%- assign column_links = b.menu_ref -%}
            {%- else -%}
              {%- assign column_links = b.menu -%}
            {%- endif -%}
            <nav class="site-footer__nav site-footer__col" aria-label="{{ b.heading | default: 'Footer' }}"{% if b.heading != blank %} data-footer-col{% endif %}{{ block.attrs }}>
              {%- if b.image != blank -%}
                <div class="site-footer__icon">
                  <img src="{{ b.image }}" alt="{{ b.heading | default: shop.name | escape }}" loading="lazy">
                </div>
              {%- endif -%}
              {%- if b.heading != blank -%}<h2 class="site-footer__heading"{{ heading_attr }}>{{ b.heading }}</h2>{%- endif -%}
              <div class="site-footer__panel" id="footer-panel-{{ forloop.index }}">
                {%- for link in column_links -%}
                  <a href="{{ link.url }}"{{ link_attr }}>{{ link.label }}</a>
                {%- endfor -%}
              </div>
            </nav>
          {%- when 'social' -%}
            <div class="site-footer__social-block"{{ block.attrs }}>
              {%- if b.heading != blank -%}<h2 class="site-footer__heading"{{ heading_attr }}>{{ b.heading }}</h2>{%- endif -%}
              {%- capture social_style -%}
                --sf-icon:{{ b.size }}px;
                {% if b.color != blank %}--sf-icon-color:{{ b.color }};{% elsif s.social_color != blank %}--sf-icon-color:{{ s.social_color }};{% endif %}
                {% if b.background != blank %}--sf-icon-bg:{{ b.background }};{% endif %}
                {% if b.border_color != blank %}--sf-icon-border:{{ b.border_color }};{% endif %}
              {%- endcapture -%}
              <ul class="site-footer__social" aria-label="Social links" data-shape="{{ b.shape }}" data-border="{{ b.border }}" style="{{ social_style | strip }}">
                {%- for icon in b.icons -%}
                  <li><a href="{{ icon.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ icon.label }}" title="{{ icon.label }}">
                    {%- if icon.icon != blank -%}<img src="{{ icon.icon }}" alt="" loading="lazy">{%- else -%}{{ icon.svg }}{%- endif -%}
                  </a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <form class="site-footer__newsletter" onsubmit="event.preventDefault(); this.querySelector('p').textContent = 'Thanks! Sign-ups are coming soon.';"{{ block.attrs }}>
              {%- if b.heading != blank -%}<h2 class="site-footer__heading"{{ heading_attr }}>{{ b.heading }}</h2>{%- endif -%}
              {%- if b.text != blank -%}<span>{{ b.text }}</span>{%- endif -%}
              <div class="site-footer__signup">
                <input type="email" name="email" placeholder="Email address" aria-label="Email address" required>
                <button class="button" type="submit">{{ b.button_label | default: 'Subscribe' }}</button>
              </div>
              <p role="status"></p>
            </form>
          {%- when 'payment' -%}
            <div class="site-footer__payment-block"{{ block.attrs }}>
              {%- if b.heading != blank -%}<h2 class="site-footer__heading"{{ heading_attr }}>{{ b.heading }}</h2>{%- endif -%}
              <ul class="site-footer__payments" aria-label="Payment methods">
                {%- assign methods = b.methods | split: ',' -%}
                {%- for method in methods -%}
                  {%- assign method_name = method | strip -%}
                  {%- if method_name != blank -%}<li>{{ method_name }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- assign show_policies = false -%}
  {%- if s.policy_privacy or s.policy_refund or s.policy_shipping or s.policy_terms -%}{%- assign show_policies = true -%}{%- endif -%}
  {%- if s.show_copyright != false or show_policies -%}
  <div class="page-width site-footer__legal">
    <div class="site-footer__legal-inner">
      {%- if s.show_copyright != false -%}
        <span class="site-footer__copyright">
          {%- if s.copyright != blank -%}
            {{ s.copyright | replace: '{year}', year | replace: '{store}', shop.name }}
          {%- else -%}
            &copy; {{ year }} {{ shop.name }}
          {%- endif -%}
        </span>
      {%- endif -%}
      {%- if show_policies -%}
        <nav class="site-footer__policies" aria-label="Store policies">
          {%- if s.policy_privacy -%}<a href="{{ shop.url }}/pages/privacy-policy"{{ link_attr }}>Privacy Policy</a>{%- endif -%}
          {%- if s.policy_refund -%}<a href="{{ shop.url }}/pages/refund-policy"{{ link_attr }}>Refund Policy</a>{%- endif -%}
          {%- if s.policy_shipping -%}<a href="{{ shop.url }}/pages/shipping-policy"{{ link_attr }}>Shipping Policy</a>{%- endif -%}
          {%- if s.policy_terms -%}<a href="{{ shop.url }}/pages/terms-of-service"{{ link_attr }}>Terms of Service</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
  {%- if s.utility_show -%}
    {%- capture utility_style -%}
      {% if s.utility_bg != blank %}background:{{ s.utility_bg }};{% endif %}
      {% if s.utility_color != blank %}color:{{ s.utility_color }};{% endif %}
      {% if s.utility_size and s.utility_size != 0 %}font-size:{{ s.utility_size }}px;{% endif %}
      {% if s.utility_case == 'uppercase' or s.utility_case == 'capitalize' %}text-transform:{{ s.utility_case }};{% endif %}
      {% if s.utility_divider == false %}border-top:0;{% elsif s.utility_divider_color != blank %}border-top-color:{{ s.utility_divider_color }};{% endif %}
    {%- endcapture -%}
    {%- capture utility_pad -%}
      {% if s.utility_padding and s.utility_padding != 0 %}padding-top:{{ s.utility_padding }}px;padding-bottom:{{ s.utility_padding }}px;{% endif %}
    {%- endcapture -%}
    <div class="site-footer__utility" style="{{ utility_style | strip }}">
      <div class="page-width site-footer__utility-inner"{% if utility_pad contains ':' %} style="{{ utility_pad | strip }}"{% endif %}>
        <span>{{ s.utility_left }}</span>
        <nav aria-label="Contact">
          {%- if s.utility_phone != blank -%}
            <a href="tel:{{ s.utility_phone | replace: ' ', '' }}">{{ s.utility_phone }}</a>
          {%- endif -%}
          {%- if s.utility_email != blank -%}
            <a href="mailto:{{ s.utility_email }}">{{ s.utility_email }}</a>
          {%- endif -%}
          {%- if s.utility_show_links != false -%}
            {%- for link in s.utility_menu -%}
              <a href="{{ link.url }}">{{ link.label }}</a>
            {%- endfor -%}
          {%- endif -%}
          {%- if s.utility_show_social -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'social' -%}
                {%- for icon in block.settings.icons -%}
                  <a href="{{ icon.url }}" target="_blank" rel="noopener noreferrer">{{ icon.label }}</a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </nav>
      </div>
    </div>
  {%- endif -%}
</footer>
{%- if s.accordion_mobile != false -%}
<script>
  (function () {
    var query = window.matchMedia('(max-width: 640px)');
    var chevron = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>';
    document.querySelectorAll('footer.site-footer[data-accordion="true"]').forEach(function (footer) {
      if (footer.sfReady) return;
      footer.sfReady = true;
      function build(column) {
        var heading = column.querySelector('.site-footer__heading');
        var panel = column.querySelector('.site-footer__panel');
        if (!heading || !panel) return;
        var button = heading.querySelector('.site-footer__toggle');
        if (query.matches && !button) {
          var label = document.createElement('span');
          label.textContent = heading.textContent;
          button = document.createElement('button');
          button.type = 'button';
          button.className = 'site-footer__toggle';
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-controls', panel.id);
          button.appendChild(label);
          button.insertAdjacentHTML('beforeend', chevron);
          heading.textContent = '';
          heading.appendChild(button);
          panel.hidden = true;
          button.addEventListener('click', function () {
            var open = button.getAttribute('aria-expanded') !== 'true';
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
            panel.hidden = !open;
          });
        } else if (!query.matches && button) {
          heading.textContent = button.textContent;
          panel.hidden = false;
        }
      }
      function update() { footer.querySelectorAll('[data-footer-col]').forEach(build); }
      update();
      if (query.addEventListener) query.addEventListener('change', update);
      else if (query.addListener) query.addListener(update);
    });
  })();
</script>
{%- endif -%}
<style>
  .site-footer__utility { border-top: 1px solid var(--line); font-size: 13px; }
  .site-footer__utility-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; min-height: 34px; padding-top: 4px; padding-bottom: 4px; }
  .site-footer__utility nav { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .site-footer__utility a { color: inherit; text-decoration: none; }
  .site-footer__utility a:hover { text-decoration: underline; }
  .site-footer .site-footer__top { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); align-items: start; gap: 28px 48px; }
  .site-footer .site-footer__top[data-wide-first="true"] { grid-template-columns: 1.45fr repeat(var(--sf-cols), minmax(0, 1fr)); }
  .site-footer[data-hover="true"] a:hover { color: var(--sf-hover); }
  .site-footer__heading { margin: 0 0 12px; font-size: 1em; font-weight: 700; color: var(--text); }
  .site-footer__brand { max-width: 420px; }
  .site-footer__brand p, .site-footer__about p { margin: 12px 0 0; white-space: pre-line; }
  .site-footer__logo { display: inline-flex; align-items: center; font-family: var(--tss-heading-font); font-size: 20px; font-weight: 700; color: var(--text); }
  .site-footer a.site-footer__logo:hover { text-decoration: none; }
  .site-footer__panel { display: flex; flex-direction: column; gap: 8px; }
  .site-footer__panel[hidden] { display: none; }
  .site-footer__toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 14px 0; margin: 0; border: 0; background: none; color: inherit; font: inherit; letter-spacing: inherit; text-transform: inherit; text-align: left; cursor: pointer; }
  .site-footer__toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s; }
  .site-footer__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .site-footer__toggle:focus-visible, .site-footer__social a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .site-footer__about .site-footer__icon, .site-footer__nav .site-footer__icon { margin-bottom: 16px; }
  .site-footer__newsletter { display: grid; gap: 8px; max-width: 360px; }
  .site-footer__newsletter .site-footer__heading { margin-bottom: 4px; }
  .site-footer__newsletter p { margin: 0; min-height: 1em; }
  .site-footer__signup { display: flex; gap: 8px; }
  .site-footer__signup input { flex: 1; min-width: 0; height: 40px; padding: 0 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; background: var(--bg); color: var(--text); }
  .site-footer__signup .button { min-height: 40px; padding: 0 16px; }
  .site-footer__icon { flex-shrink: 0; }
  .site-footer__icon img { max-height: 48px; max-width: 140px; width: auto; height: auto; object-fit: contain; display: block; }
  .site-footer__social { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: row; flex-wrap: wrap; gap: 10px; }
  .site-footer__social a { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; width: calc(var(--sf-icon, 22px) * 1.8); height: calc(var(--sf-icon, 22px) * 1.8); color: var(--sf-icon-color, inherit); background: var(--sf-icon-bg, transparent); }
  .site-footer__social a:hover { text-decoration: none; opacity: .8; }
  .site-footer__social[data-shape="round"] a { border-radius: 50%; }
  .site-footer__social[data-shape="square"] a { border-radius: 4px; }
  .site-footer__social[data-border="true"] a { border: 1px solid var(--sf-icon-border, currentColor); }
  .site-footer__social svg, .site-footer__social img { width: var(--sf-icon, 22px); height: var(--sf-icon, 22px); object-fit: contain; display: block; }
  .site-footer__payments { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .site-footer__payments li { padding: 4px 10px; border: 1px solid var(--line); border-radius: 6px; font-size: 12px; font-weight: 600; color: var(--text); }
  .site-footer__top + .site-footer__legal { border-top-color: var(--sf-divider, var(--line)); }
  .site-footer__legal-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; }
  .site-footer__policies { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  @media (max-width: 960px) {
    .site-footer .site-footer__top, .site-footer .site-footer__top[data-wide-first="true"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__top > .site-footer__brand, .site-footer__top > .site-footer__about { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .site-footer .site-footer__top, .site-footer .site-footer__top[data-wide-first="true"] { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .site-footer[data-accordion="true"] .site-footer__top { gap: 0; }
    .site-footer[data-accordion="true"] .site-footer__col[data-footer-col] { border-top: 1px solid var(--line); }
    .site-footer[data-accordion="true"] .site-footer__col[data-footer-col] .site-footer__heading { margin: 0; }
    .site-footer[data-accordion="true"] .site-footer__col[data-footer-col] .site-footer__panel { padding-bottom: 14px; }
    .site-footer[data-accordion="true"] .site-footer__top > * + * { margin-top: 20px; }
    .site-footer[data-accordion="true"] .site-footer__top > .site-footer__col[data-footer-col] + * { margin-top: 20px; }
    .site-footer[data-mobile-align="left"] { text-align: left; }
    .site-footer[data-mobile-align="center"] { text-align: center; }
    .site-footer[data-mobile-align="center"] .site-footer__social, .site-footer[data-mobile-align="center"] .site-footer__payments, .site-footer[data-mobile-align="center"] .site-footer__panel { justify-content: center; align-items: center; }
    .site-footer__utility-inner { justify-content: center; text-align: center; }
    .site-footer__legal-inner { justify-content: center; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 30,
  "settings": [
    {"type": "color", "id": "background", "label": "Background colour", "default": ""},
    {"type": "color", "id": "text_color", "label": "Text colour", "default": ""},
    {"type": "color", "id": "heading_color", "label": "Heading colour", "default": ""},
    {"type": "color", "id": "link_color", "label": "Link colour", "default": ""},
    {"type": "color", "id": "link_hover_color", "label": "Link hover colour", "default": ""},
    {"type": "range", "id": "heading_size", "label": "Heading size", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the theme's size."},
    {"type": "radio", "id": "heading_case", "label": "Heading case", "options": [{"value": "none", "label": "As typed"}, {"value": "uppercase", "label": "UPPERCASE"}, {"value": "capitalize", "label": "Capitalised"}], "default": "none"},
    {"type": "range", "id": "heading_spacing", "label": "Heading letter spacing", "min": 0, "max": 6, "step": 0.5, "unit": "px", "default": 0},
    {"type": "range", "id": "link_size", "label": "Link size", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the theme's size."},
    {"type": "radio", "id": "layout", "label": "Column layout", "options": [{"value": "wide", "label": "Wide first column"}, {"value": "equal", "label": "Equal columns"}], "default": "wide", "info": "Wide: a logo or text block in front is 1.45 times wider than the other columns."},
    {"type": "range", "id": "column_gap", "label": "Space between columns", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the theme's spacing."},
    {"type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the theme's spacing."},
    {"type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the theme's spacing."},
    {"type": "range", "id": "max_width", "label": "Content width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 0, "info": "0 uses the page width."},
    {"type": "radio", "id": "text_align", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Centre"}, {"value": "right", "label": "Right"}], "default": "left"},
    {"type": "radio", "id": "mobile_align", "label": "Text alignment on phones", "options": [{"value": "same", "label": "Same as desktop"}, {"value": "left", "label": "Left"}, {"value": "center", "label": "Centre"}], "default": "same"},
    {"type": "checkbox", "id": "accordion_mobile", "label": "Accordion on mobile", "default": true, "info": "On phones, menu columns with a heading fold open and closed. The logo column stays open."},
    {"type": "checkbox", "id": "show_copyright", "label": "Show the copyright line", "default": true},
    {"type": "text", "id": "copyright", "label": "Copyright line", "default": "© {year} {store}", "info": "{year} becomes this year and {store} your store name. Empty shows the year and the store name."},
    {"type": "checkbox", "id": "policy_privacy", "label": "Link to the Privacy Policy", "default": true},
    {"type": "checkbox", "id": "policy_refund", "label": "Link to the Refund Policy", "default": false},
    {"type": "checkbox", "id": "policy_shipping", "label": "Link to the Shipping Policy", "default": false},
    {"type": "checkbox", "id": "policy_terms", "label": "Link to the Terms of Service", "default": false},
    {"type": "color", "id": "divider_color", "label": "Divider colour", "default": "", "info": "The line above the copyright strip."},
    {"type": "color", "id": "social_color", "label": "Social icon colour (all Social links blocks)", "default": ""},
    {"type": "checkbox", "id": "utility_show", "label": "Show the utility bar", "default": false, "info": "A thin strip in the footer with contact details and quick links."},
    {"type": "text", "id": "utility_left", "label": "Utility bar text", "default": "", "info": "For example: Free delivery over ₹999."},
    {"type": "text", "id": "utility_phone", "label": "Phone number", "default": ""},
    {"type": "text", "id": "utility_email", "label": "Email address", "default": ""},
