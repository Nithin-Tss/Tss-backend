{%- assign s = section.settings -%}
{%- assign low_stock = s.low_stock_threshold | default: 5 -%}
{%- comment -%} Start on the first option that is in stock, so a sold-out first option doesn't block the product {%- endcomment -%}
{%- assign shown_variant = product.variants.first -%}
{%- for variant in product.variants -%}
  {%- if variant.available_total > 0 -%}
    {%- assign shown_variant = variant -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign shown_out = false -%}
{%- if product.is_sold_out or shown_variant.is_sold_out -%}{%- assign shown_out = true -%}{%- endif -%}
<section id="section-{{ section.id }}" class="section">
  <div class="page-width product{% if s.media_position == 'right' %} product--media-right{% endif %}">
    <div class="product__media">
      <div class="product__main-image ratio-{{ s.image_ratio }}{% if s.image_zoom != 'none' and product.featured_image %} product__main-image--zoom-{{ s.image_zoom }}{% endif %}" style="--img-fit: {{ s.image_fit }}" data-zoom="{{ s.image_zoom }}">
        {%- if s.show_badges and product.badges.size > 0 -%}
          <span class="product-card__badges">
            {%- for badge in product.badges -%}
              <span class="product-card__badge{% if badge == 'New' %} product-card__badge--new{% endif %}">{{ badge }}</span>
            {%- endfor -%}
          </span>
        {%- endif -%}
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image }}" alt="{{ product.title }}" data-main-image>
        {%- else -%}
          <div class="placeholder" style="width:100%;height:100%">No image</div>
        {%- endif -%}
      </div>

      {%- if s.show_thumbnails and product.images.size > 1 -%}
        <div class="product__thumbs">
          {%- for image in product.images -%}
            <button class="product__thumb" type="button" data-src="{{ image }}"
              aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              <img src="{{ image }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if s.show_vendor and product.vendor != blank -%}
        <p class="product__meta">{{ product.vendor }}</p>
      {%- endif -%}
      <h1>{{ product.title }}</h1>
      {%- comment -%} The "Wishlist heart" block: add, remove or move it in the customizer {%- endcomment -%}
      {%- if section.wishlist_heart -%}
        {% render 'wishlist', mode: 'button', product: product, wishlist_ids: wishlist_ids, return_url: return_url, placement: 'product', size: section.wishlist_heart.size, label_text: section.wishlist_heart.label, align: section.wishlist_heart.align, with_script: true %}
      {%- endif -%}
      {%- comment -%} The "Cart icon" block: add, hide or move it in the customizer {%- endcomment -%}
      {%- if section.cart_icon -%}
        <div class="product__cart-icon" style="text-align:{{ section.cart_icon.align | default: 'left' }}">{% render 'cart', mode: 'icon', count: cart_count, session: cart_session, settings: section.cart_icon %}</div>
      {%- endif -%}
      {%- if s.show_price -%}
        <div class="product__price" data-price>{% if product.price == nil %}<span class="price price--muted">Price on request</span>{% elsif product.price_varies %}<span class="price">From {{ product.price | money }}</span>{% else %}<span class="price">{{ product.price | money }}</span>{% endif %}{% if product.is_sold_out %} <span class="price price--muted">{{ s.sold_out_label | default: 'Sold out' }}</span>{% endif %}</div>
      {%- endif -%}
      {%- if s.show_stock -%}
        <p class="product__stock{% if shown_out %} product__stock--out{% elsif shown_variant.available_total > 0 and shown_variant.available_total <= low_stock %} product__stock--few{% endif %}" data-stock data-low="{{ low_stock }}">
          {%- if shown_out %}{{ s.sold_out_label | default: 'Sold out' }}{% elsif shown_variant.available_total > 0 and shown_variant.available_total <= low_stock %}Only a few left{% else %}In stock{% endif -%}
        </p>
      {%- endif -%}

      <form class="product__form" data-product-form data-cart-add data-cart-base="{{ shop.url }}/cart" data-cart-session="{{ cart_session }}">
        <input type="hidden" name="product" value="{{ product.id }}">
        {%- if product.variants.size > 1 -%}
          {%- comment -%} "Tier cards": one card per option with its price. They drive the select below, which stays in the form {%- endcomment -%}
          {%- if s.variant_style == 'buttons' -%}
            <div class="field" role="radiogroup" aria-label="Option">
              <span>Option</span>
              <div class="product__tiers" data-tiers>
                {%- for variant in product.variants -%}
                  <button class="product__tier" type="button" role="radio" data-variant-id="{{ variant.id }}"
                    aria-checked="{% if variant.id == shown_variant.id %}true{% else %}false{% endif %}"{% if variant.is_sold_out %} data-sold-out="true"{% endif %}>
                    <span class="product__tier-name">{{ variant.sku | default: 'Option' }}{% if variant.sku == blank %} {{ forloop.index }}{% endif %}</span>
                    {%- if variant.price != nil -%}<span class="product__tier-price">{{ variant.price | money }}</span>{%- endif -%}
                    {%- if variant.is_sold_out -%}<span class="product__tier-note">{{ s.sold_out_label | default: 'Sold out' }}</span>{%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
          <label class="field"{% if s.variant_style == 'buttons' %} hidden{% endif %}>
            <span>Option</span>
            <select name="variant" data-variant>
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant.id == shown_variant.id %} selected{% endif %} data-variant-price="{{ variant.price | money }}" data-variant-sku="{{ variant.sku }}" data-variant-available="{{ variant.available_total }}" data-variant-continue="{{ variant.continue_selling }}">
                  {{ variant.sku | default: 'Option' }}{% if variant.sku == blank %} {{ forloop.index }}{% endif %}{% if variant.price != nil %} — {{ variant.price | money }}{% endif %}
                </option>
              {%- endfor -%}
            </select>
          </label>
        {%- elsif product.variants.size == 1 -%}
          <input type="hidden" name="variant" value="{{ product.variants.first.id }}">
        {%- endif -%}

        {%- if s.show_quantity -%}
          <label class="field">
            <span>Quantity</span>
            <input type="number" name="quantity" value="1" min="1" max="{% if shown_variant.available_total > 0 and shown_variant.available_total < 99 %}{{ shown_variant.available_total }}{% else %}99{% endif %}" data-quantity{% if shown_out %} disabled{% endif %}>
          </label>
        {%- endif -%}

        {%- comment -%} Sold out: one disabled "Sold out" button instead of "Add to cart" {%- endcomment -%}
        <button class="button" type="submit" data-add data-label="{{ s.add_to_cart_label | default: 'Add to cart' | escape }}" data-sold-out="{{ s.sold_out_label | default: 'Sold out' | escape }}"{% if shown_out %} disabled{% endif %}>
          {%- if shown_out %}{{ s.sold_out_label | default: 'Sold out' }}{% else %}{{ s.add_to_cart_label | default: 'Add to cart' }}{% endif -%}
        </button>
        <p class="product__notice" role="status" data-notice></p>
      </form>

      {%- if s.show_sku -%}
        <p class="product__meta" data-sku-row{% if shown_variant.sku == blank %} hidden{% endif %}>SKU: <span data-sku-text>{{ shown_variant.sku }}</span></p>
      {%- endif -%}

      {%- if s.show_description and product.description != blank -%}
        <div class="product__description">{{ product.description }}</div>
      {%- endif -%}

      {%- comment -%} "Product information" block: the product's Additional details as accordion rows {%- endcomment -%}
      {{ section.product_info }}
    </div>
  </div>
</section>
<style>
  #section-{{ section.id }} .product__main-image { position: relative; overflow: hidden; }
  #section-{{ section.id }} .product__main-image--zoom-hover img { transition: transform .15s ease-out; }
  #section-{{ section.id }} .product__main-image--zoom-hover.is-zooming { cursor: zoom-in; }
  #section-{{ section.id }} .product__main-image--zoom-hover.is-zooming img { transform: scale(2); }
  #section-{{ section.id }} .product__main-image--zoom-lightbox { cursor: zoom-in; }
  #section-{{ section.id }} .product__tiers { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); margin-top: 6px; }
  #section-{{ section.id }} .product__tier { display: grid; gap: 2px; justify-items: start; padding: 10px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--text); font: inherit; text-align: left; cursor: pointer; }
  #section-{{ section.id }} .product__tier[aria-checked="true"] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  #section-{{ section.id }} .product__tier[data-sold-out="true"] { opacity: .55; }
  #section-{{ section.id }} .product__tier-name { font-weight: 600; }
  #section-{{ section.id }} .product__tier-note { font-size: 12px; color: var(--muted); }
  .product-zoom { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 24px; background: rgba(0, 0, 0, .85); cursor: zoom-out; }
  .product-zoom img { max-width: 100%; max-height: 100%; object-fit: contain; }
</style>
<script>
  (function () {
    var root = document.getElementById("section-{{ section.id }}");
    var main = root.querySelector("[data-main-image]");

    // Image zoom: "hover" magnifies under the pointer (mouse only), "lightbox" opens the picture full size
    var frame = root.querySelector(".product__main-image");
    if (main && frame) {
      var zoom = frame.getAttribute("data-zoom");
      if (zoom === "hover") {
        frame.addEventListener("mouseenter", function (event) { if (event.pointerType !== "touch") frame.classList.add("is-zooming"); });
        frame.addEventListener("mouseleave", function () { frame.classList.remove("is-zooming"); main.style.transformOrigin = ""; });
        frame.addEventListener("mousemove", function (event) {
          var box = frame.getBoundingClientRect();
          main.style.transformOrigin = ((event.clientX - box.left) / box.width * 100) + "% " + ((event.clientY - box.top) / box.height * 100) + "%";
        });
      } else if (zoom === "lightbox") {
        frame.addEventListener("click", function () {
          var overlay = document.createElement("div");
          overlay.className = "product-zoom";
          overlay.setAttribute("role", "dialog");
          overlay.setAttribute("aria-label", "Enlarged image");
          var big = document.createElement("img");
          big.src = main.src;
          big.alt = main.alt;
          overlay.appendChild(big);
          function close() { overlay.remove(); document.removeEventListener("keydown", onKey); }
          function onKey(event) { if (event.key === "Escape") close(); }
          overlay.addEventListener("click", close);
          document.addEventListener("keydown", onKey);
          document.body.appendChild(overlay);
        });
      }
    }

    root.querySelectorAll(".product__thumb").forEach(function (thumb) {
      thumb.addEventListener("click", function () {
        if (main) main.src = thumb.dataset.src;
        root.querySelectorAll(".product__thumb").forEach(function (t) {
          t.setAttribute("aria-current", t === thumb ? "true" : "false");
        });
      });
    });

    var add = root.querySelector("[data-add]");
    var qty = root.querySelector("[data-quantity]");
    var stock = root.querySelector("[data-stock]");

    // Price, SKU and stock of the chosen option. (Option data is data-variant-*, so it never
    // matches the price, SKU and stock elements of the page.)
    function showOption(option) {
      var priceBox = root.querySelector(".product__price[data-price]");
      if (priceBox) {
        priceBox.innerHTML = '<span class="price"></span>';
        var price = priceBox.querySelector(".price");
        if (option.dataset.variantPrice) price.textContent = option.dataset.variantPrice;
        else { price.textContent = "Price on request"; price.className = "price price--muted"; }
      }
      var skuRow = root.querySelector("[data-sku-row]");
      if (skuRow) {
        skuRow.hidden = !option.dataset.variantSku;
        root.querySelector("[data-sku-text]").textContent = option.dataset.variantSku;
      }

      var left = Number(option.dataset.variantAvailable);
      var out = left <= 0 && option.dataset.variantContinue !== "true"; // an option that keeps selling is never sold out
      add.disabled = out;
      add.textContent = out ? add.dataset.soldOut : add.dataset.label;
      if (qty) {
        qty.disabled = out;
        qty.max = left > 0 && left < 99 ? left : 99;
        if (Number(qty.value) > Number(qty.max)) qty.value = qty.max;
      }
      if (stock) {
        var low = Number(stock.dataset.low);
        var few = left > 0 && left <= low;
        stock.textContent = out ? add.dataset.soldOut : few ? "Only a few left" : "In stock";
        stock.className = "product__stock" + (out ? " product__stock--out" : few ? " product__stock--few" : "");
      }
    }

    var select = root.querySelector("[data-variant]");
    if (select) {
      select.addEventListener("change", function () {
        showOption(select.selectedOptions[0]);
        root.querySelectorAll(".product__tier").forEach(function (tier) {
          tier.setAttribute("aria-checked", tier.getAttribute("data-variant-id") === select.value ? "true" : "false");
        });
      });
      root.querySelectorAll(".product__tier").forEach(function (tier) {
        tier.addEventListener("click", function () {
          select.value = tier.getAttribute("data-variant-id");
          select.dispatchEvent(new Event("change"));
        });
      });
    }

    // Add to cart: the form is handled by snippets/cart.liquid
  })();
</script>
{% render 'cart', mode: 'script' %}
