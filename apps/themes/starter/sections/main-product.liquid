{{ product_json_ld }}
{%- assign s = section.settings -%}
{%- assign low_stock = s.low_stock_threshold | default: 5 -%}
{%- comment -%} Start on the first option that is in stock, so a sold-out first option doesn't block the product {%- endcomment -%}
{%- assign shown_variant = product.variants.first -%}
{%- for variant in product.variants -%}
  {%- if variant.available_total > 0 -%}
    {%- assign shown_variant = variant -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign shown_out = false -%}
{%- if product.is_sold_out or shown_variant.is_sold_out -%}{%- assign shown_out = true -%}{%- endif -%}
{%- comment -%} Buttons are hidden for a single variant with no option value (nothing to choose) {%- endcomment -%}
{%- assign show_options = false -%}
{%- if product.options.size > 0 -%}{%- assign show_options = true -%}{%- endif -%}
<section id="section-{{ section.id }}" class="section">
  <div class="page-width product{% if s.media_position == 'right' %} product--media-right{% endif %}">
    <div class="product__media">
      <div class="product__main-image ratio-{{ s.image_ratio }}{% if s.image_zoom != 'none' and product.featured_image %} product__main-image--zoom-{{ s.image_zoom }}{% endif %}" style="--img-fit: {{ s.image_fit }}" data-zoom="{{ s.image_zoom }}">
        {%- if s.show_badges and product.badges.size > 0 -%}
          <span class="product-card__badges">
            {%- for badge in product.badges -%}
              <span class="product-card__badge{% if badge == 'New' %} product-card__badge--new{% endif %}">{{ badge }}</span>
            {%- endfor -%}
          </span>
        {%- endif -%}
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image }}" alt="{{ product.title | escape }}" data-main-image>
        {%- else -%}
          <div class="placeholder" style="width:100%;height:100%">No image</div>
        {%- endif -%}
      </div>

      {%- if s.show_thumbnails and product.images.size > 1 -%}
        <div class="product__thumbs">
          {%- for image in product.images -%}
            <button class="product__thumb" type="button" data-src="{{ image }}"
              aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              <img src="{{ image }}" alt="{{ product.title | escape }} - Image {{ forloop.index }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if s.show_vendor and product.vendor != blank -%}
        <p class="product__meta">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="product__title">{{ product.title }}</h1>

      {%- if s.show_price -%}
        <div class="product__price" data-price>{% if product.price == nil %}<span class="price price--muted">Price on request</span>{% elsif product.price_varies %}<span class="price">From {{ product.price | money }}</span>{% else %}<span class="price">{{ product.price | money }}</span>{% endif %}{% if product.on_sale and product.price != nil %} <span class="price price--compare product__compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>
      {%- endif -%}
      {%- if s.show_stock -%}
        <p class="product__stock{% if shown_out %} product__stock--out{% elsif shown_variant.available_total > 0 and shown_variant.available_total <= low_stock and shown_variant.continue_selling != true %} product__stock--few{% endif %}" data-stock data-low="{{ low_stock }}">
          {%- if shown_out %}{{ s.sold_out_label | default: 'Sold out' }}{% elsif shown_variant.available_total > 0 and shown_variant.available_total <= low_stock and shown_variant.continue_selling != true %}Only a few left{% else %}In stock{% endif -%}
        </p>
      {%- endif -%}

      <hr class="product__divider">

      {%- if show_options -%}
        {%- assign shown_label = '' -%}
        {%- for o in product.options -%}
          {%- assign shown_value = shown_variant.options[o.name] -%}
          {%- if forloop.first -%}{%- assign shown_label = shown_value -%}{%- else -%}{%- assign shown_label = shown_label | append: ' / ' | append: shown_value -%}{%- endif -%}
        {%- endfor -%}
        <p class="product__variant-label" data-variant-label>{{ shown_label }}</p>

        <div class="product__options" data-options>
          {%- for option in product.options -%}
            <div class="product__option-group" data-option-group data-option-index="{{ forloop.index0 }}">
              <span class="product__option-name">{{ option.name }}</span>
              <div class="product__tiers" data-tiers role="radiogroup" aria-label="{{ option.name }}">
                {%- for value in option.values -%}
                  {%- comment -%} Is the variant this value resolves to (keeping every other option as shown) sold out? {%- endcomment -%}
                  {%- assign tier_out = false -%}
                  {%- assign tier_found = false -%}
                  {%- for v in product.variants -%}
                    {%- unless tier_found -%}
                      {%- assign tier_ok = true -%}
                      {%- if v.options[option.name] != value -%}{%- assign tier_ok = false -%}{%- endif -%}
                      {%- for other in product.options -%}
                        {%- unless other.name == option.name -%}
                          {%- if v.options[other.name] != shown_variant.options[other.name] -%}{%- assign tier_ok = false -%}{%- endif -%}
                        {%- endunless -%}
                      {%- endfor -%}
                      {%- if tier_ok -%}
                        {%- assign tier_found = true -%}
                        {%- if v.is_sold_out -%}{%- assign tier_out = true -%}{%- endif -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endfor -%}
                  <button class="product__tier{% if tier_out %} is-muted{% endif %}" type="button" role="radio"
                    data-option-value="{{ value | escape }}"
                    aria-checked="{% if shown_variant.options[option.name] == value %}true{% else %}false{% endif %}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Variants that only differ by name (no options): tier cards, or a dropdown when chosen in the settings {%- endcomment -%}
      {%- if show_options == false and product.variants.size > 1 and s.variant_style != 'dropdown' -%}
        <div class="product__options" data-options>
          <div class="product__tiers" data-tiers role="radiogroup" aria-label="Option">
            {%- for variant in product.variants -%}
              <button class="product__tier{% if variant.is_sold_out %} is-muted{% endif %}" type="button" role="radio" data-sku-tier="{{ variant.id }}"
                aria-checked="{% if variant.id == shown_variant.id %}true{% else %}false{% endif %}">
                <span class="product__tier-name">{{ variant.sku | default: 'Option' }}</span>
                {%- if variant.price != nil %} <span class="product__tier-price">{{ variant.price | money }}</span>{% endif -%}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} The "Wishlist heart" block: add, remove or move it in the customizer {%- endcomment -%}
      {%- if section.wishlist_heart -%}
        {% render 'wishlist', mode: 'button', product: product, wishlist_ids: wishlist_ids, return_url: return_url, placement: 'product', size: section.wishlist_heart.size, label_text: section.wishlist_heart.label, align: section.wishlist_heart.align, with_script: true %}
      {%- endif -%}

      {%- comment -%} The "Cart icon" block: add, remove or move it in the customizer {%- endcomment -%}
      {%- if section.cart_icon -%}
        <div class="product__cart-icon" style="text-align:{{ section.cart_icon.align | default: 'left' }}">{% render 'cart', mode: 'icon', count: cart_count, session: cart_session, settings: section.cart_icon %}</div>
      {%- endif -%}

      <form class="product__form" data-product-form data-cart-add data-cart-base="{{ shop.url }}/cart" data-cart-session="{{ cart_session }}">
        <input type="hidden" name="product" value="{{ product.id }}">
        {%- if show_options -%}
          <select name="variant" data-variant hidden>
            {%- for variant in product.variants -%}
              {%- assign variant_label = '' -%}
              {%- for o in product.options -%}
                {%- assign variant_value = variant.options[o.name] -%}
                {%- if forloop.first -%}{%- assign variant_label = variant_value -%}{%- else -%}{%- assign variant_label = variant_label | append: ' / ' | append: variant_value -%}{%- endif -%}
              {%- endfor -%}
              <option value="{{ variant.id }}"{% if variant.id == shown_variant.id %} selected{% endif %}
                data-variant-price="{{ variant.price | money }}"{% if variant.on_sale %} data-variant-compare="{{ variant.compare_at_price | money }}"{% endif %}
                data-variant-available="{{ variant.available_total }}" data-variant-continue="{{ variant.continue_selling }}"
                data-variant-label="{{ variant_label | escape }}"
                {%- for o in product.options %} data-opt-{{ forloop.index0 }}="{{ variant.options[o.name] | escape }}"{%- endfor -%}></option>
            {%- endfor -%}
          </select>
        {%- elsif product.variants.size > 1 -%}
          <div{% if s.variant_style != 'dropdown' %} hidden{% endif %}>
          <select name="variant" data-variant>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"{% if variant.id == shown_variant.id %} selected{% endif %}
                data-variant-price="{{ variant.price | money }}"{% if variant.on_sale %} data-variant-compare="{{ variant.compare_at_price | money }}"{% endif %}
                data-variant-available="{{ variant.available_total }}" data-variant-continue="{{ variant.continue_selling }}"
                data-variant-label="{{ variant.sku | escape }}">{{ variant.sku | default: 'Option' }}{% if variant.price != nil %} — {{ variant.price | money }}{% endif %}</option>
            {%- endfor -%}
          </select>
          </div>
        {%- elsif product.variants.size == 1 -%}
          <input type="hidden" name="variant" value="{{ product.variants.first.id }}">
        {%- endif -%}

        <div class="product__buy-row">
          {%- if s.show_quantity -%}
            <div class="product__qty" data-qty-box>
              <button class="product__qty-btn" type="button" data-qty-decrement aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" max="{% if shown_variant.available_total > 0 and shown_variant.available_total < 99 %}{{ shown_variant.available_total }}{% else %}99{% endif %}" data-quantity{% if shown_out %} disabled{% endif %}>
              <button class="product__qty-btn" type="button" data-qty-increment aria-label="Increase quantity">+</button>
            </div>
          {%- endif -%}

          {%- comment -%} Sold out: one disabled "Sold out" button instead of "Add to cart" {%- endcomment -%}
          <button class="button product__add" type="submit" data-add data-label="{{ s.add_to_cart_label | default: 'Add to cart' | escape }}" data-sold-out="{{ s.sold_out_label | default: 'Sold out' | escape }}"{% if shown_out %} disabled{% endif %}>
            {%- if shown_out %}{{ s.sold_out_label | default: 'Sold out' }}{% else %}{{ s.add_to_cart_label | default: 'Add to cart' }}{% endif -%}
          </button>
        </div>
        <p class="product__notice" role="status" data-notice></p>
      </form>

      {%- if s.show_description and product.description != blank -%}
        <div class="product__description">{{ product.description }}</div>
      {%- endif -%}

      {%- comment -%} "Product information" block: the product's Additional details as accordion rows {%- endcomment -%}
      {{ section.product_info }}
    </div>
  </div>
</section>
<style>
  .product__price .product__compare { display: inline; margin-left: 6px; font-size: .8em; font-weight: 400; color: #888; text-decoration: line-through; }
  #section-{{ section.id }} { --burgundy: #7b1e3a; }
  #section-{{ section.id }} .product__title { font-size: clamp(26px, 4vw, 38px); font-weight: 700; line-height: 1.15; margin: 4px 0 10px; }
  #section-{{ section.id }} .product__divider { border: none; border-top: 1px solid var(--line); margin: 14px 0; }
  #section-{{ section.id }} .product__variant-label { font-size: 13px; color: var(--muted); margin: 0 0 8px; }
  #section-{{ section.id }} .product__options { display: flex; flex-direction: column; gap: 14px; margin-bottom: 16px; }
  #section-{{ section.id }} .product__option-name { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
  #section-{{ section.id }} .product__main-image { position: relative; overflow: hidden; }
  #section-{{ section.id }} .product__main-image--zoom-hover img { transition: transform .15s ease-out; }
  #section-{{ section.id }} .product__main-image--zoom-hover.is-zooming { cursor: zoom-in; }
  #section-{{ section.id }} .product__main-image--zoom-hover.is-zooming img { transform: scale(2); }
  #section-{{ section.id }} .product__main-image--zoom-lightbox { cursor: zoom-in; }
  #section-{{ section.id }} .product__tiers { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 0; }
  #section-{{ section.id }} .product__tier { display: inline-flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 20px; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: var(--text); font: inherit; font-weight: 600; text-align: center; cursor: pointer; }
  #section-{{ section.id }} .product__tier[aria-checked="true"] { background: #111; border-color: #111; color: #fff; }
  #section-{{ section.id }} .product__tier.is-muted { opacity: .45; }
  #section-{{ section.id }} .product__wishlist-form { display: block; width: 100%; margin: 4px 0 16px; }
  #section-{{ section.id }} .product__wishlist-add { display: flex; width: 100%; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border: 1px solid var(--burgundy); border-radius: 10px; background: transparent; color: var(--burgundy); font: inherit; font-weight: 600; cursor: pointer; }
  #section-{{ section.id }} .product__wishlist-add svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  #section-{{ section.id }} .product__wishlist-add.is-wishlisted { background: var(--burgundy); color: #fff; }
  #section-{{ section.id }} .product__wishlist-add.is-wishlisted svg { fill: currentColor; }
  #section-{{ section.id }} .product__buy-row { display: flex; align-items: stretch; gap: 12px; margin-top: 4px; }
  #section-{{ section.id }} .product__qty { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; flex: 0 0 auto; }
  #section-{{ section.id }} .product__qty-btn { width: 44px; height: 56px; border: none; background: #fff; color: var(--text); font-size: 18px; line-height: 1; cursor: pointer; }
  #section-{{ section.id }} .product__qty input[type="number"] { width: 48px; height: 56px; border: none; border-left: 1px solid var(--line); border-right: 1px solid var(--line); text-align: center; font: inherit; -moz-appearance: textfield; }
  #section-{{ section.id }} .product__qty input::-webkit-outer-spin-button,
  #section-{{ section.id }} .product__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  #section-{{ section.id }} .product__add { flex: 1 1 auto; min-height: 56px; background: var(--burgundy); border-color: var(--burgundy); color: #fff; }
  #section-{{ section.id }} .product__add:disabled { opacity: .5; cursor: default; }
  @media (max-width: 480px) {
    #section-{{ section.id }} .product__buy-row { flex-direction: column; }
    #section-{{ section.id }} .product__qty { align-self: stretch; justify-content: center; }
  }
  .product-zoom { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 24px; background: rgba(0, 0, 0, .85); cursor: zoom-out; }
  .product-zoom img { max-width: 100%; max-height: 100%; object-fit: contain; }
</style>
<script>
  (function () {
    var root = document.getElementById("section-{{ section.id }}");
    var main = root.querySelector("[data-main-image]");

    // Image zoom: "hover" magnifies under the pointer (mouse only), "lightbox" opens the picture full size
    var frame = root.querySelector(".product__main-image");
    if (main && frame) {
      var zoom = frame.getAttribute("data-zoom");
      if (zoom === "hover") {
        frame.addEventListener("mouseenter", function (event) { if (event.pointerType !== "touch") frame.classList.add("is-zooming"); });
        frame.addEventListener("mouseleave", function () { frame.classList.remove("is-zooming"); main.style.transformOrigin = ""; });
        frame.addEventListener("mousemove", function (event) {
          var box = frame.getBoundingClientRect();
          main.style.transformOrigin = ((event.clientX - box.left) / box.width * 100) + "% " + ((event.clientY - box.top) / box.height * 100) + "%";
        });
      } else if (zoom === "lightbox") {
        frame.addEventListener("click", function () {
          var overlay = document.createElement("div");
          overlay.className = "product-zoom";
          overlay.setAttribute("role", "dialog");
          overlay.setAttribute("aria-label", "Enlarged image");
          var big = document.createElement("img");
          big.src = main.src;
          big.alt = main.alt;
          overlay.appendChild(big);
          function close() { overlay.remove(); document.removeEventListener("keydown", onKey); }
          function onKey(event) { if (event.key === "Escape") close(); }
          overlay.addEventListener("click", close);
          document.addEventListener("keydown", onKey);
          document.body.appendChild(overlay);
        });
      }
    }

    root.querySelectorAll(".product__thumb").forEach(function (thumb) {
      thumb.addEventListener("click", function () {
        if (main) main.src = thumb.dataset.src;
        root.querySelectorAll(".product__thumb").forEach(function (t) {
          t.setAttribute("aria-current", t === thumb ? "true" : "false");
        });
      });
    });

    var add = root.querySelector("[data-add]");
    var qty = root.querySelector("[data-quantity]");
    var label = root.querySelector("[data-variant-label]");
    var hiddenSelect = root.querySelector("[data-variant]");
    var optionEls = hiddenSelect ? Array.prototype.slice.call(hiddenSelect.options) : [];

    // Price, label and stock state of the chosen variant. (Variant data is data-variant-*, so it
    // never matches the price and label elements of the page.)
    function showOption(option) {
      var priceBox = root.querySelector(".product__price[data-price]");
      if (priceBox) {
        priceBox.innerHTML = '<span class="price"></span>';
        var price = priceBox.querySelector(".price");
        if (option.dataset.variantPrice) price.textContent = option.dataset.variantPrice;
        else { price.textContent = "Price on request"; price.className = "price price--muted"; }
        if (option.dataset.variantCompare) {
          var compare = document.createElement("span");
          compare.className = "price price--compare product__compare";
          compare.textContent = option.dataset.variantCompare;
          priceBox.appendChild(document.createTextNode(" "));
          priceBox.appendChild(compare);
        }
      }
      if (label && option.dataset.variantLabel) label.textContent = option.dataset.variantLabel;

      var left = Number(option.dataset.variantAvailable);
      var out = left <= 0 && option.dataset.variantContinue !== "true"; // an option that keeps selling is never sold out
      var stock = root.querySelector("[data-stock]");
      if (stock) {
        var low = Number(stock.dataset.low) || 5;
        stock.textContent = out ? (add ? add.dataset.soldOut : "Sold out") : left <= low && option.dataset.variantContinue !== "true" ? "Only a few left" : "In stock";
        stock.classList.toggle("product__stock--out", out);
        stock.classList.toggle("product__stock--few", !out && left <= low && option.dataset.variantContinue !== "true");
      }
      if (add) {
        add.disabled = out;
        add.textContent = out ? add.dataset.soldOut : add.dataset.label;
      }
      if (qty) {
        qty.disabled = out;
        qty.max = left > 0 && left < 99 ? left : 99;
        if (Number(qty.value) > Number(qty.max)) qty.value = qty.max;
      }
    }

    // Reads the checked button in each option group, e.g. {"0": "Pack of 6"}
    function currentSelection() {
      var sel = {};
      root.querySelectorAll("[data-option-group]").forEach(function (group) {
        var idx = group.getAttribute("data-option-index");
        var active = group.querySelector('[aria-checked="true"]');
        if (active) sel[idx] = active.getAttribute("data-option-value");
      });
      return sel;
    }

    // The variant whose option values match every index in `sel`
    function findOption(sel) {
      var keys = Object.keys(sel);
      for (var i = 0; i < optionEls.length; i++) {
        var matches = true;
        for (var k = 0; k < keys.length; k++) {
          if (optionEls[i].dataset["opt" + keys[k]] !== sel[keys[k]]) { matches = false; break; }
        }
        if (matches) return optionEls[i];
      }
      return optionEls[0];
    }

    // Mutes a button when choosing it (keeping every other group's current value) finds no stocked variant
    function syncButtonStates() {
      var sel = currentSelection();
      root.querySelectorAll("[data-option-group]").forEach(function (group) {
        var idx = group.getAttribute("data-option-index");
        group.querySelectorAll("[data-option-value]").forEach(function (btn) {
          var trial = {};
          Object.keys(sel).forEach(function (k) { trial[k] = sel[k]; });
          trial[idx] = btn.getAttribute("data-option-value");
          var match = findOption(trial);
          var out = !match || (Number(match.dataset.variantAvailable) <= 0 && match.dataset.variantContinue !== "true");
          btn.classList.toggle("is-muted", out);
        });
      });
    }

    function applyVariant(option) {
      if (!option) return;
      if (hiddenSelect) hiddenSelect.value = option.value;
      showOption(option);
      syncButtonStates();
    }

    root.querySelectorAll("[data-option-group]").forEach(function (group) {
      group.querySelectorAll("[data-option-value]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          group.querySelectorAll("[data-option-value]").forEach(function (b) {
            b.setAttribute("aria-checked", b === btn ? "true" : "false");
          });
          applyVariant(findOption(currentSelection()));
        });
      });
    });
    syncButtonStates();

    root.querySelectorAll("[data-sku-tier]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        root.querySelectorAll("[data-sku-tier]").forEach(function (b) { b.setAttribute("aria-checked", b === btn ? "true" : "false"); });
        for (var i = 0; i < optionEls.length; i++) {
          if (optionEls[i].value === btn.getAttribute("data-sku-tier")) { applyVariant(optionEls[i]); break; }
        }
      });
    });

    var decBtn = root.querySelector("[data-qty-decrement]");
    var incBtn = root.querySelector("[data-qty-increment]");
    function stepQty(delta) {
      if (!qty || qty.disabled) return;
      var max = Number(qty.max) || 99;
      var next = (Number(qty.value) || 1) + delta;
      if (next < 1) next = 1;
      if (next > max) next = max;
      qty.value = next;
    }
    if (decBtn) decBtn.addEventListener("click", function () { stepQty(-1); });
    if (incBtn) incBtn.addEventListener("click", function () { stepQty(1); });

    // Add to cart: the form is handled by snippets/cart.liquid
  })();
</script>
{% render 'cart', mode: 'script' %}
