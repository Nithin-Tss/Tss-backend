{%- comment -%}
  Login page, built from blocks (snippets/auth-*.liquid). Reorder, remove or edit the lines below.
  Available: shop.url, customer, return_url, error, success.
{%- endcomment -%}
<section class="section customer-auth-section auth-page">
  {% render 'auth-styles' %}
  <div class="page-width">
    <div class="customer-auth customer-auth--login">
      <div class="customer-card">
        {% render 'auth-header', mode: 'login', return_url: return_url, error: error, success: success %}
        {% render 'auth-login-form', return_url: return_url, customer: customer %}
        {% render 'auth-links', mode: 'login', return_url: return_url %}
      </div>
    </div>
  </div>
</section>
{% render 'auth-script' %}
