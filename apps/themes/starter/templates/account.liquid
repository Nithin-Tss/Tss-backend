{%- comment -%}
  Customer account page, built from blocks (snippets/account-*.liquid). Reorder, remove or edit the lines below.
  Available: shop.url, customer (name, email, phone, addresses, orders), wishlist_count, error, success.
{%- endcomment -%}
<section class="section customer-account-section">
  <div class="customer-account">
    {% render 'account-styles' %}
    {% render 'account-header', customer: customer, error: error, success: success, wishlist_count: wishlist_count %}
    {% render 'account-profile', customer: customer %}
    {% render 'account-addresses', customer: customer %}
    {% render 'account-orders', customer: customer %}
    {% render 'account-script' %}
  </div>
</section>
