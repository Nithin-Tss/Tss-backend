{%- comment -%}
  Bold design: this theme's own styling, loaded by layout/theme.liquid after snippets/styles.liquid.
  Edit it here, in the code editor of the theme that uses it.
{%- endcomment -%}
<style>
/* Bold: loud and flat. Black header, giant uppercase type, hard shadows, framed cards. */
body { --radius: 0px; --page: 1320px; --pop: #F5C400; }
body h1, body h2, body h3 { text-transform: uppercase; font-weight: 700; letter-spacing: .01em; line-height: 1; }
body .announcement { font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: 12px; }
body .site-header { border-bottom: 4px solid var(--pop); }
body .site-header__inner { min-height: 76px; }
body .site-header__logo { font-size: 26px; font-weight: 800; text-transform: uppercase; letter-spacing: -.02em; }
body .site-header__nav a { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; opacity: 1; }
body .site-header__nav a:hover { color: var(--pop); }
body .section { padding: 72px 0; }
body .section-heading { font-size: clamp(32px, 5vw, 56px); border-left: 10px solid var(--pop); padding-left: 16px; margin-bottom: 32px; }
body .button { border: 3px solid var(--text); border-radius: 0; box-shadow: 5px 5px 0 var(--text); text-transform: uppercase; letter-spacing: .08em; font-weight: 800; transition: transform .1s, box-shadow .1s; }
body .button:hover { opacity: 1; transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--text); }
body .hero--image .button { border-color: #fff; box-shadow: 5px 5px 0 var(--pop); }
body .hero h1 { font-size: clamp(48px, 9vw, 120px); line-height: .92; max-width: 11ch; }
body .hero p { font-size: 20px; font-weight: 500; }
body .product-card { gap: 12px; }
body .product-card__media { border: 3px solid var(--text); border-radius: 0; }
body .product-card:hover .product-card__media { box-shadow: 8px 8px 0 var(--pop); transform: translate(-3px, -3px); transition: .15s; }
body .product-card__title { font-weight: 800; text-transform: uppercase; letter-spacing: .02em; }
body .price { align-self: flex-start; background: var(--pop); color: #0F0F0F; padding: 2px 10px; font-weight: 800; }
body .cards--bordered .product-card { border: 3px solid var(--text); padding: 12px; }
body .site-footer { border-top: 4px solid var(--pop); margin-top: 0; padding: 48px 0; }
body .site-footer strong { color: #fff; text-transform: uppercase; }
body .slideshow__arrow { border-radius: 0; background: var(--pop); }
body .slideshow__dot { border-radius: 0; }
/* A hero or slide without a picture keeps the text colour (the starter mutes it) */
body .hero.placeholder { color: var(--text); }
body .hero h2.hero__title { font-size: clamp(40px, 7vw, 88px); text-transform: uppercase; font-weight: 800; line-height: .95; }
/* Product grid header bar (sections/product-grid.liquid) */
.bold-bar { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; border-bottom: 4px solid var(--text); margin-bottom: 28px; padding-bottom: 14px; }
.bold-bar .section-heading { margin: 0; border-left: 10px solid var(--pop); }
.bold-bar__meta { display: flex; align-items: center; gap: 16px; }
.bold-bar__count { font-weight: 800; text-transform: uppercase; letter-spacing: .1em; font-size: 13px; background: var(--text); color: var(--bg); padding: 4px 10px; }
/* Bold Customer Auth & Account */
body .customer-auth, body .customer-card, body .customer-account, body .account-card, body .order-item, body .address-item { border: 3px solid var(--text); border-radius: 0; box-shadow: 6px 6px 0 var(--text); background: var(--bg); }
body .customer-card__title, body .customer-account__title, body .account-card__title { text-transform: uppercase; font-weight: 800; letter-spacing: .02em; }
body .form-input, body .field input, body .field select { border: 3px solid var(--text); border-radius: 0; box-shadow: none; font-weight: 600; }
body .form-input:focus { border-color: var(--text); box-shadow: 3px 3px 0 var(--pop); }
body .badge { border-radius: 0; border: 2px solid var(--text); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
body .badge--paid, body .badge--fulfilled { background: var(--pop); color: #000; }
body .badge--default { background: var(--text); color: var(--bg); }
body .alert--error { border: 3px solid #b91c1c; border-radius: 0; box-shadow: 4px 4px 0 #b91c1c; font-weight: 700; }
body .alert--success { border: 3px solid #15803d; border-radius: 0; box-shadow: 4px 4px 0 #15803d; font-weight: 700; }
</style>
