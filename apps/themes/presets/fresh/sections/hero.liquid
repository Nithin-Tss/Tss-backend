{%- comment -%}
  Fresh hero: a rounded picture panel with the words on a white card laid over it.
  Same settings as the starter's hero.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section id="section-{{ section.id }}" class="fresh-hero fresh-hero--{{ s.height }}">
  <div class="fresh-hero__frame">
    {%- if s.video_url != blank -%}
      <video class="fresh-hero__media" src="{{ s.video_url }}" autoplay muted loop playsinline aria-hidden="true"{% if s.image_url != blank %} poster="{{ s.image_url }}"{% endif %}></video>
    {%- elsif s.image_url != blank -%}
      <picture>
        {%- if s.mobile_image_url != blank -%}<source media="(max-width: 749px)" srcset="{{ s.mobile_image_url }}">{%- endif -%}
        <img class="fresh-hero__media" src="{{ s.image_url }}" alt="{{ s.image_alt }}" style="object-position:{{ s.image_position }}">
      </picture>
    {%- else -%}
      <div class="fresh-hero__media placeholder" aria-hidden="true"></div>
    {%- endif -%}
    <div class="fresh-hero__card">
      {%- if s.label_text != blank -%}<span class="fresh-hero__label">{{ s.label_text }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h1>{{ s.heading }}</h1>{%- endif -%}
      {%- if s.subheading != blank -%}<p>{{ s.subheading }}</p>{%- endif -%}
      {%- if s.button_label != blank or s.button2_label != blank -%}
        <div class="fresh-hero__buttons">
          {%- if s.button_label != blank -%}
            <a class="button" href="{{ s.button_link | link }}"{% if s.button_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ s.button_label }}</a>
          {%- endif -%}
          {%- if s.button2_label != blank -%}
            <a class="button button--outline" href="{{ s.button2_link | link }}"{% if s.button2_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ s.button2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
