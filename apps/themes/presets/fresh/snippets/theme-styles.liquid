{%- comment -%}
  Fresh design: this theme's own styling, loaded by layout/theme.liquid after snippets/styles.liquid.
  Edit it here, in the code editor of the theme that uses it.
{%- endcomment -%}
<style>
/* Fresh: friendly. Floating pill header, framed hero, soft shadowed rounded cards. */
body { --radius: 22px; --page: 1180px; --shadow: 0 12px 28px -14px color-mix(in srgb, var(--accent) 45%, transparent); }
body .site-header { margin: 14px 16px 0; border-radius: 999px; border: 1px solid var(--line); box-shadow: var(--shadow); }
body .site-header[data-sticky="true"] { top: 12px; }
body .site-header__inner { min-height: 60px; padding: 0 12px 0 22px; }
body .site-header__logo { font-weight: 800; color: var(--accent); }
body .site-header__nav { gap: 4px; }
body .site-header__nav a { padding: 8px 14px; border-radius: 999px; opacity: 1; font-weight: 600; }
body .site-header__nav a:hover { background: var(--soft); }
body .section { padding: 64px 0; }
body .section-heading { text-align: center; font-weight: 800; font-size: clamp(26px, 3.4vw, 36px); }
body .carousel__header { flex-direction: column; align-items: center; }
body .product-card { background: #fff; border-radius: var(--radius); padding: 12px; box-shadow: var(--shadow); gap: 8px; transition: transform .2s, box-shadow .2s; }
body .product-card:hover { transform: translateY(-4px); }
body .product-card__media { border-radius: 16px; }
body .product-card__title { font-weight: 700; padding: 0 4px; }
body .price { color: var(--accent); font-weight: 800; padding: 0 4px 4px; }
body .button { font-weight: 700; box-shadow: var(--shadow); }
body .site-footer { margin-top: 64px; border-top: 0; border-radius: 32px 32px 0 0; background: color-mix(in srgb, var(--accent) 10%, var(--bg)); padding: 48px 0; }
body .rich-text { margin: 0 auto; text-align: center; background: #fff; border-radius: 32px; padding: 40px 28px; box-shadow: var(--shadow); }
/* A hero or slide without a picture keeps the text colour (the starter mutes it) */
body .hero.placeholder { color: var(--text); }
/* Framed hero (sections/hero.liquid): a rounded picture with the words on a white card */
.fresh-hero { padding: 24px 16px 0; }
.fresh-hero__frame { position: relative; max-width: calc(var(--page) + 40px); margin: 0 auto; border-radius: 32px; overflow: hidden; display: flex; align-items: flex-end; min-height: 480px; background: var(--soft); }
.fresh-hero--small .fresh-hero__frame { min-height: 340px; } .fresh-hero--large .fresh-hero__frame { min-height: 640px; }
.fresh-hero__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.fresh-hero__media.placeholder { border-radius: 0; }
.fresh-hero__card { position: relative; background: #fff; border-radius: 24px; margin: 24px; padding: 28px 32px; max-width: 460px; box-shadow: var(--shadow); }
.fresh-hero__label { display: inline-block; background: var(--soft); color: var(--accent); padding: 5px 14px; border-radius: 999px; font-size: 13px; font-weight: 700; margin-bottom: 12px; }
.fresh-hero__card h1 { font-size: clamp(28px, 3.6vw, 44px); margin: 0 0 10px; }
.fresh-hero__card p { color: var(--muted); margin: 0 0 20px; }
.fresh-hero__buttons { display: flex; flex-wrap: wrap; gap: 10px; }
@media (max-width: 640px) { .fresh-hero__card { margin: 12px; padding: 22px; } }
/* Fresh Customer Auth & Account */
body .customer-auth, body .customer-card, body .customer-account, body .account-card, body .order-item, body .address-item { border-radius: var(--radius); border: 1px solid var(--line); box-shadow: var(--shadow); background: #fff; }
body .form-input, body .field input, body .field select { border-radius: 999px; padding: 0 18px; border: 1px solid var(--line); }
body .form-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); }
body .button.customer-card__submit { border-radius: 999px; box-shadow: var(--shadow); font-weight: 700; }
body .badge { border-radius: 999px; font-weight: 700; padding: 3px 10px; }
body .customer-card__title, body .customer-account__title, body .account-card__title { font-weight: 800; color: var(--accent); }
</style>
