{%- comment -%}
  Minimal design: this theme's own styling, loaded by layout/theme.liquid after snippets/styles.liquid.
  Edit it here, in the code editor of the theme that uses it.
{%- endcomment -%}
<style>
/* Minimal: quiet. Tiny spaced type, no borders or radii, one calm column of content. */
body { --radius: 0px; --page: 1100px; }
body h1, body h2, body h3 { font-weight: 400; letter-spacing: -.02em; }
body .site-header__inner { min-height: 88px; }
body .site-header__logo { font-size: 16px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; }
body .site-header__nav { gap: 34px; font-size: 13px; }
body .site-header__nav a { opacity: .55; }
body .section { padding: 72px 0; }
body .section-heading { font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: .28em; color: var(--muted); margin-bottom: 32px; }
body .product-card { gap: 8px; }
body .product-card__media { border-radius: 0; }
body .product-card:hover .product-card__media img { transform: none; opacity: .9; }
body .product-card__title { font-weight: 400; font-size: 14px; }
body .price { font-weight: 400; font-size: 14px; color: var(--muted); }
body .button { min-height: 44px; padding: 0 30px; border-radius: 0; font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; background: transparent; color: var(--accent); }
body .button:hover { opacity: 1; background: var(--accent); color: var(--bg); }
body .rich-text { margin: 0 auto; text-align: center; max-width: 660px; }
body .rich-text .section-heading { font-size: clamp(28px, 4vw, 44px); font-weight: 400; letter-spacing: -.02em; text-transform: none; color: var(--text); margin-bottom: 20px; }
body .rich-text p { font-size: 20px; font-weight: 300; line-height: 1.7; color: var(--text); }
body .site-footer { border-top: 0; background: var(--soft); margin-top: 72px; padding: 56px 0; }
body .site-footer__top + .site-footer__legal { border-top: 0; }
/* A hero or slide without a picture keeps the text colour (the starter mutes it) */
body .hero.placeholder { color: var(--text); }
/* Minimal Customer Auth & Account */
body .customer-auth, body .customer-card, body .customer-account, body .account-card, body .order-item, body .address-item { border-radius: 0; border: 1px solid var(--line); background: transparent; box-shadow: none; }
body .customer-card__title, body .customer-account__title, body .account-card__title { font-weight: 400; letter-spacing: -.02em; }
body .form-input, body .field input, body .field select { border-radius: 0; border: 1px solid var(--line); background: transparent; }
body .button.customer-card__submit { border-radius: 0; min-height: 44px; font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; background: var(--text); color: var(--bg); }
body .button.customer-card__submit:hover { opacity: .85; }
body .badge { border-radius: 0; background: transparent; border: 1px solid var(--line); color: var(--text); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; }
</style>
