{%- comment -%}
  Boutique design: this theme's own styling, loaded by layout/theme.liquid after snippets/styles.liquid.
  Edit it here, in the code editor of the theme that uses it.
{%- endcomment -%}
<style>
/* Boutique: editorial. Centred logo, split hero, portrait cards, lots of air. */
body { --radius: 2px; --page: 1240px; line-height: 1.7; }
body h1, body h2, body h3 { font-weight: 500; letter-spacing: 0; }
body .site-header__inner { padding-top: 26px; padding-bottom: 16px; }
body .site-header__logo { font-size: 30px; font-weight: 500; letter-spacing: .04em; }
body .site-header__nav { gap: 30px; }
body .site-header__nav a { font-size: 12px; text-transform: uppercase; letter-spacing: .2em; opacity: .85; }
body .section { padding: 88px 0; }
body .section-heading { text-align: center; font-size: clamp(26px, 3vw, 38px); font-style: italic; margin-bottom: 44px; }
body .section-heading::after { content: ""; display: block; width: 48px; height: 1px; background: var(--accent); margin: 18px auto 0; }
body .carousel__header { flex-direction: column; align-items: center; text-align: center; }
body .product-list__sub { margin: 0 0 24px; }
body .product-card { gap: 14px; text-align: center; align-items: stretch; }
body .product-card__media { border-radius: 0; }
body .product-card__title { font-family: var(--font-heading, Georgia, serif); font-size: 18px; font-weight: 400; }
body .price { font-weight: 400; color: var(--muted); }
body .button { border-radius: 0; text-transform: uppercase; letter-spacing: .16em; font-size: 12px; font-weight: 600; }
body .rich-text { margin: 0 auto; text-align: center; }
body .rich-text p { font-size: 20px; }
/* Split hero: text on the left, picture on the right */
body .hero__label { text-transform: uppercase; letter-spacing: .24em; font-size: 12px; margin: 0 0 14px; }
body .site-footer { text-align: center; margin-top: 0; }
body .site-footer__top { justify-content: center; }
/* A hero or slide without a picture keeps the text colour (the starter mutes it) */
body .hero.placeholder { color: var(--text); }
@media (max-width: 800px) { body .section { padding: 56px 0; } }
/* Split hero (sections/hero.liquid): text on the left, picture on the right */
.split-hero { display: grid; grid-template-columns: 1fr 1fr; background: var(--soft); }
.split-hero__text { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 64px 56px; }
.split-hero__text h1 { font-size: clamp(34px, 4.6vw, 60px); margin: 0 0 16px; }
.split-hero__text p { font-size: 18px; color: var(--muted); max-width: 460px; margin: 0 0 28px; }
.split-hero__text p.split-hero__label { text-transform: uppercase; letter-spacing: .24em; font-size: 12px; margin: 0 0 14px; color: var(--text); }
.split-hero__buttons { display: flex; flex-wrap: wrap; gap: 12px; }
.split-hero__media { min-height: 480px; position: relative; overflow: hidden; }
.split-hero--small .split-hero__media { min-height: 320px; } .split-hero--large .split-hero__media { min-height: 640px; }
.split-hero__media img, .split-hero__media video, .split-hero__media .placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
@media (max-width: 800px) {
  .split-hero { grid-template-columns: 1fr; }
  .split-hero__media { order: -1; min-height: 280px; }
  .split-hero__text { padding: 40px 20px; }
}
</style>
