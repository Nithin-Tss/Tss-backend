{%- comment -%} Password page: the shop's message and the password form. {%- endcomment -%}
<section class="section page-width stack narrow">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password', class: 'stack' -%}
    {%- if form.errors -%}
      <p role="alert">{{ 'password.error' | t }}</p>
    {%- endif -%}
    <label for="Password">{{ 'password.label' | t }}</label>
    <input id="Password" type="password" name="password" autocomplete="current-password" required>
    <button class="button" type="submit">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "t:sections.main_password.name"
}
{% endschema %}
