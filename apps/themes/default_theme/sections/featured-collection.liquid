{%- comment -%} Products from one collection, with a link to see them all. {%- endcomment -%}
{%- assign featured = section.settings.collection -%}
<section class="section page-width">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if featured.products_count > 0 -%}
    <ul class="grid">
      {%- for product in featured.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    </ul>
    <a class="button button--secondary" href="{{ featured.url }}">{{ 'general.view_all' | t }}</a>
  {%- else -%}
    <p>{{ 'sections.featured_collection.empty' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.featured_collection.settings.heading" },
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.settings.collection" },
    {
      "type": "range", "id": "limit", "label": "t:sections.featured_collection.settings.limit",
      "min": 2, "max": 12, "step": 1, "default": 4
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
